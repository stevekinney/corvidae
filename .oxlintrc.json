{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "promise", "unicorn", "import"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "rules": {
    "complexity": [
      "error",
      {
        "max": 100,
        "variant": "classic"
      }
    ],
    "no-with": "error",
    "no-labels": "error",
    "no-console": "warn",
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "ignoreRestSiblings": true
      }
    ],
    "promise/no-return-wrap": "error",
    "promise/param-names": "error",
    "promise/catch-or-return": [
      "error",
      {
        "allowThen": true
      }
    ],
    "promise/no-nesting": "warn",
    "promise/no-promise-in-callback": "warn",
    "promise/no-callback-in-promise": "warn",
    "promise/no-new-statics": "error",
    "promise/no-return-in-finally": "warn",
    "promise/valid-params": "warn",
    "unicorn/no-null": "off",
    "unicorn/no-await-expression-member": "error",
    "import/first": "error",
    "import/no-duplicates": "error",
    "import/no-cycle": "error",
    "import/no-unassigned-import": [
      "error",
      {
        "allow": ["**/*.css"]
      }
    ],
    "typescript/no-unused-vars": "off",
    "typescript/no-floating-promises": "error",
    "typescript/await-thenable": "error",
    "typescript/no-unsafe-type-assertion": "off",
    "unicorn/consistent-function-scoping": "off",
    "typescript/no-unnecessary-type-parameters": "off",
    "no-underscore-dangle": [
      "warn",
      {
        "allow": ["_meta", "_didMount", "_willUpdate"]
      }
    ],
    "typescript/no-unnecessary-type-arguments": "off",
    "typescript/consistent-return": "off"
  },
  "ignorePatterns": [
    "**/build/**",
    "**/.svelte-kit/**",
    "**/coverage/**",
    "**/.turbo/**",
    "**/.bun/**",
    "**/node_modules/**",
    "**/*.generated.d.ts",
    "*.lock",
    "**/.playwright/**"
  ],
  "overrides": [
    {
      "files": ["**/components/*/src/**"],
      "excludeFiles": [
        "**/components/*/src/**/*.test.*",
        "**/components/*/src/**/*.spec.*",
        "**/components/*/src/**/*.test-d.ts",
        "**/components/*/src/**/*.type-test.ts",
        "**/components/*/src/**/*.playwright.ts",
        "**/components/*/src/**/*-test-*.ts",
        "**/components/*/src/**/*.test-support.ts",
        "**/components/*/src/**/test/**",
        "**/components/*/src/**/tests/**",
        "**/components/*/src/**/__tests__/**",
        "**/components/*/src/**/__fixtures__/**",
        "**/components/*/src/**/__test-helpers__/**"
      ],
      "env": {
        "browser": true,
        "svelte": true,
        "node": false,
        "commonjs": false
      },
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "globals": [
              "Bun",
              "process",
              "Buffer",
              "global",
              "require",
              "module",
              "exports",
              "__dirname",
              "__filename",
              "setImmediate",
              "clearImmediate"
            ],
            "checkGlobalObject": true
          }
        ],
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^(?:node:|bun(?::|$)|(?:assert|assert/strict|async_hooks|buffer|bun|child_process|cluster|console|constants|crypto|dgram|diagnostics_channel|dns|dns/promises|domain|events|fs|fs/promises|http|http2|https|inspector|inspector/promises|module|net|os|path|path/posix|path/win32|perf_hooks|process|punycode|querystring|readline|readline/promises|repl|stream|stream/consumers|stream/promises|stream/web|string_decoder|sys|timers|timers/promises|tls|trace_events|tty|undici|url|util|util/types|v8|vm|wasi|worker_threads|ws|zlib)(?:/|$))",
                "message": "Component source runs in browsers. Keep Bun and Node APIs in tests or scripts."
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["**/packages/**/src/**", "**/applications/**/src/**", "**/components/**/src/**"],
      "rules": {
        "no-console": [
          "warn",
          {
            "allow": ["warn", "error", "info"]
          }
        ]
      }
    },
    {
      "files": ["**/*test-utilities.ts"],
      "rules": {
        "no-console": [
          "warn",
          {
            "allow": ["log", "warn", "error", "info"]
          }
        ]
      }
    },
    {
      "files": ["**/packages/weft/**"],
      "rules": {
        "unicorn/require-post-message-target-origin": "off",
        "unicorn/prefer-add-event-listener": "off"
      }
    },
    {
      "files": ["**/packages/weft/src/core/context/**"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": ["**/components/*/src/**", "**/packages/markdown/src/**"],
      "rules": {
        "typescript/no-unsafe-type-assertion": "error"
      }
    },
    {
      "files": ["**/components/*/src/**", "**/packages/markdown/src/**"],
      "rules": {
        "unicorn/no-array-sort": "off",
        "unicorn/no-array-reverse": "off"
      }
    },
    {
      "files": ["**/components/*/src/**/*.css.d.ts"],
      "rules": {
        "unicorn/require-module-specifiers": "off"
      }
    },
    {
      "files": ["**/components/weft-ui/src/mount.ts"],
      "rules": {
        "no-restricted-globals": "off",
        "no-restricted-imports": "off"
      }
    },
    {
      "files": ["**/components/chat/src/index.ts"],
      "rules": {
        "import/no-unassigned-import": [
          "error",
          {
            "allow": ["**/*.css", "@corvidae/cinder"]
          }
        ]
      }
    },
    {
      "files": [
        "**/*.test.ts",
        "**/*.spec.ts",
        "**/test/**/*.ts",
        "**/__tests__/**/*.ts",
        "**/*.test-d.ts",
        "**/*.type-test.ts",
        "**/*.playwright.ts",
        "**/*.test-support.ts",
        "**/*test-fixtures.ts",
        "**/*test-helpers.ts",
        "**/tests/**/*.ts"
      ],
      "rules": {
        "typescript/no-explicit-any": "off",
        "typescript/no-unsafe-argument": "off",
        "typescript/no-unsafe-assignment": "off",
        "typescript/no-unsafe-call": "off",
        "typescript/no-unsafe-member-access": "off",
        "typescript/no-unsafe-return": "off",
        "typescript/no-floating-promises": "off",
        "typescript/no-non-null-assertion": "off",
        "typescript/unbound-method": "off",
        "typescript/require-await": "off",
        "typescript/no-magic-numbers": "off",
        "typescript/no-empty-function": "off",
        "typescript/no-unused-expressions": "off",
        "typescript/no-unused-vars": "off",
        "no-unused-vars": "off",
        "no-console": "off",
        "typescript/no-unsafe-type-assertion": "off",
        "typescript/await-thenable": "off",
        "require-yield": "off",
        "no-underscore-dangle": "off",
        "no-shadow": "off",
        "unicorn/consistent-function-scoping": "off",
        "promise/always-return": "off",
        "import/no-unassigned-import": [
          "error",
          {
            "allow": ["**/*.css", "fake-indexeddb/auto"]
          }
        ],
        "unicorn/no-thenable": "off",
        "no-unmodified-loop-condition": "off"
      }
    },
    {
      "files": ["scripts/**", "**/scripts/**"],
      "rules": {
        "complexity": [
          "error",
          {
            "max": 300,
            "variant": "classic"
          }
        ]
      }
    },
    {
      "files": ["scripts/**/*.ts", "**/scripts/**/*.ts"],
      "rules": {
        "no-console": "off"
      }
    },
    {
      "files": [
        "**/components/cinder/src/components/json-viewer/_json-viewer-node.svelte",
        "**/components/cinder/src/components/json-schema-editor/property-editor.svelte",
        "**/components/cinder/src/components/json-schema-editor/property-list.svelte"
      ],
      "rules": {
        "import/no-cycle": "off",
        "import/no-self-import": "off"
      }
    }
  ]
}
