{
  "repository": "stevekinney/corvidae",
  "defaultBranch": "main",
  "worktreeRoots": {
    "claude": "~/.agent-worktrees/claude/corvidae",
    "codex": "~/.agent-worktrees/codex/corvidae"
  },
  "manifestName": "corvidae",
  "installCommand": "bun install --frozen-lockfile",
  "gateCommand": "bun run check",
  "affectedCheckCommand": "bun run check",
  "fastCheckCommand": "bun scripts/run-exclusively.ts --shared 'bunx turbo run typecheck lint {filters}'",
  "batchCommand": "bun run validate",
  "lockPattern": "^[^ ]*bun [^ ]*run-exclusively\\.ts [^-]",
  "mergeMethod": "squash"
}
