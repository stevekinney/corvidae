{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvidae.lostgradient.internal/terminal/evidence.schema.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "reportKind",
    "sourceSha",
    "runId",
    "observedAt",
    "expectedCellIds",
    "cells",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportKind": { "enum": ["runtime", "engine"] },
    "sourceSha": { "type": "string", "minLength": 7 },
    "runId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "expectedCellIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "cells": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "passed", "observations", "versions", "metrics"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "observations": { "type": "array", "items": { "type": "string" } },
          "versions": {
            "type": "object",
            "additionalProperties": { "type": "string", "minLength": 1 },
            "minProperties": 1
          },
          "metrics": {
            "type": "object",
            "minProperties": 1,
            "additionalProperties": {
              "type": "object",
              "required": ["value", "unit"],
              "properties": {
                "value": { "type": "number" },
                "unit": { "type": "string", "minLength": 1 }
              },
              "additionalProperties": false
            }
          }
        },
        "additionalProperties": false
      },
      "minItems": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "passed", "cells"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "cells": { "type": "array", "minItems": 1 }
        },
        "additionalProperties": true
      }
    },
    "selectedEngine": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "passed": { "type": "boolean" }
  },
  "additionalProperties": false
}
