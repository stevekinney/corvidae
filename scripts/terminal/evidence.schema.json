{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://corvidae.lostgradient.internal/terminal/evidence.schema.json",
  "$defs": {
    "metric": {
      "type": "object",
      "required": ["value", "unit"],
      "properties": {
        "value": { "type": "number" },
        "unit": { "type": "string", "minLength": 1 }
      },
      "additionalProperties": false
    },
    "cell": {
      "type": "object",
      "required": ["id", "passed", "observations", "versions", "metrics"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "passed": { "type": "boolean" },
        "observations": { "type": "array", "items": { "type": "string" } },
        "versions": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 },
          "minProperties": 1
        },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/metric" }
        },
        "workload": {
          "$ref": "#/$defs/workload"
        }
      },
      "additionalProperties": false
    },
    "workload": {
      "type": "object",
      "required": ["fixtureId", "environment", "plan", "control", "observed"],
      "properties": {
        "fixtureId": { "type": "string", "minLength": 1 },
        "environment": {
          "type": "object",
          "required": ["hardware", "runtime"],
          "properties": {
            "hardware": { "type": "string", "minLength": 1 },
            "runtime": { "type": "string", "minLength": 1 },
            "browser": { "type": "string", "minLength": 1 },
            "engine": { "type": "string", "minLength": 1 }
          },
          "additionalProperties": false
        },
        "plan": {
          "type": "object",
          "required": ["durationMilliseconds", "sampleCount", "warmupCount", "method", "target"],
          "properties": {
            "durationMilliseconds": { "type": "number", "exclusiveMinimum": 0 },
            "sampleCount": { "type": "integer", "minimum": 1 },
            "warmupCount": { "type": "integer", "minimum": 0 },
            "method": { "type": "string", "minLength": 1 },
            "target": {
              "type": "object",
              "required": ["metric", "unit", "comparator", "value"],
              "properties": {
                "metric": { "type": "string", "minLength": 1 },
                "unit": { "type": "string", "minLength": 1 },
                "comparator": { "enum": ["gte", "lte", "eq"] },
                "value": { "type": "number" }
              },
              "additionalProperties": false
            }
          },
          "additionalProperties": false
        },
        "control": {
          "type": "object",
          "required": ["passed", "observed"],
          "properties": { "passed": { "const": true }, "observed": { "$ref": "#/$defs/observed" } },
          "additionalProperties": false
        },
        "observed": { "$ref": "#/$defs/observed" }
      },
      "additionalProperties": false
    },
    "observed": {
      "type": "object",
      "required": ["durationMilliseconds", "sampleCount", "warmupCount", "metrics", "raw"],
      "properties": {
        "durationMilliseconds": { "type": "number", "exclusiveMinimum": 0 },
        "sampleCount": { "type": "integer", "minimum": 1 },
        "warmupCount": { "type": "integer", "minimum": 0 },
        "metrics": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "$ref": "#/$defs/metric" }
        },
        "raw": { "type": "object" }
      },
      "additionalProperties": false
    }
  },
  "type": "object",
  "required": [
    "schemaVersion",
    "reportKind",
    "sourceSha",
    "runId",
    "observedAt",
    "expectedCellIds",
    "cells",
    "passed"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "reportKind": { "enum": ["runtime", "engine", "resource"] },
    "sourceSha": { "type": "string", "minLength": 7 },
    "runId": { "type": "string", "minLength": 1 },
    "observedAt": { "type": "string", "format": "date-time" },
    "expectedCellIds": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 },
      "minItems": 1,
      "uniqueItems": true
    },
    "cells": {
      "type": "array",
      "items": { "$ref": "#/$defs/cell" },
      "minItems": 1
    },
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "version", "passed", "cells"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "version": { "type": "string", "minLength": 1 },
          "passed": { "type": "boolean" },
          "status": { "enum": ["ready", "unavailable"] },
          "preferred": { "type": "boolean" },
          "diagnostics": { "type": "array", "items": { "type": "string" } },
          "provenance": { "type": "object" },
          "cells": {
            "type": "array",
            "items": { "$ref": "#/$defs/cell" },
            "minItems": 1
          }
        },
        "additionalProperties": false
      }
    },
    "selectedEngine": {
      "type": ["object", "null"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      },
      "required": ["name", "version"],
      "additionalProperties": false
    },
    "passed": { "type": "boolean" }
  },
  "additionalProperties": false,
  "allOf": [
    {
      "if": { "properties": { "reportKind": { "const": "resource" } } },
      "then": {
        "properties": {
          "cells": { "items": { "required": ["workload"] } }
        }
      }
    }
  ]
}
