    },
    "applications/interborough": {
      "entry": [
        "**/*.test.ts",
        "**/*.integration.test.ts",
        "**/*.slow.test.ts",
        "**/*.bench.ts",
        "**/*.fixture.svelte",
        "**/*.playwright.ts",
        "**/*.spec.ts",
