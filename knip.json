{
  "$schema": "./node_modules/knip/schema.json",
  "playwright": false,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.test.ts",
        "scripts/**/*.integration.test.ts",
        "scripts/**/*.slow.test.ts",
        "scripts/**/*.bench.ts",
        "scripts/**/*.playwright.ts",
        "scripts/affected-tests.ts",
