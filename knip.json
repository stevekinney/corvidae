{
  "$schema": "./node_modules/knip/schema.json",
  "playwright": false,
  "workspaces": {
    ".": {
      "entry": [
        "scripts/**/*.test.ts",
        "scripts/**/*.integration.test.ts",
        "scripts/**/*.slow.test.ts",
        "scripts/**/*.bench.ts",
        "scripts/**/*.playwright.ts"
      ],
      "project": ["scripts/**/*.ts"]
    },
    "applications/*": {
      "entry": [
        "**/*.test.ts",
        "**/*.integration.test.ts",
        "**/*.slow.test.ts",
        "**/*.bench.ts",
        "**/*.fixture.svelte",
        "**/*.playwright.ts",
        "**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,svelte}!",
        "scripts/**/*.ts",
        "!src/**/*.test.ts!",
        "!src/**/*.spec.ts!",
        "!src/**/*.fixture.svelte!",
        "!src/**/*.bench.ts!"
      ]
    },
    "components/*": {
      "entry": [
        "**/*.test.ts",
        "**/*.integration.test.ts",
        "**/*.slow.test.ts",
        "**/*.bench.ts",
        "**/*.fixture.svelte",
        "**/*.playwright.ts",
        "**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,svelte}!",
        "scripts/**/*.ts",
        "!src/**/*.test.ts!",
        "!src/**/*.spec.ts!",
        "!src/**/*.fixture.svelte!",
        "!src/**/*.bench.ts!"
      ]
    },
    "packages/*": {
      "entry": [
        "**/*.test.ts",
        "**/*.integration.test.ts",
        "**/*.slow.test.ts",
        "**/*.bench.ts",
        "**/*.fixture.svelte",
        "**/*.playwright.ts",
        "**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "scripts/**/*.ts",
        "!src/**/*.test.ts!",
        "!src/**/*.spec.ts!",
        "!src/**/*.fixture.svelte!",
        "!src/**/*.bench.ts!"
      ]
    },
    "internal/*": {
      "entry": [
        "**/*.test.ts",
        "**/*.integration.test.ts",
        "**/*.slow.test.ts",
        "**/*.bench.ts",
        "**/*.fixture.svelte",
        "**/*.playwright.ts",
        "**/*.spec.ts"
      ],
      "project": [
        "src/**/*.ts!",
        "scripts/**/*.ts",
        "!src/**/*.test.ts!",
        "!src/**/*.spec.ts!",
        "!src/**/*.fixture.svelte!",
        "!src/**/*.bench.ts!"
      ]
    },
    "plugins/*": {
      "entry": [
        "**/*.test.ts",
        "**/*.integration.test.ts",
        "**/*.slow.test.ts",
        "**/*.bench.ts",
        "**/*.fixture.svelte",
        "**/*.playwright.ts",
        "**/*.spec.ts"
      ],
      "project": [
        "src/**/*.{ts,svelte}!",
        "scripts/**/*.ts",
        "!src/**/*.test.ts!",
        "!src/**/*.spec.ts!",
        "!src/**/*.fixture.svelte!",
        "!src/**/*.bench.ts!"
      ]
    },
    "testing/*": {
      "entry": ["**/*.test.ts", "**/*.integration.test.ts", "**/*.slow.test.ts"],
      "project": ["src/**/*.ts!", "!src/**/*.test.ts!", "scripts/**/*.ts"]
    },
    "scripts/browser-fixtures": {
      "entry": ["tests/**/*.playwright.ts"],
      "project": ["src/**/*.{ts,svelte}", "scripts/**/*.ts", "tests/**/*.playwright.ts"]
    },
    "scripts/groom": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"]
    }
  }
}
