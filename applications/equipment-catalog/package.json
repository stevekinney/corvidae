{
  "name": "@lostgradient/equipment-catalog",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun src/server.ts --build",
    "start": "bun src/server.ts",
    "probe:deployment": "bun scripts/probe-deployment.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts",
    "test": "bun ../../scripts/bun-test-junit.ts ../../packages/equipment-fixture/src/index.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lostgradient/backchannel": "workspace:*",
    "@lostgradient/backchannel-armorer": "workspace:*",
    "@lostgradient/backchannel-mcp": "workspace:*",
    "@lostgradient/equipment-fixture": "workspace:*",
    "@lostgradient/velveteen": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "armorer": "workspace:*",
    "svelte": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@types/node": "catalog:velveteen",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
