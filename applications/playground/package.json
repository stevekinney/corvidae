{
  "name": "@lostgradient/playground",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "PLAYGROUND_BASE_URL=https://cinder.website bun scripts/static-export.ts",
    "check:source-temp": "bun scripts/check-source-temp.ts",
    "clean": "bun scripts/clean.ts",
    "dev": "bun --watch src/playground-server.ts",
    "examples:audit": "bun scripts/check-raw-native-controls.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts tests playwright.config.ts && bun scripts/check-raw-native-controls.ts --strict && bun scripts/check-source-temp.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts tests playwright.config.ts",
    "test": "bun scripts/run-tests.ts",
    "test:slow": "bun scripts/run-tests.ts --slow",
    "test:browser": "bun --bun playwright test --config playwright.config.ts",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "validate": "bun scripts/validate-playground.ts"
  },
  "dependencies": {
    "@lostgradient/chat": "workspace:*",
    "@lostgradient/cinder": "workspace:*",
    "@lostgradient/editor": "workspace:*",
    "@lostgradient/environmentalist": "catalog:",
    "@lostgradient/markdown": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@shikijs/themes": "catalog:",
    "lucide-svelte": "catalog:",
    "postcss": "catalog:",
    "shiki": "catalog:",
    "svelte": "catalog:",
    "ts-morph": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "@types/estree": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  }
}
