{
  "name": "@repo/weft-console",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun --bun vite build",
    "dev": "bun --bun vite dev",
    "dev:server": "bun run scripts/dev-server.ts",
    "test": "bun test",
    "test:build": "bun --bun vite build",
    "test:deployment": "bun test tests/deployment",
    "test:e2e": "bun run build && bun --bun playwright test --config playwright.config.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "lint:fix": "oxlint --fix --deny-warnings --type-aware --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@repo/weft": "workspace:*",
    "@repo/weft-ui": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@playwright/test": "catalog:",
    "@repo/typescript-configuration": "workspace:*",
    "@types/bun": "catalog:",
    "fake-indexeddb": "catalog:",
    "happy-dom": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "oxlint": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "shiki": "catalog:"
  }
}
