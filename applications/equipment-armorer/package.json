{
  "name": "@lostgradient/equipment-armorer",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --target bun --outdir dist",
    "start": "bun dist/server.js",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src",
    "test": "bun ../../scripts/bun-test-junit.ts ../../packages/equipment-fixture/src/index.test.ts",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lostgradient/equipment-fixture": "workspace:*",
    "armorer": "workspace:*"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
