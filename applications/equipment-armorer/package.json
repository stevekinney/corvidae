{
  "name": "@lostgradient/equipment-armorer-staging",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "bun build src/server.ts --target bun --outdir dist",
    "start": "bun dist/server.js",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "dependencies": {
    "@lostgradient/equipment-catalog-staging": "workspace:*",
    "armorer": "workspace:*"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
