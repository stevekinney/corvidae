{
  "name": "@lostgradient/chat-room",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun run sync && bun --bun vite dev",
    "build": "bun run sync && bun --bun vite build",
    "preview": "bun --bun vite preview",
    "sync": "CHAT_ROOM_BROWSER=1 bun --bun svelte-kit sync && CHAT_ROOM_BROWSER=0 bun --bun svelte-kit sync",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "bun run sync && oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold warning --fail-on-warnings",
    "test": "bun test",
    "test:browser": "bun --bun playwright test",
    "check:client-styles": "bun scripts/check-client-styles.ts"
  },
  "dependencies": {
    "@lostgradient/chat": "workspace:*",
    "@lostgradient/cinder": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/weft": "workspace:*",
    "armorer": "workspace:*",
    "conversationalist": "workspace:*",
    "zod": "catalog:",
    "svelte": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@lostgradient/environmentalist": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "@lostgradient/testing": "workspace:*",
    "@playwright/test": "catalog:",
    "shiki": "catalog:"
  }
}
