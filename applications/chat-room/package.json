{
  "name": "@corvidae/chat-room",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun --bun vite dev",
    "build": "bun --bun vite build",
    "preview": "bun --bun vite preview",
    "sync": "bun --bun svelte-kit sync",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "bun run sync && oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --threshold warning --fail-on-warnings",
    "test": "bun test",
    "test:browser": "bun --bun playwright test",
    "check:client-styles": "bun scripts/check-client-styles.ts"
  },
  "dependencies": {
    "@corvidae/chat": "workspace:*",
    "@corvidae/cinder": "workspace:*",
    "@corvidae/operative": "workspace:*",
    "@corvidae/weft": "workspace:*",
    "@corvidae/armorer": "workspace:*",
    "@corvidae/conversationalist": "workspace:*",
    "zod": "catalog:",
    "svelte": "catalog:",
    "@sveltejs/kit": "catalog:",
    "@lostgradient/environmentalist": "catalog:"
  },
  "devDependencies": {
    "@sveltejs/adapter-auto": "catalog:",
    "@sveltejs/vite-plugin-svelte": "catalog:",
    "@types/node": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "@corvidae/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "@corvidae/testing": "workspace:*",
    "@playwright/test": "catalog:",
    "shiki": "catalog:"
  }
}
