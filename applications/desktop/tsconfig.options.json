{
  // Shared by every program in this application.
  "compilerOptions": {
    // Electrobun 2.x is not distributed through npm: `electrobun prepare`
    // projects the SDK into `.hutch/devkit`, and the devkit generates its own
    // tsconfig mapping every `electrobun/*` specifier with `baseUrl` + `paths`.
    //
    // Extending that generated config is the documented route, but `baseUrl`
    // is removed in TypeScript 7 and already rejected outright by oxlint's
    // type-aware checker, so inheriting it makes this workspace's linter
    // unable to read the project at all. Declaring the three public entry
    // points here instead is `baseUrl`-free — `paths` resolve relative to this
    // file — and covers what the application imports. Anything beyond these
    // three needs a line added, which is the intended friction: each one is a
    // new coupling to a projected directory that is not in version control.
    "paths": {
      "electrobun": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/main": ["./.hutch/devkit/api/sdks/main/index.ts"],
      "electrobun/view": ["./.hutch/devkit/api/browser/index.ts"]
    },
    // The devkit is projected as TypeScript SOURCE, so it is compiled as part
    // of every program that imports it — `skipLibCheck` does not apply — and
    // it contains handlers that return a value on some paths only. Both the
    // main and browser SDKs trip this.
    "noImplicitReturns": false
  }
}
