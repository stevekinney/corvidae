{
  "extends": ["@lostgradient/typescript/library.json", "./tsconfig.options.json"],
  "compilerOptions": {
    // `electrobun.config.ts` types itself against the devkit's own
    // `ElectrobunConfig`, so this program compiles devkit source too. Same
    // reasoning as `tsconfig.main.json`.
    "exactOptionalPropertyTypes": false,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/typescript/tsconfig.tools.json.tsbuildinfo"
  },
  "include": ["*.config.ts", "scripts/**/*.ts", "tests/**/*.ts", "src/ambient.d.ts"]
}
