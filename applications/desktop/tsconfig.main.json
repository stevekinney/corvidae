{
  "extends": ["@lostgradient/typescript/library.json", "./tsconfig.options.json"],
  "compilerOptions": {
    // The Electrobun devkit is projected as TypeScript SOURCE into
    // `.hutch/devkit`, so it is compiled as part of this program —
    // `skipLibCheck` does not apply to it. That source is written against
    // `strict` but not `exactOptionalPropertyTypes`, and Electrobun's own
    // template ships with the flag off for the same reason.
    //
    // The renderer program keeps the workspace default of `true`, which is
    // why `@lostgradient/chat`'s decoder — which depends on it — is imported only
    // there. This program takes `@lostgradient/chat/wire`, the encoder-only entry.
    "exactOptionalPropertyTypes": false,
    "incremental": true,
    "tsBuildInfoFile": "node_modules/.cache/typescript/tsconfig.main.json.tsbuildinfo"
  },
  "include": ["src/bun/**/*.ts", "src/shared/**/*.ts", "src/ambient.d.ts"]
}
