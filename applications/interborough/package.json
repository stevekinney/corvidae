{
  "name": "@lostgradient/interborough",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "bun src/host/supervisor.ts dev",
    "start": "bun src/host/supervisor.ts serve",
    "build": "NODE_ENV=production bun scripts/build.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src fixtures scripts tests playwright.config.ts && bun scripts/check-interface-rules.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src fixtures scripts tests playwright.config.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --parallel=4 --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' src/host fixtures && bun scripts/run-ui-shards.ts --config=./bunfig.ui.toml --conditions browser --conditions svelte --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' --path-ignore-patterns='src/host/**' --path-ignore-patterns='tests/e2e/**' --path-ignore-patterns='tests/panels/**' src scripts tests",
    "test:slow": "bun ../../scripts/bun-test-selected.ts --path-ignore-patterns='src/lib/**' --path-ignore-patterns='src/routes/**' --path-ignore-patterns='src/app/**' --path-ignore-patterns='tests/**' .slow.test.ts .integration.test.ts && bun ../../scripts/bun-test-selected.ts --config=./bunfig.ui.toml --conditions browser --conditions svelte --path-ignore-patterns='src/host/**' --path-ignore-patterns='scripts/**' --path-ignore-patterns='fixtures/**' --path-ignore-patterns='tests/e2e/**' --path-ignore-patterns='tests/panels/**' .slow.test.ts .integration.test.ts",
    "test:browser": "bun ../../scripts/host-slots.ts --slots=1 -- bun --bun playwright test --config playwright.config.ts",
    "test:coverage": "bun scripts/check-coverage-cli.ts",
    "smoke:claude-code-mcp": "bun scripts/smoke-claude-code-mcp.ts",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.browser.json --fail-on-warnings && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts --entries 'src/host/**/*.ts' 'src/lib/**/*.ts' '!**/*.test.ts' '!**/*.test-support.ts'"
  },
  "dependencies": {
    "@ag-ui/client": "catalog:",
    "@ag-ui/core": "catalog:",
    "@lostgradient/bungalow": "workspace:*",
    "@lostgradient/bureau": "workspace:*",
    "@lostgradient/chat": "workspace:*",
    "@lostgradient/cinder": "workspace:*",
    "@lostgradient/cryptography": "workspace:*",
    "@lostgradient/environmentalist": "catalog:",
    "@lostgradient/interborough-plugin": "workspace:*",
    "@lostgradient/markdown": "workspace:*",
    "@lostgradient/memory": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/operative-anthropic": "workspace:*",
    "@lostgradient/operative-gemini": "workspace:*",
    "@lostgradient/operative-openai": "workspace:*",
    "@lostgradient/plugin-anthropic": "workspace:*",
    "@lostgradient/plugin-demo": "workspace:*",
    "@lostgradient/plugin-gemini": "workspace:*",
    "@lostgradient/plugin-guardrails": "workspace:*",
    "@lostgradient/plugin-inspectors": "workspace:*",
    "@lostgradient/plugin-ollama": "workspace:*",
    "@lostgradient/plugin-openai": "workspace:*",
    "@lostgradient/plugin-typesafe": "workspace:*",
    "@lostgradient/plugin-voyage": "workspace:*",
    "@lostgradient/plugin-workspace": "workspace:*",
    "@lostgradient/storage": "workspace:*",
    "@lostgradient/storage-bun-sqlite": "workspace:*",
    "@lostgradient/storage-indexeddb": "workspace:*",
    "@lostgradient/storage-postgres": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/weft": "workspace:*",
    "@lucide/svelte": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@shikijs/langs": "catalog:",
    "@shikijs/themes": "catalog:",
    "@tanstack/svelte-query": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "armorer": "workspace:*",
    "conversationalist": "workspace:*",
    "cron-parser": "catalog:",
    "js-yaml": "catalog:",
    "svelte": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@axe-core/playwright": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "@types/js-yaml": "catalog:",
    "fake-indexeddb": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  }
}
