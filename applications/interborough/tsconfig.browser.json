{
  "extends": "@lostgradient/typescript/browser.json",
  "include": ["src"],
  "exclude": [
    "${configDir}/node_modules",
    "${configDir}/coverage",
    "${configDir}/src/**/*.test.*",
    "${configDir}/src/**/*.spec.*",
    "${configDir}/src/**/*.test-d.ts",
    "${configDir}/src/**/*.type-test.ts",
    "${configDir}/src/**/*.playwright.ts",
    "${configDir}/src/**/*-test-*.ts",
    "${configDir}/src/**/*.test-support.ts",
    "${configDir}/src/**/test/**",
    "${configDir}/src/**/tests/**",
    "${configDir}/src/**/__tests__/**",
    "${configDir}/src/**/__fixtures__/**",
    "${configDir}/src/**/__test-helpers__/**",
    "${configDir}/src/host/**"
  ]
}
