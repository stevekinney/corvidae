{
  "name": "@repo/weft-cli",
  "private": true,
  "type": "module",
  "bin": {
    "weft": "src/cli-main.ts",
    "weft-mcp": "src/mcp.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit && bun run typecheck:fixtures",
    "test": "bun test",
    "typecheck:fixtures": "tsc --noEmit -p src/cli/__fixtures__/codegen/typecheck/tsconfig.json",
    "lint:fix": "oxlint --fix --deny-warnings --type-aware --tsconfig ./tsconfig.json"
  },
  "dependencies": {
    "@repo/weft": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-configuration": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
