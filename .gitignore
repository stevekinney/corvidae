# Workspace source is governed here, not by personal filename exclusions.
!applications/*/src/
!applications/*/src/**
!components/*/src/
!components/*/src/**
!packages/*/src/
!packages/*/src/**

# Dependencies and tool caches
node_modules/
.bun/
.turbo/
.cache/
*.tsbuildinfo
# Declarations a library emits for its consumers' type-checks (`types` task).
.types/
.dccache

# Application and test output
build/
dist/
# Weft's prebuilt dashboard, which `dashboard()` serves by default.
packages/weft/dashboard/
# Its build's staging directory, renamed into place on success and removed on failure; an
# interrupted build can leave one behind.
packages/weft/.dashboard-build-*/
artifacts/
# The playground's build scratch directories; they are deleted when a build ends,
# but an interrupted build can leave them behind.
applications/playground/.tmp/
applications/playground/src/.tmp-*/
# The playground export's report (routes, source SHA, build digest), written beside `build/`.
build-report/
# The playground's static production gate report and its failure screenshots.
production-gate-results/
# Generated by the removed Electrobun desktop application. Existing checkouts
# keep these untracked caches after updating, so they stay ignored.
.hutch/
.cottontail-tmp/
.main-bundle/
.svelte-kit/
coverage/
playwright-report/
test-results/
/testing/testing/screenshots/
.playwright/
test-output/
*.lcov
*.log

# Private local state
.env
.env.*
!.env.example
*.pem
local.env
tmp/
.DS_Store
.idea/
/.claude/worktrees

# The Dev Container links the host Git common directory here on every open.
.devcontainer/.git-common-dir
