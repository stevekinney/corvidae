# Workspace source is governed here, not by personal filename exclusions.
!applications/*/src/
!applications/*/src/**
!components/*/src/
!components/*/src/**
!packages/*/src/
!packages/*/src/**

# Dependencies and tool caches
node_modules/
.bun/
.turbo/
.cache/
*.tsbuildinfo
.dccache

# Application and test output
build/
dist/
artifacts/
# The playground's build scratch directories; they are deleted when a build ends,
# but an interrupted build can leave them behind.
applications/playground/.tmp/
applications/playground/src/.tmp-*/
# The playground export's report (routes, source SHA, build digest), written beside `build/`.
build-report/
# Electrobun projects its devkit here via `electrobun prepare`; it is a cached
# download, not source.
.hutch/
.cottontail-tmp/
# The main process pre-bundled by `applications/desktop`'s `build:main`.
.main-bundle/
.svelte-kit/
coverage/
playwright-report/
test-results/
/packages/testing/screenshots/
.playwright/
test-output/
*.lcov
*.log

# Private local state
.env
.env.*
!.env.example
*.pem
local.env
tmp/
.DS_Store
.idea/
/.claude/worktrees
