# Workspace source is governed here, not by personal filename exclusions.
!applications/*/src/
!applications/*/src/**
!components/*/src/
!components/*/src/**
!packages/*/src/
!packages/*/src/**

# Dependencies and tool caches
node_modules/
.bun/
.turbo/
.cache/
*.tsbuildinfo
.dccache

# Application and test output
build/
dist/
artifacts/
# Electrobun projects its devkit here via `electrobun prepare`; it is a cached
# download, not source.
.hutch/
.cottontail-tmp/
.svelte-kit/
coverage/
playwright-report/
test-results/
/packages/testing/screenshots/
.playwright/
test-output/
*.lcov
*.log

# Private local state
.env
.env.*
!.env.example
*.pem
local.env
tmp/
.DS_Store
.idea/
