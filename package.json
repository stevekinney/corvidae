{
  "name": "corvidae",
  "private": true,
  "description": "",
  "license": "MIT",
  "author": "Steve Kinney <hello@stevekinney.net>",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "catalog": {
    "@types/bun": "^1.4.2",
    "oxlint": "^1.83.0"
  },
  "scripts": {
    "build": "turbo run build",
    "audit": "bun audit --audit-level=high",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "prepare": "lefthook install",
    "test": "turbo run test",
    "test:create": "bun scripts/test-create.ts",
    "test:self": "bun scripts/ignored-outputs.ts --self-test && bun scripts/hooks/staged-quality-check.ts --self-test",
    "typecheck": "turbo run typecheck",
    "validate": "turbo run lint typecheck test build && bun run format:check && bun run test:self && bun run test:create"
  },
  "devDependencies": {
    "@repo/typescript-configuration": "workspace:*",
    "chalk": "^6.0.0",
    "change-case": "^5.4.4",
    "lefthook": "^2.1.14",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "^7.0.2001",
    "prettier": "^3.9.6",
    "prettier-plugin-organize-imports": "^4.3.0",
    "sort-package-json": "^4.0.0",
    "turbo": "^2.10.13",
    "typescript": "^7.0.2"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "picomatch": "4.0.4"
  }
}
