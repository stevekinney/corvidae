  "scripts": {
    "build": "turbo run build",
    "audit": "bun audit --audit-level=high",
    "clean": "turbo run clean",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun run lint:root && turbo run lint && bun run lint:styles",
    "lint:fix": "turbo run lint:fix",
    "test": "bun run test:self && turbo run test --concurrency=1",
    "test:self": "bun test ./scripts/*.test.ts",
    "typecheck": "tsc --noEmit && turbo run typecheck",
    "validate": "bun run lint && bun run typecheck && bun run test && bun run build && bun run format:check && bun run test:self",
    "lint:styles": "stylelint \"packages/**/src/**/*.{css,svelte}\" \"applications/**/src/**/*.{css,svelte}\"",
    "lint:root": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json scripts"
  },
  "devDependencies": {
    "@repo/typescript-configuration": "workspace:*",
    "oxlint": "catalog:",
