  "scripts": {
    "build": "bun scripts/run-exclusively.ts 'turbo run build'",
    "audit": "bun scripts/check-audit-exceptions.ts",
    "clean": "turbo run clean",
    "coverage": "bun scripts/run-exclusively.ts 'turbo run test:coverage'",
    "dev": "turbo run dev",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "bun scripts/run-exclusively.ts 'bun run lint:root && turbo run lint && bun run lint:styles'",
    "lint:fix": "turbo run lint:fix",
    "preflight": "bun install --frozen-lockfile",
    "test": "bun scripts/run-exclusively.ts 'turbo run test:self test test:browser-fixtures --concurrency=1'",
    "test:slow": "bun scripts/run-exclusively.ts 'turbo run test:slow --concurrency=1'",
    "measure:test-durations": "bun scripts/run-exclusively.ts 'turbo run test:self test test:browser-fixtures --concurrency=1 --force'",
    "check:test-durations": "bun run measure:test-durations && bun scripts/check-test-durations.ts",
    "report:test-durations": "bun scripts/check-test-durations.ts --report",
    "test:self": "bun scripts/bun-test-junit.ts --report-name=self ./scripts/*.test.ts ./scripts/mirror/*.test.ts ./scripts/terminal/*.test.ts",
    "test:terminal-browser": "bun scripts/terminal/browser-failure-regression.ts",
    "typecheck": "bun scripts/run-exclusively.ts 'bun scripts/browser-fixtures/scripts/prepare-manifest.ts && tsc --noEmit && svelte-check --workspace scripts/browser-fixtures --tsconfig ./tsconfig.json --fail-on-warnings && turbo run typecheck'",
    "validate": "bun scripts/run-exclusively.ts 'bun run lint && bun run typecheck && bun run test && bun run test:slow && bun run report:test-durations && bun run coverage && bun run build && bun run format:check && bun run audit'",
    "lint:styles": "stylelint \"components/**/src/**/*.{css,svelte}\" \"packages/**/src/**/*.{css,svelte}\" \"applications/**/src/**/*.{css,svelte}\" \"scripts/browser-fixtures/src/**/*.{css,svelte}\"",
    "lint:root": "bun scripts/browser-fixtures/scripts/prepare-manifest.ts && oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json scripts && bun scripts/check-wait-for-element-assertions.ts && bun scripts/check-wall-clock-assertions.ts && bun scripts/check-promise-assertion-modifiers.ts && bun scripts/check-test-process-spawns.ts",
    "test:browser-fixtures": "bun scripts/browser-fixtures/scripts/prepare-manifest.ts && bun scripts/bun-test-junit.ts --report-name=browser-fixtures scripts/browser-fixtures/scripts && bun scripts/browser-fixtures/scripts/verify-curated-build.ts",
    "test:browser": "bun --bun playwright test --config scripts/browser-fixtures/playwright.config.ts",
    "test:browser:preview": "FIXTURE_HOST_MODE=preview bun --bun playwright test --config scripts/browser-fixtures/playwright.config.ts",
    "dev:browser-fixtures": "bun --watch scripts/browser-fixtures/scripts/serve.ts",
    "test:browser:visual": "CINDER_VISUAL_DIFF=block bun run test:browser",
    "test:browser:update": "bun scripts/browser-fixtures/scripts/update-snapshots.ts",
    "test:browser:update:docker": "bun scripts/browser-fixtures/scripts/update-snapshots-docker.ts",
    "test:browser:visual:docker": "bun scripts/browser-fixtures/scripts/run-browser-docker.ts"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "catalog:",
    "@lostgradient/environmentalist": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@shikijs/langs": "catalog:",
    "@shikijs/themes": "catalog:",
    "@types/bun": "catalog:",
    "@types/pngjs": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "pixelmatch": "catalog:",
    "pngjs": "catalog:",
    "postcss-html": "catalog:",
    "prettier": "catalog:",
    "prettier-plugin-organize-imports": "catalog:",
    "prettier-plugin-svelte": "catalog:",
    "prettier-plugin-toml": "catalog:",
    "publint": "catalog:",
    "shiki": "catalog:",
    "stylelint": "catalog:",
    "stylelint-use-logical": "catalog:",
    "svelte": "catalog:",
    "svelte-check": "catalog:",
    "tar": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "packageManager": "bun@1.4.2",
  "engines": {
    "bun": ">=1.4.2"
  },
  "overrides": {
    "picomatch": "4.0.4",
    "cookie": "0.7.2"
  }
