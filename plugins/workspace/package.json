{
  "name": "@lostgradient/plugin-workspace",
  "private": true,
  "description": "Read-only workspace roots for Interborough agents.",
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts",
    "test": "bun ../../scripts/bun-test-junit.ts"
  },
  "dependencies": {
    "@lostgradient/interborough-plugin": "workspace:*",
    "armorer": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/bureau": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
