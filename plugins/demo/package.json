{
  "name": "@lostgradient/plugin-demo",
  "private": true,
  "description": "The demo plugin for Interborough: scripted agents, tools, validators, a goal, and a schedule that run without a model provider. Off by default.",
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts",
    "./refunds": {
      "browser": null,
      "default": "./src/refunds.ts"
    }
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts && bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts'",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .slow.test.ts .integration.test.ts"
  },
  "dependencies": {
    "@lostgradient/backchannel": "workspace:*",
    "@lostgradient/bureau": "workspace:*",
    "@lostgradient/interborough-plugin": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/operative-anthropic": "workspace:*",
    "@lostgradient/storage": "workspace:*",
    "@lostgradient/weft": "workspace:*",
    "armorer": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/lifecycle": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@lostgradient/storage-bun-sqlite": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
