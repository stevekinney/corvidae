{
  "name": "@lostgradient/plugin-typesafe",
  "private": true,
  "description": "The typesafe plugin for Interborough: the TypeSafe Jev decision model, offered as typesafe:jev.",
  "type": "module",
  "exports": {
    ".": "./src/plugin.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-inherited-key-reads.ts && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts"
  },
  "dependencies": {
    "@lostgradient/interborough-plugin": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/operative-typesafe": "workspace:*",
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-typesafe": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/bureau": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
