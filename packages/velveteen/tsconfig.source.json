{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".types",
    "tsBuildInfoFile": ".types/tsconfig.source.tsbuildinfo"
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "**/*.test.ts", "**/*.test-d.ts"]
}
