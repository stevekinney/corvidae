{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "allowImportingTsExtensions": true,
    "noEmit": true,
    "types": ["bun"],
    "skipLibCheck": false,
    "allowJs": false
  },
  "include": ["./positive.svelte.ts", "./positive.svelte"]
}
