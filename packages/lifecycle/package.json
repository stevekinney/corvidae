{
  "name": "@lostgradient/lifecycle",
  "private": true,
  "description": "Typed EventTarget, async iterators, observables, hooks, and lifecycle utilities for agent-bureau.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
