{
  "name": "@repo/armorer",
  "description": "A lightweight registry for validated AI tools. Build tools with Zod schemas and metadata, register them in a toolbox, and execute/query them with event hooks.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "devDependencies": {
    "@anthropic-ai/claude-agent-sdk": "catalog:",
    "@types/bun": "catalog:",
    "@repo/typescript-configuration": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "dependencies": {
    "@repo/interoperability": "workspace:*",
    "@repo/lifecycle": "workspace:*",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@modelcontextprotocol/sdk": "catalog:",
    "@openai/agents": "catalog:"
  }
}
