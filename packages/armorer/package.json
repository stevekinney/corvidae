{
  "name": "armorer",
  "description": "A lightweight registry for validated AI tools. Build tools with Zod schemas and metadata, register them in a toolbox, and execute/query them with event hooks.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun ../../scripts/bun-test-junit.ts"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "dependencies": {
    "@lostgradient/cryptography": "workspace:*",
    "@lostgradient/embeddings": "workspace:*",
    "@lostgradient/lifecycle": "workspace:*",
    "@lostgradient/tool-protocol": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@openai/agents": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@standard-schema/spec": "catalog:",
    "zod": "catalog:"
  }
}
