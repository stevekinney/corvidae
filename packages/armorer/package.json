{
  "name": "armorer",
  "description": "A lightweight registry for validated AI tools. Build tools with Zod schemas and metadata, register them in a toolbox, and execute/query them with event hooks.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./protocol": "./src/protocol/index.ts",
    "./open-ai/agents": "./src/adapters/open-ai/agents/index.ts",
    "./coding": "./src/coding/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@google/genai": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "openai": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "private": true,
  "dependencies": {
    "@lostgradient/cryptography": "workspace:*",
    "@lostgradient/lifecycle": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@openai/agents": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@standard-schema/spec": "catalog:",
    "zod": "catalog:"
  }
}
