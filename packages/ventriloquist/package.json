{
  "name": "@lostgradient/ventriloquist",
  "private": true,
  "description": "Platform-neutral terminal wire protocol and session core, with Bun pipe, PTY, and WebSocket host helpers.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./bun": "./src/bun/index.ts",
    "./websocket": "./src/websocket/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-inherited-key-reads.ts && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit -p tsconfig.neutral.json && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts",
    "test:protocol": "bun ../../scripts/bun-test.ts src/protocol",
    "test:session": "bun ../../scripts/bun-test.ts src/session",
    "test:bun": "bun ../../scripts/bun-test.ts src/bun",
    "test:websocket": "bun ../../scripts/bun-test.ts src/websocket",
    "test:conformance": "bun ../../scripts/bun-test.ts src/conformance",
    "test:benchmarks": "bun ../../scripts/bun-test.ts ./scripts/benchmarks/transport.bench.ts",
    "test:coverage": "bun ../../scripts/bun-test.ts --coverage --coverage-reporter=lcov && bun scripts/check-coverage.ts"
  },
  "devDependencies": {
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
