{
  "name": "@lostgradient/credentials",
  "private": true,
  "description": "Server-side credential services for Fetch applications.",
  "type": "module",
  "exports": {
    "./api-keys": "./src/api-keys.ts",
    "./api-key-verification": "./src/api-key-verification.ts",
    "./browser-sign-in": "./src/browser-sign-in.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit --project tsconfig.test.json",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts' && bun run --cwd ../backchannel test:durable-api-key",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .integration.test.ts",
    "test:browser-sign-in": "bun ../../scripts/bun-test.ts src/browser-sign-in.test.ts",
    "test:api-keys:storage": "bun ../../scripts/bun-test.ts src/api-keys.integration.test.ts"
  },
  "dependencies": {
    "@lostgradient/storage": "workspace:*",
    "openid-client": "6.9.1"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@lostgradient/storage-bun-sqlite": "workspace:*",
    "@lostgradient/mcp": "workspace:*",
    "@lostgradient/storage-postgres": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/velveteen": "workspace:*",
    "armorer": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
