  "dependencies": {
    "armorer": "workspace:*",
    "@lostgradient/chat": "workspace:*",
    "@lostgradient/operative": "workspace:*"
  },
  "devDependencies": {
    "conversationalist": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  }
}
