{
  "name": "@lostgradient/telephone",
  "private": true,
  "type": "module",
  "description": "Carries an Operative agent run onto the chat stream wire.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src",
