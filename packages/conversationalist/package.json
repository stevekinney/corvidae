{
  "name": "conversationalist",
  "description": "A TypeScript library for managing AI conversation state",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "bun ../../scripts/bun-test-junit.ts"
  },
  "dependencies": {
    "@ag-ui/core": "catalog:",
    "@lostgradient/lifecycle": "workspace:*",
    "armorer": "workspace:*",
    "js-yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "catalog:",
    "@google/genai": "catalog:",
    "@types/bun": "catalog:",
    "openai": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "@types/js-yaml": "catalog:"
  },
  "private": true
}
