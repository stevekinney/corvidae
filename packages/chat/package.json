{
  "name": "@repo/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun test --conditions browser --conditions svelte --parallel=1 src",
    "lint:fix": "oxlint --fix --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts"
  },
  "dependencies": {
    "@repo/conversationalist": "workspace:*",
    "decode-named-character-reference": "catalog:",
    "micromark-util-decode-numeric-character-reference": "catalog:",
    "zod": "catalog:",
    "@repo/cinder": "workspace:*",
    "@repo/markdown": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@repo/testing": "workspace:*",
    "@repo/typescript-configuration": "workspace:*",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": [
    "./src/index.ts",
    "**/*.css",
    "src/lib/components/*/index.ts"
  ]
}
