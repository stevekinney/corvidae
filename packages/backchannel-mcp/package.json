{
  "name": "@lostgradient/backchannel-mcp",
  "private": true,
  "description": "The stateless HTTP MCP mount for Backchannel operation catalogs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./velveteen": "./src/velveteen.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error src && oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.integration.json --report-unused-disable-directives-severity=error catalog-mount.test.ts && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json && tsc --noEmit --project tsconfig.integration.json",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts && bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts'",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .integration.test.ts"
  },
  "dependencies": {
    "@lostgradient/backchannel": "workspace:*",
    "@lostgradient/mcp": "workspace:*",
    "@modelcontextprotocol/server": "catalog:"
  },
  "devDependencies": {
    "armorer": "workspace:*",
    "@lostgradient/storage": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@lostgradient/velveteen": "workspace:*",
    "@lostgradient/workerd-testing": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "sideEffects": false
}
