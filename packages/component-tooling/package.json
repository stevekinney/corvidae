{
  "name": "@lostgradient/component-tooling",
  "private": true,
  "type": "module",
  "exports": {
    "./manifest.meta": "./src/manifest.meta.ts",
    "./schema-types": "./src/schema-types.ts",
    "./scripts/check-component-css.ts": "./scripts/check-component-css.ts",
    "./scripts/check-virtual-list-dependency-free-graph.ts": "./scripts/check-virtual-list-dependency-free-graph.ts",
    "./scripts/check-virtual-list-dependency-free-policy.ts": "./scripts/check-virtual-list-dependency-free-policy.ts",
    "./scripts/check-virtual-list-dependency-free-test-utilities.ts": "./scripts/check-virtual-list-dependency-free-test-utilities.ts",
    "./scripts/component-conventions-tests.ts": "./scripts/component-conventions-tests.ts",
    "./scripts/css-fingerprint.ts": "./scripts/css-fingerprint.ts",
    "./scripts/discover-component-directories.ts": "./scripts/discover-component-directories.ts",
    "./scripts/environment-configuration.ts": "./scripts/environment-configuration.ts",
    "./scripts/generate-component-metadata.ts": "./scripts/generate-component-metadata.ts",
    "./scripts/generate-manifest.ts": "./scripts/generate-manifest.ts",
    "./scripts/lib/component-meta.ts": "./scripts/lib/component-meta.ts",
    "./scripts/lib/discover-components.ts": "./scripts/lib/discover-components.ts",
    "./scripts/lib/metadata-files.ts": "./scripts/lib/metadata-files.ts",
    "./scripts/lib/node-prettier.ts": "./scripts/lib/node-prettier.ts",
    "./scripts/lib/prettier-resolution.ts": "./scripts/lib/prettier-resolution.ts",
    "./scripts/preload.ts": "./scripts/preload.ts",
    "./scripts/validation-utilities.ts": "./scripts/validation-utilities.ts",
    "./test/css.ts": "./src/test/css.ts",
    "./test/focus-ring-helpers.ts": "./src/test/focus-ring-helpers.ts",
    "./test/hydration-safety.ts": "./src/test/hydration-safety.ts",
    "./test/overflow-fade-test-helpers.ts": "./src/test/overflow-fade-test-helpers.ts",
    "./test/token-introspection.ts": "./src/test/token-introspection.ts",
    "./test/viewport.ts": "./src/test/viewport.ts",
    "./test/zero-delay-timers.ts": "./src/test/zero-delay-timers.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json scripts src && bun ../../scripts/check-inherited-key-reads.ts && bun scripts/check-browser-fixture-token-literals.ts",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --conditions browser --conditions svelte --parallel=4 --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' scripts src && bun scripts/check-component-css-token-usage.ts --strict",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte .slow.test.ts .integration.test.ts",
    "tokens:fixtures": "bun scripts/check-browser-fixture-token-literals.ts",
    "tokens:audit": "bun scripts/check-component-css-token-usage.ts",
    "families:generate": "bun scripts/derive-families.ts",
    "families:check": "bun scripts/derive-families.ts --check",
    "create-package": "bun scripts/create-package.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json scripts src"
  },
  "dependencies": {
    "@lostgradient/environmentalist": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "esm-env": "catalog:",
    "postcss": "catalog:",
    "postcss-selector-parser": "catalog:",
    "prettier": "catalog:",
    "svelte": "catalog:",
    "svelte2tsx": "catalog:",
    "ts-morph": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
