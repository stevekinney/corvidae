{
  "name": "@lostgradient/weft",
  "private": true,
  "type": "module",
  "bin": {
    "weft": "src/cli-main.ts",
    "weft-mcp": "src/cli-mcp.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.test-support.ts",
    "!src/**/__fixtures__/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./worker/authoring": "./src/worker/authoring.ts",
    "./worker/generated-authoring": "./src/worker/generated-authoring.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error && bun scripts/check-lint-disables.ts && bun scripts/check-implementation-file-sizes.ts && bun scripts/check-import-cycles.ts && bun scripts/check-internal-imports.ts && bun scripts/check-engine-internals-field-access.ts && bun scripts/check-revision-keyed-lookups.ts && bun scripts/check-definition-vocabulary.ts && bun scripts/check-catalog-completeness.ts && bun scripts/check-type-ergonomics.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "test": "bun test --path-ignore-patterns='scripts/benchmarks/activity-completions.test.ts' --path-ignore-patterns='scripts/benchmarks/cold-start.test.ts' --path-ignore-patterns='scripts/benchmarks/load-growth-memory.test.ts' --path-ignore-patterns='scripts/benchmarks/memory-per-workflow.test.ts' --path-ignore-patterns='scripts/benchmarks/recovery.test.ts' --path-ignore-patterns='scripts/benchmarks/token-stream-latency.test.ts' --path-ignore-patterns='scripts/benchmarks/worker-spawn.test.ts' --path-ignore-patterns='scripts/benchmarks/workflow-starts.test.ts'",
    "test:benchmarks": "bun test ./scripts/benchmarks ./src/storage/bun-sql-benchmark.test.ts ./scripts/benchmarks/speculation.bench.ts",
    "test:coverage": "bun scripts/check-coverage.ts",
    "test:browser": "WEFT_BROWSER_SMOKE=1 bun test ./src/storage/indexeddb-browser.test.ts ./src/storage/web-extension-browser.test.ts ./src/service-worker/service-worker-browser.test.ts ./src/client/http-client-browser.test.ts",
    "typecheck": "tsc --noEmit && bun run typecheck:fixtures && bun ../../scripts/typecheck-contracts.ts && bun run typecheck:documentation",
    "typecheck:documentation": "bun scripts/check-documentation-code-blocks.ts",
    "typecheck:fixtures": "tsc --noEmit -p src/cli/__fixtures__/codegen/typecheck/tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "catalog:",
    "@msgpack/msgpack": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "better-sqlite3": "catalog:",
    "lmdb": "catalog:",
    "pg": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:",
    "@lostgradient/environmentalist": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "fake-indexeddb": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
