{
  "name": "@lostgradient/weft",
  "private": true,
  "type": "module",
  "bin": {
    "weft": "src/cli-main.ts",
    "weft-mcp": "src/cli-mcp.ts"
  },
  "files": [
    "src/**/*.ts",
    "!src/**/*.test.ts",
    "!src/**/*.test-d.ts",
    "!src/**/*.test-support.ts",
    "!src/**/__fixtures__/**"
  ],
  "exports": {
    ".": "./src/index.ts",
    "./worker": "./src/worker/index.ts",
    "./worker/authoring": "./src/worker/authoring.ts",
    "./worker/generated-authoring": "./src/worker/generated-authoring.ts",
    "./a2a": "./src/a2a/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error && bun scripts/check-lint-disables.ts && bun scripts/check-implementation-file-sizes.ts && bun scripts/check-import-cycles.ts && bun scripts/check-internal-imports.ts && bun scripts/check-engine-internals-field-access.ts && bun scripts/check-revision-keyed-lookups.ts && bun scripts/check-definition-vocabulary.ts && bun scripts/check-catalog-completeness.ts && bun scripts/check-type-ergonomics.ts && bun scripts/check-a2a-extension-schemas.ts && bun ../../scripts/check-inherited-key-reads.ts && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "test": "bun ../../scripts/bun-test-junit.ts --parallel=4 --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='src/core/checkpoint-prune.test.ts' && bun ../../scripts/bun-test-junit.ts --report-name=checkpoint-prune ./src/core/checkpoint-prune.test.ts",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .slow.test.ts",
    "test:benchmarks": "bun scripts/run-benchmarks.ts",
    "test:coverage": "bun scripts/check-coverage.ts",
    "test:a2a-tck": "bun scripts/run-a2a-tck.ts",
    "test:browser": "WEFT_BROWSER_SMOKE=1 bun ../../scripts/bun-test.ts ./src/storage/indexeddb-browser.test.ts ./src/storage/web-extension-browser.test.ts ./src/service-worker/service-worker-browser.test.ts ./src/client/http-client-browser.test.ts",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc --noEmit && bun run typecheck:fixtures && bun ../../scripts/typecheck-contracts.ts && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "typecheck:fixtures": "tsc --noEmit -p src/cli/__fixtures__/codegen/typecheck/tsconfig.json"
  },
  "dependencies": {
    "@electric-sql/pglite": "catalog:",
    "@libsql/client": "catalog:",
    "@msgpack/msgpack": "catalog:",
    "@neondatabase/serverless": "catalog:",
    "@noble/hashes": "catalog:",
    "@valibot/to-json-schema": "catalog:",
    "better-sqlite3": "catalog:",
    "pg": "catalog:",
    "valibot": "catalog:",
    "zod": "catalog:",
    "@lostgradient/environmentalist": "catalog:",
    "@modelcontextprotocol/server": "catalog:",
    "@lostgradient/storage": "workspace:*",
    "@lostgradient/storage-bun-sqlite": "workspace:*"
  },
  "peerDependencies": {
    "@a2a-js/sdk": "1.3.0"
  },
  "peerDependenciesMeta": {
    "@a2a-js/sdk": {
      "optional": true
    }
  },
  "devDependencies": {
    "@a2a-js/sdk": "catalog:",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "ajv": "catalog:",
    "fake-indexeddb": "catalog:",
    "oxlint": "catalog:",
    "playwright": "catalog:",
    "prettier": "catalog:",
    "standardwebhooks": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
