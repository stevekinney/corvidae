{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": false,
    "composite": true,
    "emitDeclarationOnly": true,
    "rootDir": ".",
    "outDir": ".types",
    "tsBuildInfoFile": ".types/tsconfig.source.tsbuildinfo"
  },
  "include": ["src", "scripts", "package.json"],
  "exclude": [
    "node_modules",
    "**/*.test.ts",
    "**/*.bench.ts",
    "src/cli/__fixtures__/**",
    "src/client/__fixtures__/**",
    "**/*.test-d.ts"
  ]
}
