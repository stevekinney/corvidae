    "@playwright/test": "catalog:",
    "@axe-core/playwright": "catalog:",
    "postcss-value-parser": "catalog:"
  },
  "devDependencies": {
    "@repo/typescript-configuration": "workspace:*",
    "@types/node": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "pngjs": "catalog:",
    "pixelmatch": "catalog:",
    "@types/pngjs": "catalog:"
  }
}
