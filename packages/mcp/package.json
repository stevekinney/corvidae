{
  "name": "@lostgradient/mcp",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./http": "./src/http.ts",
    "./oauth": "./src/oauth/index.ts",
    "./oauth/postgres": "./src/oauth/postgres.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "probe:deployed-smoke": "bun src/deployed-smoke.ts",
    "probe:inspector": "bun src/connector-smoke-inspector.ts",
    "probe:deployed-oauth": "bun src/deployed-oauth.ts",
    "typecheck": "tsc -b tsconfig.json",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts'",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .integration.test.ts",
    "test:oauth:postgres": "bun ../../scripts/bun-test.ts src/oauth-postgres.integration.test.ts",
    "test:browser-consent": "bun ../../scripts/bun-test.ts ../credentials/src/browser-consent.integration.test.ts ../storage-postgres/src/postgres.integration.test.ts ../storage/src/sql/postgres-conditional-batch-retry.test.ts"
  },
  "dependencies": {
    "@lostgradient/storage": "workspace:*",
    "@lostgradient/storage-postgres": "workspace:*",
    "pg": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
