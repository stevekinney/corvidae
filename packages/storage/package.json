{
  "name": "@lostgradient/storage",
  "private": true,
  "description": "The key-value storage protocol Weft and its adapters share: the Storage interface, the in-memory and scoped stores, the SQL helpers several adapters use, and the contract tests every adapter runs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./sql": "./src/sql/index.ts",
    "./testing": "./src/testing/index.ts",
    "./testing/sqlite-contention": "./src/testing/sqlite-contention.test-support.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error && bun ../../scripts/check-inherited-key-reads.ts && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts",
    "test:coverage": "bun ../../scripts/bun-test.ts --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "@lostgradient/environmentalist": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
