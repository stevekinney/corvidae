{
  "name": "@lostgradient/storage-d1",
  "private": true,
  "description": "The Cloudflare D1 storage adapter: a durable Storage over a D1 binding, with Miniflare contract tests.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts && bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts'",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .integration.test.ts",
    "test:coverage": "bun ../../scripts/bun-test.ts --path-ignore-patterns='**/*.integration.test.ts' --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "@lostgradient/storage": "workspace:*"
  },
  "devDependencies": {
    "@lostgradient/mcp": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@lostgradient/workerd-testing": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
