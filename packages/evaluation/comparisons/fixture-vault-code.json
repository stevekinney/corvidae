{
  "description": "Offline distributed-information control: shard-limited samplers cannot out-vote the missing digits, so the partitioned-search collaboration is admitted.",
  "suite": "../src/fixtures/comparison/vault-code.ts",
  "admissionRule": {
    "kind": "collaboration-admission-rule",
    "name": "fixture-partitioned-search-admission",
    "version": "1",
    "taskClass": "partitioned-search",
    "minimumCases": 1,
    "quality": {
      "successComparison": "point-estimate",
