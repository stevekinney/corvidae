{
  "name": "@lostgradient/operative",
  "description": "A composable agent loop with lazy Anthropic, OpenAI, and Gemini providers exposed through its source entry point.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./run-engine-workflow-types": "./src/durable/run-engine-workflow-types.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-inherited-key-reads.ts && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts"
  },
  "dependencies": {
    "@standard-schema/spec": "catalog:",
    "@lostgradient/weft": "workspace:*",
    "armorer": "workspace:*",
    "conversationalist": "workspace:*",
    "@lostgradient/cryptography": "workspace:*",
    "@lostgradient/lifecycle": "workspace:*",
    "ajv": "catalog:",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@google/genai": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "openai": "catalog:",
    "@lostgradient/environmentalist": "catalog:",
    "@lostgradient/storage": "workspace:*"
  },
  "peerDependencies": {
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-typesafe": "catalog:"
  },
  "peerDependenciesMeta": {
    "@tanstack/ai": {
      "optional": true
    },
    "@tanstack/ai-typesafe": {
      "optional": true
    }
  },
  "devDependencies": {
    "@tanstack/ai": "catalog:",
    "@tanstack/ai-typesafe": "catalog:",
    "@types/bun": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:",
    "@lostgradient/testing": "workspace:*"
  },
  "private": true
}
