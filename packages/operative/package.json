{
  "name": "@corvidae/operative",
  "description": "A composable agent loop with lazy Anthropic, OpenAI, and Gemini providers exposed through its source entry point.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@corvidae/weft": "workspace:*",
    "@corvidae/armorer": "workspace:*",
    "@corvidae/conversationalist": "workspace:*",
    "@corvidae/cryptography": "workspace:*",
    "@corvidae/embeddings": "workspace:*",
    "@corvidae/lifecycle": "workspace:*",
    "@corvidae/tool-protocol": "workspace:*",
    "zod": "catalog:",
    "@opentelemetry/api": "catalog:",
    "@google/genai": "catalog:",
    "@anthropic-ai/sdk": "catalog:",
    "openai": "catalog:",
    "@lostgradient/environmentalist": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "@corvidae/typescript": "workspace:*",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  },
  "private": true
}
