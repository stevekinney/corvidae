{
  "name": "@lostgradient/storage-neon",
  "private": true,
  "description": "The Neon storage adapter: a durable, remote Storage over Neon serverless Postgres through the @neondatabase/serverless driver, with the contract tests it runs.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json --report-unused-disable-directives-severity=error && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc -b tsconfig.json",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts && bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts'",
    "test:slow": "bun ../../scripts/bun-test-selected.ts --parallel=1 .slow.test.ts .integration.test.ts",
    "test:coverage": "bun ../../scripts/bun-test.ts --coverage --coverage-reporter=text --coverage-reporter=lcov"
  },
  "dependencies": {
    "@lostgradient/storage": "workspace:*",
    "@neondatabase/serverless": "catalog:"
  },
  "devDependencies": {
    "@electric-sql/pglite": "catalog:",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "@types/pg": "catalog:",
    "oxlint": "catalog:",
    "pg": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": false
}
