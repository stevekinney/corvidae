// Bun Snapshot v1, https://bun.sh/docs/test/snapshots

exports[`pins Bureau’s MCP initialization, tool listing, and call responses: initialize 1`] = `
"event: message
data: {"result":{"protocolVersion":"2025-11-25","capabilities":{"tools":{"listChanged":true}},"serverInfo":{"name":"bureau","title":"Bureau","version":"<weft-version>"}},"jsonrpc":"2.0","id":"initialize"}

"
`;

exports[`pins Bureau’s MCP initialization, tool listing, and call responses: tools/list 1`] = `
"event: message
data: {"result":{"tools":[{"name":"bureau.agents.list","title":"List the agents the caller may see","description":"Returns the agents the deployment has, in definition order: its \`name\` (the catalog key every other operation calls \`agentName\`), \`displayName\`, \`description\`, \`definitionRevision\`, \`kind\` (\`code\` for a code-defined agent, \`file\` for a persisted one), \`a2a\` (whether the agent opts into A2A: the \`a2a.agents\` setting says so where it names the agent; otherwise the handler’s \`a2aAgents\` allowlist names a code-defined agent, or a persisted agent’s file says \`a2a: true\`), and \`media\` (what the agent’s model takes in the way of media, as \`modalities\`, \`mimeFamilies\` and per-part \`mediaLimits\`, or \`null\` when the agent names no model descriptor; for a routed agent, what every route takes), and \`tools\` (the names of the tools the agent has, which a code-defined agent states and a persisted agent names in its file; omitted when the agent does not say, which differs from \`[]\`), and \`examples\` (prompts that show what a person might ask the agent, which a code-defined agent states and a persisted agent lists in its file; omitted when the agent has none). A caller holding \`bureau.agents:read\` sees every agent that is ready, code-defined or persisted (\`bureau.agents.definitions.*\`); any other authenticated caller, such as an A2A credential, sees only the ready agents that opt into A2A. An invalid agent file is not listed. An agent a plugin declares with \`visibility: hidden\` is listed with \`visibility: \\"hidden\\"\`, and a client that offers agents for a chat leaves it out; workflows, children and a direct start run it by name.","inputSchema":{"type":"object","properties":{},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.tasks.list","title":"List tasks","description":"Lists the caller’s own tasks, most recently changed first (by status timestamp, then task id ascending); a caller holding \`bureau.tasks:read\` lists every owner’s. \`contextId\` returns only that context’s tasks in its current incarnation, \`origin\` only the tasks recorded with an origin of that kind (\`chat\`, \`person\`, \`schedule\`, \`api\`, \`agent\`, \`goal\`, or \`parent\`), \`parentRunId\` only the subordinate tasks of that run (the children it started, the attempts of a goal, the steps of a workflow instance), \`parentContextId\` only the child runs started from any run in that context (a reloaded chat lists the children of every run in its thread this way), \`siblingsOf\` only the tasks that share a parent run with the named task, that task excluded, \`workflow\` only the tasks that ran on that workflow type (\`workflow.type\` on each task says which), \`attention\` only the tasks whose \`attention\` lists that kind (\`stalled\` or \`looping\`), \`failedStep\` only the tasks that failed at the step with that label (\`failure.step.label\`), \`retrying\` only the tasks with a step on a second or later try (\`true\`) or with none (\`false\`), and \`statusTimestampAfter\` (ISO 8601) only tasks whose status timestamp is strictly later. Pages with \`limit\` (1 to 100, default 50, free to change between pages) and \`pageToken\`; \`nextPageToken\` is \`null\` when no entries remain. The first page of a listing with a next page records the listing, and every later page returns the tasks exactly as they matched then, so a task that changes mid-enumeration keeps its place and appears once; a task removed since is skipped, so a page can hold fewer than \`limit\` tasks. A token is opaque, valid for 15 minutes from the first page, and only with the principal, reach, wire projection (never the one of A2A \`ListTasks\`), and filters (\`contextId\`, \`agentName\`, \`status\`, \`origin\`, \`parentRunId\`, \`parentContextId\`, \`siblingsOf\`, \`workflow\`, \`attention\`, \`failedStep\`, \`retrying\`, \`engineRuns\`, \`statusTimestampAfter\`) it was issued for, and only while the context is the incarnation it was issued for; any other token is \`InvalidParams\`. The schedule tick’s runs and the instances of workflow files are listed too, read from the engine, for a caller that may read the deployment’s workflows. A principal holds at most 16 live listings, and starting another ends its oldest.","inputSchema":{"type":"object","properties":{"contextId":{"description":"Only the tasks in this context’s current incarnation.","type":"string","minLength":1},"agentName":{"description":"Only the tasks run by this agent.","type":"string","minLength":1},"status":{"description":"Only the tasks in this state.","type":"string","enum":["submitted","working","input-required","completed","failed","canceled"]},"origin":{"description":"Only the tasks recorded with an origin of this kind. A task recorded before origins were kept has none and matches no kind.","type":"string","enum":["chat","person","schedule","api","agent","agent-run","goal","parent","system","trigger"]},"parentRunId":{"description":"Only the subordinate tasks of this run: the children an agent run started, the attempts of a goal run, or the steps of a workflow instance.","type":"string","minLength":1},"parentContextId":{"description":"Only the child runs started from a run in this context: the tasks of origin \`agent\` whose parent ran in this session, whichever run of the context started them. Tasks of other kinds, and children whose parent had no session, match nothing.","type":"string","minLength":1},"siblingsOf":{"description":"Only the tasks that share a parent run with this task, this task excluded. A task that does not exist, that is not yours to read, or that has no parent run matches nothing.","type":"string","minLength":1},"workflow":{"description":"Only the tasks that ran on this workflow type: \`agentRun\`, \`goalRun\`, \`scheduleTick\`, or the identifier of a workflow file for its instances. A task’s \`workflow.type\` says which.","type":"string","minLength":1},"attention":{"description":"Only the tasks whose \`attention\` lists this kind: \`stalled\` for a run that is alive but making no progress outside a declared wait, \`looping\` for a run whose toolbox reported a loop. A task that has ended lists neither, and the schedule tick’s runs and the instances of workflow files, which have no record to hold one, match nothing.","type":"string","enum":["stalled","looping"]},"failedStep":{"description":"Only the tasks that failed at the step with this label (\`failure.step.label\`): a tool’s name, \`model\` for a model step, or for a workflow run the engine’s \`failedStep.label\`. A label longer than 200 characters is compared as its first 200.","type":"string","minLength":1,"maxLength":1000},"retrying":{"description":"\`true\`: only the tasks with a step on a second or later try (\`retrying\` on the task is set). \`false\`: only the tasks with none.","type":"boolean"},"engineRuns":{"description":"Whether the schedule tick’s runs and the instances of workflow files, which the engine holds and no task record describes, are listed beside the tasks. Defaults to true for a caller that may read the deployment’s workflows; \`false\` lists only the tasks that have records, so a reader that wants an agent’s or a goal’s runs is not given its page slots to the engine’s. It never lists them for a caller that may not read them.","type":"boolean"},"statusTimestampAfter":{"description":"Only tasks whose status timestamp is strictly after this instant, as an ISO 8601 date-time with an offset.","type":"string","format":"date-time","pattern":"^(?:(?:\\\\d\\\\d[2468][048]|\\\\d\\\\d[13579][26]|\\\\d\\\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\\\d|30)|(?:02)-(?:0[1-9]|1\\\\d|2[0-8])))T(?:(?:[01]\\\\d|2[0-3]):[0-5]\\\\d:[0-5]\\\\d(?:\\\\.\\\\d+)?(?:Z|([+-](?:[01]\\\\d|2[0-3]):[0-5]\\\\d)))$"},"limit":{"description":"The most tasks to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"pageToken":{"description":"The \`nextPageToken\` of the previous page, to continue that listing. An opaque token, valid for 15 minutes from the first page and only with the filters it was issued for.","type":"string","minLength":1}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.tasks.get","title":"Read one task","description":"Returns one of the caller’s own tasks; a caller holding \`bureau.tasks:read\` reads any owner’s. Another owner’s task answers as a missing one does.","inputSchema":{"type":"object","properties":{"taskId":{"type":"string","minLength":1,"description":"The identifier of the task to read."}},"required":["taskId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.tasks.inspect","title":"Inspect one task","description":"Returns a versioned snapshot of one of the caller’s own tasks for the run inspector: the task, its liveness (status, assessment, reachability, progress, the declared wait and its reason, semantic progress, and the evidence entries by source and time), and the children it owns with each one’s assessment. \`liveness\` is \`null\` when this process holds no live run for the task. Transport heartbeat evidence is reported as its own source and is never semantic progress. \`steps\` carries each step’s reply details: \`planReason\` (why it ran on its model: a code, one line, and the models passed over) and \`effectiveContext\` (what the model saw, as source digests and message ids, never message content; capped at 256 KiB, newest messages kept, \`truncated\` when older ones were left out), each \`null\` for a step recorded without one. \`effectiveContext\` is returned only when \`step\` names one step, because a record runs to 256 KiB and this snapshot is polled; the list form carries \`hasEffectiveContext\` in its place. A run that seals no context epochs records an \`effectiveContext\` with no \`epochId\`. \`hooks\` carries the run’s hook plan while it is live (\`plan\`: each registration’s \`id\`, \`hookPoint\`, \`source\`, \`priority\` and \`replay\`, redacted, \`null\` once the run has ended or when the plan cannot be read) and the registrations of its plan that threw (\`failed\`: \`hookId\`, \`hookPoint\`, \`source\`, how many times (\`count\`) and when last (\`lastFailedAt\`), never the error’s text). The snapshot carries no transcript, prompt, tool argument, result, or checkpoint: read the answer and any gap on \`bureau.tasks.events\`, and cancel with \`bureau.tasks.cancel\`. A caller holding \`bureau.tasks:read\` inspects any owner’s; another owner’s task answers as a missing one does.","inputSchema":{"type":"object","properties":{"taskId":{"type":"string","minLength":1,"description":"The identifier of the task to inspect."},"step":{"description":"Only this step’s reply details in \`steps\`. Omitted, \`steps\` lists the newest 50 steps of the run.","type":"integer","minimum":0,"maximum":9007199254740991}},"required":["taskId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.runs.timeline","title":"Read the step timeline of a run","description":"Returns the steps of one run in the order it took them, for drawing a waterfall: each entry’s \`label\`, \`operationType\`, \`status\`, \`timestamp\` (its start, in epoch milliseconds), \`duration\` (milliseconds, absent while it runs) and \`tries\` (how many attempts the engine made at the step, this one included). \`runId\` is an agent run’s task id or a workflow instance’s id, and \`kind\` says which; \`runStatus\` says where the run stands (\`pending\`, \`running\`, \`suspended\`, \`completed\`, \`failed\`, \`cancelled\` or \`timed-out\`), so a reader can tell a step the run has left from one it is still in. No step’s input or output is returned, only names and timings. An agent run is read with the access \`bureau.tasks.get\` asks and a workflow instance with the access \`bureau.workflows.runs.get\` asks; any other run, a run the caller may not read, and a run that does not exist are all \`NotFound\`. A run of more than 1000 entries is cut and \`truncated\` is true.","inputSchema":{"type":"object","properties":{"runId":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the run: an agent run’s task id, or a workflow instance’s id."}},"required":["runId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.runs.compare","title":"Compare a forked workflow run with its source, step by step","description":"Takes the id of a workflow run made by forking another and returns the run it was forked from (\`sourceRunId\`), the \`forkPoint\` (the source checkpoint step the fork started from) and the two runs aligned by durable step: each step's \`index\`, whether it is \`shared\` (before the fork point, so both sides are the source's entry) and, for \`source\` and \`fork\`, the \`operationType\`, \`label\`, \`status\`, \`input\` and \`output\` the engine summarizes, with payload fields redacted as the timeline read redacts them. A side is absent when that run has no entry for the step. Pages by step: \`limit\` (100 by default, at most 1000) and \`nextCursor\`. The fork and its source are each read with the access \`bureau.workflows.runs.get\` asks; a run the caller may not read, a source the caller may not read, a run that is no instance of a workflow file, and a run that does not exist are all \`NotFound\`. A run that is not a fork is \`Unprocessable\`, and its message says what to do.","inputSchema":{"type":"object","properties":{"runId":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the fork: a workflow instance’s id."},"limit":{"description":"Steps in a page. Defaults to 100; at most 1000.","type":"integer","minimum":1,"maximum":1000},"cursor":{"description":"The nextCursor of the previous page; omit it for the first page.","type":"string","minLength":1,"maxLength":256}},"required":["runId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.tasks.explain","title":"Explain why a run failed","description":"Returns why one failed run failed, from what Bureau stored about it and nothing else: no model is called, so the same settled run answers the same every time. \`runId\` is an agent run’s task id or a workflow instance’s id. \`summary\` is one sentence naming the step and the cause, built from the failure category (\`application\`, \`timeout\`, \`cancellation\`, \`resource\`, \`system\`, or \`null\` when nothing classifies the failure: a workflow instance’s is the engine’s, an agent run’s is read from its finish reason and its error’s kind) and the error’s kind. \`cause\` is the category, the error’s \`code\` and its \`kind\` (an agent run’s; \`null\` for a workflow instance). \`step\` is the step the run failed at (its index and label), \`tries\` how many times the engine tried that step (\`null\` when its history records no failed attempt, as for an agent run that ended on a failed result), \`verdicts\` each guardrail that fired in the run (its \`name\`, whether it halted the run as a \`tripwire\` or let it go on as a \`guardrail\`, and its \`outcome\`; a workflow instance’s own steps included), \`remediation\` what to do next, and \`nextCommands\` \`interborough\` command lines that read the run. It carries no error message, stack, tool argument or flagged text. A run that did not fail, one that is still going included, is \`Unprocessable\` with \`data.reason\` \`run-not-failed\` and a \`remediation\`; a workflow instance whose run state or timeline the Bureau cannot read, because it has no durable engine, is \`UnsupportedCapability\` (\`durable-engine\`), never \`run-not-failed\`. An agent run is read with the access \`bureau.tasks.get\` asks and a workflow instance with the access \`bureau.workflows.runs.get\` asks; any other run, a run the caller may not read, and a run that does not exist are all \`NotFound\`.","inputSchema":{"type":"object","properties":{"runId":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the failed run: an agent run’s task id, or a workflow instance’s id."}},"required":["runId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.tasks.cancel","title":"Cancel a task","description":"Cancels one of the caller’s own tasks; a caller holding \`bureau.tasks:write\` cancels any owner’s. The receipt says where the cancellation stands: \`cancel-requested\` (the run has not stopped), \`canceled\` (a durable run stopped with no cleanup evidence to report), \`cleanup-pending\`, \`cleaned-up\`, \`cleanup-failed\`, \`cleanup-unresolved\` (cleanup could not be confirmed and may still be running, so nothing is promised about external effects), \`unknown-outcome\` (an external effect may or may not have happened), or \`rejected\` (nothing is applied). A rejection carries a \`reason\`: \`already-terminal\` (the task had already finished without being canceled), \`owned-by-goal\` (the task is one attempt of a goal, which only cancelling the goal stops) or \`owned-by-workflow\` (the task is a step of a workflow instance, which is not cancelled on its own). Cancelling the task of a child run stops the child as \`bureau.children.cancel\` does. \`waitMilliseconds\` (default 0) waits that long for the cleanup acknowledgement; \`bureau.tasks.get\` carries the same state afterwards. A repeated cancel has the same effect. With \`dryRun: true\` nothing is cancelled: the answer is \`{ dryRun: true, target, effects }\`, whose \`runs-in-progress\` effect counts the run the cancel would stop (1 while the task is in progress, 0 once it has finished or when it belongs to a goal or a workflow instance, whose cancel is \`rejected\`), and a task the real call would not find is \`NotFound\` as well.","inputSchema":{"type":"object","properties":{"taskId":{"type":"string","minLength":1,"description":"The identifier of the task to cancel."},"waitMilliseconds":{"description":"How long, in milliseconds, to wait for cleanup acknowledgements before answering, from 0 to 60000. Defaults to 0, which does not wait.","type":"integer","minimum":0,"maximum":60000},"dryRun":{"description":"When \`true\`, performs the authorization and validation of the call, writes nothing, publishes no event and appends no audit record, and answers \`{ dryRun: true, target, effects }\` naming what the call would change. A target the real call would not find, or a caller it would refuse, answers the same fault.","type":"boolean"}},"required":["taskId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true}},{"name":"bureau.tasks.events","title":"Follow one task’s lifecycle","description":"Streams a task’s lifecycle from its durable history: \`task.status\` elements carry the task’s state, a status message and, when it completes, its answer as one artifact; \`task.resynced\` restates the task’s state after the history failed to record a change (apply it as a \`task.status\`); \`task.snapshot\` opens a subscription that names no cursor; \`task.gap\` marks a resume below the retention floor (exactly once; repair with \`bureau.tasks.get\`); \`task.removed\` ends the stream. Each element’s \`cursor\` resumes the stream through \`fromCursor\` or \`Last-Event-ID\`. The stream carries no step content, tool call or tool result. The task’s owner may subscribe; any other principal needs \`bureau.tasks:read\`, and a subscription to another owner’s task answers as a missing one does. The grant is checked when the subscription starts.","inputSchema":{"type":"object","properties":{"taskId":{"type":"string","minLength":1,"description":"The identifier of the task whose lifecycle to follow."},"fromCursor":{"description":"The \`cursor\` of the last element already seen; the stream continues after it. Omitting it opens the stream with a \`task.snapshot\`.","type":"string","minLength":1}},"required":["taskId"],"additionalProperties":false},"annotations":{"readOnlyHint":true,"destructiveHint":false}},{"name":"bureau.tasks.respond","title":"Answer a task’s open human-input or approval wait","description":"Answers one open wait of a task as the authenticated caller. \`answer\` (text, or a list of parts joined with a newline) answers a human-input wait; \`decision\` (\`approve\`, \`deny\`, or \`reject\`, which requires a \`reason\`) decides an approval or a human wait. \`signalName\` or \`callId\` says which wait when several are open; with neither, exactly one must be. \`messageId\` is the idempotency key: an exact retry returns the original receipt, and the same \`messageId\` with a different command is a \`Conflict\`. The task’s owner answers anything; a caller holding \`bureau.tasks:write\` answers human-input waits only, and another owner’s approval answers as a missing task. The \`receipt\` is \`applied\` or \`superseded\` (the approval was gated again and the tool did not run). An answer that names, by \`signalName\`, a question the task asked and that was already decided is a \`Conflict\` whose \`reason\` starts \`REVIEW_ALREADY_RESOLVED:\`, as \`bureau.reviews.resolve\` answers a review already resolved; a \`signalName\` the task never asked is a plain \`Conflict\`.","inputSchema":{"type":"object","properties":{"taskId":{"type":"string","minLength":1,"description":"The identifier of the task whose wait is answered."},"messageId":{"type":"string","minLength":1,"maxLength":200,"description":"The caller’s idempotency key for this command."},"answer":{"description":"Answer text; a list of parts is joined with a newline.","anyOf":[{"type":"string","minLength":1},{"minItems":1,"type":"array","items":{"type":"string","minLength":1}}]},"data":{"description":"The answer of a human wait that carries an input schema: one JSON object, validated against that schema before it is delivered as the signal’s payload.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"decision":{"description":"Decides an approval or a human wait. \`reject\` requires a \`reason\`.","type":"string","enum":["approve","deny","reject"]},"reason":{"description":"Required, and non-blank, for \`reject\`.","type":"string"},"signalName":{"description":"Addresses the human wait with this signal.","type":"string","minLength":1},"callId":{"description":"Addresses the tool approval for this call.","type":"string","minLength":1}},"required":["taskId","messageId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true}},{"name":"bureau.contexts.list","title":"List contexts","description":"Lists the caller’s own contexts (chat sessions) with a title, a last-message preview, a message count, times and \`activity\` (\`running\`, \`awaiting-input\` or \`idle\`), newest update first by default. Each carries its \`origin\`: \`chat\` for a context a person started (and for every context that records no origin), \`goal\` for a goal’s session, \`schedule\` for a session a schedule’s fire created, \`try\` for a throwaway chat with an unsaved agent definition (\`bureau.agents.try\`), which is left out of the list unless \`origin\` is \`try\`. Each carries \`archivedAt\`, when it was archived (\`bureau.contexts.archive\`), or \`null\`. \`agentName\` filters by agent, \`origin\` by origin, \`titleContains\` by a case-insensitive substring of the title (a title given by \`bureau.contexts.rename\` counts), \`archived\` by whether it is archived (\`include\`, the default, lists every one; \`exclude\` leaves the archived ones out; \`only\` lists only them), and \`activity\` by what the context is doing right now, all before the page is cut, so a page of chats holds chats and \`offset\` counts matches. An \`activity\` filter classifies the contexts the other filters leave, a hundred at a time, until the page is full; a context’s activity can change between pages. \`allOwners: true\` lists every owner’s and requires \`bureau.contexts:read\`; without it the call is a \`Forbidden\` fault. Pages with \`limit\` (1 to 100, default 50) and \`offset\`; \`nextOffset\` is \`null\` on the last page. No transcript and no internal metadata is returned.","inputSchema":{"type":"object","properties":{"agentName":{"description":"Only the contexts of this agent.","type":"string","minLength":1},"titleContains":{"description":"Only the contexts whose title contains this text, ignoring case.","type":"string","minLength":1,"maxLength":200},"activity":{"description":"Only the contexts that are in this activity state right now.","type":"string","enum":["running","awaiting-input","idle"]},"origin":{"description":"Only the contexts with this origin; \`chat\` includes every context that records none. Contexts of origin \`try\` are listed only when this is \`try\`.","type":"string","enum":["chat","goal","schedule","try"]},"archived":{"description":"Which contexts to list by whether they are archived: \`include\` (the default) lists every one, \`exclude\` only the ones that are not archived, \`only\` only the archived ones.","type":"string","enum":["include","exclude","only"]},"allOwners":{"description":"List every owner’s contexts; requires \`bureau.contexts:read\`.","type":"boolean"},"sortBy":{"description":"The time to order by. Defaults to \`updatedAt\`.","type":"string","enum":["updatedAt","createdAt"]},"sortOrder":{"description":"The direction to order in. Defaults to \`desc\`, newest first.","type":"string","enum":["asc","desc"]},"limit":{"description":"The most entries to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"offset":{"description":"How many entries to skip before the page starts. Defaults to 0.","type":"integer","minimum":0,"maximum":9007199254740991}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.contexts.get","title":"Read one context","description":"Returns the summary of one of the caller’s own contexts, with its \`origin\` and \`archivedAt\` (when it was archived, or \`null\`), and what its steering has settled on; a caller holding \`bureau.contexts:read\` reads any owner’s. \`model\` is the latest admitted model override (\`{ provider, model }\`, with a \`null\` provider when the override named none), or \`null\` before any, which means the agent’s default; \`effort\` is the latest admitted effort override (\`low\`, \`medium\`, \`high\`, \`xhigh\` or \`max\`), or \`null\` before any; \`permissionMode\` is the chat’s permission mode (\`always\`, \`on-changes\`, \`allow-all\` or \`read-only\`; it governs every tool of the chat’s runs, for any kind of agent, except \`requestHumanInput\`, and a child Bureau started under those runs takes it at its next tool call, as its grandchildren do; a child outside Bureau’s reach, including one an agent’s own \`createSubagentTool\` runs and a task a remote agent runs for a \`createPeerCallTool\` call, is not held to it, and a child whose agent exposes no run options is refused, not started, when a Bureau-owned run dispatches it), \`on-changes\` before one was set; \`configVersion\` is the version \`bureau.contexts.steer\`’s \`expectedRevision\` is compared against. Another owner’s context answers as a missing one does. The response carries no transcript: its only message text is the title and the last-message preview.","inputSchema":{"type":"object","properties":{"contextId":{"type":"string","minLength":1,"description":"The identifier of the context to read."}},"required":["contextId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.contexts.input","title":"Send input to a context","description":"Admits \`input\` (an \`id\` of the caller’s choosing and a \`payload\`: text, or a list of parts) to one of the caller’s own contexts, to be delivered to the context’s run at its next step boundary. The \`outcome\` is \`admitted\`, or \`replayed\` for an exact retry of an \`id\` already admitted; the \`receipt\` says where the input stands (\`accepted\` while it waits, \`promoted\` once the run took it into the conversation, \`canceled\` if the run ended or the context had no run to take it). An input is answered by the run it was admitted to or not at all: one that a run ends without delivering is cancelled and must be sent again. Another owner’s context, and a missing one, answer \`NotFound\`. A different input under an \`id\` already used is a \`Conflict\` with reason \`input-conflict\`, a context that has ended is a \`Conflict\` with reason \`session-terminal\`, an archived context (\`bureau.contexts.archive\`) is a \`Conflict\` with reason \`context-archived\`, a Bureau that cannot take input is \`Unavailable\` with reason \`unsupported-capability\`, and a context with too much input waiting is \`Unavailable\` with reason \`backlog-exhausted\`.","inputSchema":{"type":"object","properties":{"contextId":{"type":"string","minLength":1,"description":"The identifier of the context to send the input to."},"input":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":256,"description":"The caller’s own identifier for the input; an exact retry of it is a replay."},"payload":{"anyOf":[{"type":"string"},{"type":"array","items":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}}}],"description":"The input itself: text, or an ordered list of parts."}},"required":["id","payload"],"additionalProperties":false,"description":"The input to admit: an \`id\` of the caller’s choosing and its \`payload\`."}},"required":["contextId","input"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true}},{"name":"bureau.workflows.validate","title":"Validate a workflow draft","description":"Validates a workflow definition with the same parser and checks as a write, without writing a file or registering an engine workflow. With \`expectedHash\`, the existing file must still have that hash; without it, \`id\` must not already name a file. Requires \`bureau.workflows:read\`.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the workflow."},"expectedHash":{"type":"string","minLength":1,"description":"The \`hash\` of the workflow file the caller read; a file that has changed since is a \`StaleRevision\` fault and nothing is written."},"definition":{"type":"object","properties":{"title":{"description":"The name a person reads, shown as the heading with the identifier beside it. Bureau strips it before Weft sees the document.","type":"string"},"description":{"type":"string"},"agent":{"type":"string"},"paused":{"type":"boolean"},"inputSchema":{"description":"A JSON Schema (draft 2020-12) for the input an instance starts with: the \`input\` of \`bureau.workflows.start\`, the \`payload\` of a signal, or a schedule trigger’s \`input\` (\`null\` when it gives none), which must satisfy it when the file is written. At most 32 KiB, 8 levels deep, with no \`$id\`, \`pattern\`, or \`patternProperties\`.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"outputSchema":{"description":"A JSON Schema (draft 2020-12) for the value an instance finishes with, under the same limits. An instance whose result breaks it fails with \`output-invalid\`.","type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"outputName":{"description":"The name of what an instance produces, such as \`notes\`, shown on the run page’s Output card: at most 64 characters, a letter or underscore first, then letters, digits, underscores and hyphens. Bureau strips it before Weft sees the document, so it is no part of a revision.","type":"string"},"trigger":{"type":"object","properties":{"kind":{"type":"string"}},"required":["kind"],"additionalProperties":{},"description":"What starts the workflow: \`{ kind: \\"schedule\\", name?, spec, timezone?, overlap?, catchUp?, input? }\`, \`{ kind: \\"signal\\", name }\`, or \`{ kind: \\"manual\\" }\` for a workflow only a person starts. A schedule’s \`name\` is its display name; \`timezone\` is an IANA zone for a cron \`spec\`; \`catchUp: true\` runs what was missed while the host was off; \`input\` is the fixed value every fire starts with."},"steps":{"type":"array","items":{"type":"object","propertyNames":{"type":"string"},"additionalProperties":{}},"description":"The steps, run in order. Any step may carry a \`title\`; an \`await-signal\` step with \`review: true\` waits for a person and shows in Reviews."}},"required":["trigger","steps"],"additionalProperties":{},"description":"The workflow draft to validate. Unknown document keys are retained so canonical validation can report them as invalid-document issues."},"surface":{"description":"Where the person saving the workflow is (\`web\`, \`palette\`, or \`api\`); recorded with the version the save makes, for the workflow’s history.","type":"string","enum":["web","palette","api"]}},"required":["definition"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.workflows.get","title":"Read one workflow","description":"Returns one workflow: whether its file is \`ready\` or \`invalid\` (with the \`problem\` that makes it so), the \`hash\` and \`text\` of the file for an editor that writes it back with \`expectedHash\`, its \`description\`, who wrote it, whether it is paused, its \`trigger\` as written, its \`listener\` (what a contributed trigger is doing: \`state\` is \`listening\`, \`waiting-for-secret\`, \`failed\`, \`stopped\`, \`ready\` or \`standby\`, with \`since\`, \`code\` when it failed, and \`lastFiredAt\`; \`null\` for a built-in trigger kind, a file that is not \`ready\`, and a listener whose first start has not settled), its Weft \`version\`, and its live \`schedule\`. Requires \`bureau.workflows:read\` unless the caller owns the deployment’s workflows; anyone else is answered \`NotFound\`.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the workflow."}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.workflows.list","title":"List workflows","description":"Lists every workflow file by identifier, \`ready\` and \`invalid\` alike, then the code workflows plugins contributed, each with \`kind: \\"code\\"\`, its \`id\` (\`plugin:name\`), \`name\`, \`title\`, \`plugin\` and \`version\` and none of a file’s members (a code workflow starts and reads its runs back through the same operations as a file). Each file has its \`description\`, its \`trigger\`, its \`listener\` (see \`bureau.workflows.get\`; none on a code workflow), and, when \`includeRuns\` is \`true\`, for a \`ready\` file its \`runs\`: how many instances are \`active\`, how many began in the last 24 hours, and when the newest began (\`null\` otherwise, because each count reads the engine, and \`null\` too for a file whose count the engine could not give, which never withholds the list). Pages with \`limit\` (1 to 100, default 50) and \`offset\`; \`nextOffset\` is \`null\` on the last page. A caller who does not own the deployment’s workflows and lacks \`bureau.workflows:read\` gets an empty page.","inputSchema":{"type":"object","properties":{"limit":{"description":"The most entries to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"offset":{"description":"How many entries to skip before the page starts. Defaults to 0.","type":"integer","minimum":0,"maximum":9007199254740991},"includeRuns":{"description":"Counts each ready file’s instances. Off unless asked, because each count reads the engine.","type":"boolean"}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.workflows.runs.list","title":"List the instances of workflows","description":"Lists the instances (Weft runs) of the workflow files, newest first. \`workflow\` narrows to one workflow’s identifier, \`status\` to one status, and \`errorCode\` to the failed instances that recorded that code (\`review-rejected\` for a run a person rejected at a review, \`input-invalid\` or \`output-invalid\` for a schema failure). Pages with \`limit\` (1 to 100, default 50) and \`offset\`; \`nextOffset\` is \`null\` on the last page. A caller who does not own the deployment’s workflows and lacks \`bureau.workflows:read\` gets an empty page.","inputSchema":{"type":"object","properties":{"workflow":{"description":"Only the instances of this workflow.","type":"string","minLength":1,"maxLength":256},"status":{"description":"Only the instances in this status.","type":"string","enum":["pending","running","completed","failed","cancelled","timed-out","suspended"]},"errorCode":{"description":"Only the failed instances that recorded this error code: \`review-rejected\`, \`input-invalid\`, or \`output-invalid\`.","type":"string","minLength":1},"limit":{"description":"The most entries to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"offset":{"description":"How many entries to skip before the page starts. Defaults to 0.","type":"integer","minimum":0,"maximum":9007199254740991}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.workflows.runs.get","title":"Read one instance of a workflow","description":"Returns one instance: its workflow and revision, its status, what started it (\`trigger\`), its \`result\`, and, for an instance that failed, its \`error\`, including a failed \`agent\` step’s. \`finishReason\` is \`input-invalid\` or \`output-invalid\` for an instance that failed because its input or its result broke the workflow’s schema, and \`null\` for any other; the failed instance’s \`error\` lists the issues. \`outputName\` is the name the version it ran gives what it produces, or \`null\`. Only an instance of a workflow file is readable here; any other run is answered \`NotFound\`, as is a caller who does not own the deployment’s workflows and lacks \`bureau.workflows:read\`.","inputSchema":{"type":"object","properties":{"runId":{"type":"string","minLength":1,"description":"The identifier of the workflow instance to read."}},"required":["runId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.reviews.list","title":"List the reviews that are waiting for a decision, or that have been decided","description":"Returns the reviews of the caller’s own runs, which is what an inbox shows; a caller holding \`bureau.reviews:read\` sees every owner’s. \`status\` is \`pending\` (the default: oldest request first, by \`requestedAt\`) or \`resolved\` (the reviews a person decided, latest decision first, by \`resolution.decidedAt\`, optionally only those decided at or after \`resolvedAfter\`); each item carries \`source\`, \`bureau\` for a tool approval or a question the Bureau holds, and \`engine\` for a workflow review of the durable engine (\`kind: \\"engine-review\\"\`), which only a caller holding the Weft scope \`reviews:read\` is shown. Ties break on source, then id. Pages with \`limit\` (1 to 100, default 50) and \`pageToken\`; \`nextPageToken\` is \`null\` when no review remains, and \`total\` is how many reviews the whole listing holds for the caller and these filters, the same on every page (COR-2426). A token is an opaque position in that order, valid only with the \`status\` and \`resolvedAfter\` it was issued for; any other token is \`InvalidParams\`. A resolved review is kept until \`retention.audit\` retires it, and carries \`resolution\` (who decided, what, and when); a secret answer appears only as its reference, never its value. A review that expired, was revoked or was canceled has no decision and is not listed as resolved; \`bureau.reviews.get\` still reads it.","inputSchema":{"type":"object","properties":{"status":{"description":"Which reviews to list: \`pending\` (the default) or \`resolved\`, the ones a person has decided, which is what a Done tab shows.","type":"string","enum":["pending","resolved"]},"resolvedAfter":{"description":"With \`status: \\"resolved\\"\`: only the reviews decided at or after this instant, in epoch milliseconds.","type":"integer","minimum":0,"maximum":9007199254740991},"limit":{"description":"The most reviews to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"pageToken":{"description":"The \`nextPageToken\` of the previous page, to continue that listing. An opaque position, valid only with the \`status\` and \`resolvedAfter\` it was issued for.","type":"string","minLength":1}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.reviews.get","title":"Read one review by id","description":"Returns a review of one of the caller’s own runs, pending or resolved where the Bureau persists resolutions; a caller holding \`bureau.reviews:read\` reads any owner’s. Another owner’s review answers as a missing id does.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"description":"The identifier of the review to read."}},"required":["id"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.reviews.resolve","title":"Approve, deny, or reject a pending review","description":"Resolves a pending review of one of the caller’s own runs as the authenticated caller; the reviewer is never a payload field. A caller holding \`bureau.reviews:resolve\` resolves any owner’s. \`reject\` requires a \`reason\`. The \`receipt\` is \`applied\` (including a landed reject, which \`decision\` reports) or \`superseded\`. Resolving a review that is already resolved answers \`Conflict\` when the call asks for a different decision than the one recorded (a resolver that lost), and 404 when it repeats that decision, until command receipts exist; one the caller may not resolve answers 404. \`remember: true\` on approving a tool approval also allows its tool for the rest of the chat: the next ask for it in that chat that the agent file would make by \`on-changes\` runs without asking, and no other chat, fork, tool, \`always\` or \`blocked\` value, agent-wide always mode or read-only restriction is affected; the response says \`remembered\`. Resolving a tool approval also writes its outcome into the session’s conversation: the executed result on approve, an error result carrying the reason on deny and reject, each replacing the pending \`action_required\` result in place, so a run started next on the session answers an up-to-date conversation. The outcome row’s metadata records who decided and when, with the note, the sentence the tool asked with, and the \`decisionSurface\` the call gave, under \`approvalDecision\`. A \`superseded\` receipt writes nothing. A tool approval does not park its run, so once this call decides the last pending review of a chat’s run (approve, deny or reject), it starts the run that answers the decisions, as the chat’s own resume does: one run, owned by the chat’s owner whoever decided, under a command id of the decided run alone, so the chat’s resume of the same reviews, a decision racing it, and a retry all continue with that one run. \`continuation\` says which run (\`started\`), or why none could start (\`not-started\`, the decision having taken effect); it is absent while another review of the run is pending, for a run that is not a chat’s, and for a human wait, whose answer continues its parked run. Approving a human wait takes an \`answer\`; when the review has an \`inputSchema\` the answer is checked against it before anything is decided, and one that does not fit answers \`InvalidParams\` with \`data.issues\` (\`path\` rooted at \`answer\`, \`message\`, and \`code\`, the schema keyword that failed) and leaves the review pending. \`round\` is the round of the review the caller read (\`bureau.reviews.get\` and \`list\` return it): a re-gated approval keeps its id and advances its round, so a decision made on round N is refused with a \`Conflict\` once the review is at another round, before anything is decided, written, or audited. A \`Conflict\` whose \`reason\` begins \`REVIEW_ROUND_CHANGED: \` is that refusal (nothing took effect; read the review again); one that begins \`APPROVAL_OUTCOME_NOT_WRITTEN: \` means the decision took effect (the tool ran or was refused) and only that write failed; one that begins \`REVIEW_ALREADY_RESOLVED: \` (COR-2426) means the review was already resolved with another decision, so nothing took effect and it is no longer waiting; any other \`Conflict\` is a resolver that lost. Omit \`round\` and the call is not fenced.","inputSchema":{"type":"object","properties":{"id":{"type":"string","minLength":1,"description":"The identifier of the review to resolve."},"decision":{"type":"string","enum":["approve","deny","reject"],"description":"Whether to \`approve\` the review, \`deny\` it, or \`reject\` it with a \`reason\`."},"reason":{"description":"Required, and non-blank, for \`reject\`.","type":"string"},"answer":{"description":"Approving a human wait: the answer, delivered as the signal’s payload. When the review carries an \`inputSchema\` the answer must satisfy it, and is required; a wait with no schema takes any answer. Ignored for \`deny\` and \`reject\`, and refused for a tool approval, which takes no answer."},"round":{"description":"The \`round\` of the review the caller read. A re-gated tool approval keeps its id and advances its round; when this is given and the review is no longer at it, nothing is decided and the answer is a \`Conflict\`. A human wait is always at round 0. Omitted, the call is not fenced.","type":"integer","minimum":0,"maximum":9007199254740991},"remember":{"description":"Approving a tool approval: also allow its tool for the rest of this chat (\`Allow for the rest of this chat\`). Refused with \`Unprocessable\` for a human wait and for a \`deny\` or \`reject\`.","type":"boolean"},"decisionSurface":{"description":"A tool approval: where the person decided, \`chat\` or \`reviews\`, recorded with the decision as display provenance. It grants nothing and is not part of the decision’s identity: the first decision committed keeps its surface, or its absence, and a repeat of that decision from another surface changes neither. Omitted, the surface is unknown. Refused with \`Unprocessable\` for a human wait.","type":"string","enum":["chat","reviews"]}},"required":["id","decision"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":true}},{"name":"bureau.schedules.list","title":"List schedules","description":"Lists the caller’s own schedules, oldest first; a caller holding \`bureau.schedules:read\` lists every owner’s, including the native schedule of a workflow file, which belongs to the deployment’s owner. \`status\` narrows to one status. Pages with \`limit\` (1 to 100, default 50) and \`offset\`; \`nextOffset\` is \`null\` on the last page. A view carries the schedule’s \`revision\` and \`inputPreview\`, the start of the text each fire sends (at most 500 characters).","inputSchema":{"type":"object","properties":{"status":{"description":"Only the schedules in this status.","type":"string","enum":["active","paused","cancelled"]},"limit":{"description":"The most entries to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"offset":{"description":"How many entries to skip before the page starts. Defaults to 0.","type":"integer","minimum":0,"maximum":9007199254740991}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.schedules.get","title":"Read one schedule","description":"Returns one of the caller’s own schedules; a caller holding \`bureau.schedules:read\` reads any owner’s. Another owner’s schedule answers as a missing one does. The view carries the schedule’s \`revision\`, to pass back as \`expectedRevision\`, and \`inputPreview\`, the start of the text each fire sends (at most 500 characters).","inputSchema":{"type":"object","properties":{"scheduleId":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the schedule."}},"required":["scheduleId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.goals.list","title":"List goals","description":"Lists the caller’s own goals, oldest first, ended ones included; a caller holding \`bureau.goals:read\` lists every owner’s. \`status\` narrows to one status. Pages with \`limit\` (1 to 100, default 50) and \`offset\`; \`nextOffset\` is \`null\` on the last page. A view carries the goal’s \`revision\` and its attempts, and never its prompt or instructions.","inputSchema":{"type":"object","properties":{"status":{"description":"Only the goals in this status.","type":"string","enum":["pending","running","evaluating","retrying","succeeded","exhausted","failed","canceled"]},"limit":{"description":"The most entries to return in one page, from 1 to 100. Defaults to 50.","type":"integer","minimum":1,"maximum":100},"offset":{"description":"How many entries to skip before the page starts. Defaults to 0.","type":"integer","minimum":0,"maximum":9007199254740991}},"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}},{"name":"bureau.goals.get","title":"Read one goal","description":"Returns one of the caller’s own goals; a caller holding \`bureau.goals:read\` reads any owner’s. Another owner’s goal answers as a missing one does. The view carries the goal’s \`revision\`, to pass back as \`expectedRevision\`, its \`validator\`, and its attempts. For the goal’s owner, and no one else (\`bureau.goals:read\` and \`bureau.goals:content\` do not widen it), it also carries the goal’s \`prompt\`, each attempt’s validator \`feedback\`, which an edit form shows, and each attempt’s \`reason\`, why a passing attempt met its check when the validator said; every other caller reads the view without those three keys. It never carries the goal’s instructions.","inputSchema":{"type":"object","properties":{"goalRunId":{"type":"string","minLength":1,"maxLength":256,"description":"The identifier of the goal to read."}},"required":["goalRunId"],"additionalProperties":false},"annotations":{"readOnlyHint":false,"destructiveHint":false}}]},"jsonrpc":"2.0","id":"list"}

"
`;

exports[`pins Bureau’s MCP initialization, tool listing, and call responses: successful call 1`] = `
"event: message
data: {"result":{"content":[{"type":"text","text":"{\\"tasks\\":[],\\"nextPageToken\\":null}"}],"structuredContent":{"tasks":[],"nextPageToken":null}},"jsonrpc":"2.0","id":"call"}

"
`;

exports[`pins Bureau’s MCP initialization, tool listing, and call responses: refused call 1`] = `
"event: message
data: {"result":{"content":[{"type":"text","text":"{\\"code\\":\\"NotFound\\",\\"message\\":\\"No task with id \\\\\\"missing-task\\\\\\"\\",\\"data\\":{\\"resource\\":\\"task\\",\\"identifier\\":\\"missing-task\\"},\\"retryable\\":false}"}],"structuredContent":{"code":"NotFound","message":"No task with id \\"missing-task\\"","data":{"resource":"task","identifier":"missing-task"},"retryable":false},"isError":true},"jsonrpc":"2.0","id":"refused"}

"
`;
