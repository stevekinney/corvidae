{
  "name": "@lostgradient/bureau",
  "private": true,
  "description": "The agent fleet brain: createBureau, runtime composition, durability, recovery, and agent assembly",
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./skills": "./src/skills/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json && bun ../../scripts/check-documentation-coverage.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "typecheck": "tsc -b tsconfig.json && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --parallel=4 --path-ignore-patterns='**/*.slow.test.ts'",
    "test:slow": "bun ../../scripts/bun-test.ts .slow.test.ts",
    "test:a2ui-conformance": "bun ../../scripts/bun-test.ts src/a2ui/conformance.test.ts",
    "test:a2a-tck": "bun scripts/run-a2a-tck.ts"
  },
  "dependencies": {
    "@a2a-js/sdk": "catalog:",
    "@ag-ui/core": "catalog:",
    "@lostgradient/cryptography": "workspace:*",
    "@lostgradient/lifecycle": "workspace:*",
    "@lostgradient/memory": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/weft": "workspace:*",
    "ajv": "catalog:",
    "armorer": "workspace:*",
    "conversationalist": "workspace:*",
    "gray-matter": "catalog:",
    "js-yaml": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@ag-ui/client": "catalog:",
    "@modelcontextprotocol/client": "catalog:",
    "@lostgradient/typescript": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@types/bun": "catalog:",
    "@types/js-yaml": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
