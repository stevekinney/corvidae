  "checker": {
    "base": {
      "$type": "color",
      "$value": {
        "colorSpace": "srgb",
        "components": [1, 1, 1],
        "hex": "#ffffff"
      },
      "$description": "Transparency checkerboard base tile, shared by color-domain components. Light mode preserves the historical white/gray grid; dark mode keeps the pattern visible without flashing a white backing inside dark chrome.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-checker-base",
          "public": true,
          "category": "color",
          "cssRecipe": "light-dark(#fff, oklch(28% 0.02 245))"
