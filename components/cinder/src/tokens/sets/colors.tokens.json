      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.94064, 0.0288, 257.04]
      },
      "$description": "Soft accent-tinted background, mixed 88% toward the current surface.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-accent-background",
          "public": true,
          "category": "color",
          "cssRecipe": "color-mix(in oklch, var(--cinder-accent-solid), var(--cinder-surface) 88%)"
        }
      }
    },
    "border": {
      "$type": "color",
      "$value": {
        "colorSpace": "oklch",
        "components": [0.52, 0.24, 272],
        "alpha": 0.4
      },
      "$description": "Soft accent-tinted border, the accent color mixed 60% toward transparent.",
      "$extensions": {
        "com.lostgradient.cinder": {
          "cssProperty": "--cinder-accent-border",
          "public": true,
          "category": "color",
          "contrastPairs": ["accent.background"],
          "cssRecipe": "color-mix(in oklch, var(--cinder-accent-solid), transparent 60%)"
        }
      }
    }
