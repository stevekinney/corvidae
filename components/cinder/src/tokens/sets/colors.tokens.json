{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "color": {
    "$type": "color",
    "$description": "Status and role color triples (background/foreground/border) for soft tinted surfaces, plus muted/subtle derivatives. Used by components like Alert and Toast that need a soft tinted surface with semantically-paired text and border colors; the solid `accent.solid`/`status.danger.solid`/`status.info.solid`/`status.success.solid`/`status.warning.solid` tokens remain for accent fills such as solid badges."
  },
  "status": {
    "success": {
      "background": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.945, 0.075, 148]
        },
        "$description": "Soft success-tinted surface background.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-status-success-background",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark(oklch(94.5% 0.075 148), oklch(28% 0.07 145))",
            "palette": {
              "family": "success",
              "role": "background"
            }
          }
        }
      },
      "text": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.44, 0.128, 148]
        },
        "$description": "Foreground color on the soft success surface.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-status-success-text",
            "public": true,
            "category": "color",
            "cssRecipe": "light-dark(oklch(44% 0.128 148), oklch(88% 0.11 145))",
            "palette": {
              "family": "success",
              "role": "text"
            }
          }
        }
