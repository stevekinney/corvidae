            "public": true,
            "category": "color",
            "cssRecipe": "light-dark(oklch(80% 0.05 145), oklch(45% 0.09 145))",
            "palette": {
              "family": "success",
              "role": "border"
            }
          }
        }
      },
      "subtle": {
        "$type": "color",
        "$value": {
          "colorSpace": "oklch",
          "components": [0.456, 0.05, 151.329]
        },
        "$description": "Success color moved toward the current text color. Derived in one polarity-aware recipe shared by all four status colors.",
        "$extensions": {
          "com.lostgradient.cinder": {
            "cssProperty": "--cinder-status-success-subtle",
            "public": true,
            "category": "color",
            "cssRecipe": "oklch( from color-mix(in oklab, var(--cinder-status-success-solid), var(--cinder-text-default) 36%) l min(c, 0.05) h )"
