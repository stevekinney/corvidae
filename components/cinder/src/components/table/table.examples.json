{
  "$schema": "../../schemas/examples.schema.json",
  "component": "table",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Scrollable table",
      "description": "Hand-composed cells inside the public horizontal scroll wrapper for dense tables.",
      "code": "<script lang=\"ts\">\n  import { Table } from '@lostgradient/cinder';\n  const people = [\n    {\n      name: 'Ada Lovelace',\n      role: 'Mathematician and analytical engine collaborator',\n      commits: 142,\n    },\n    {\n      name: 'Grace Hopper',\n      role: 'Computer scientist, compiler builder, and systems educator',\n      commits: 98,\n    },\n    {\n      name: 'Alan Turing',\n      role: 'Cryptanalyst, logician, and theoretical computer scientist',\n      commits: 76,\n    },\n  ];\n</script>\n\n<Table caption=\"Recent contributors\" scrollable>\n  <Table.Header>\n    <Table.Row>\n      <Table.HeaderCell>Name</Table.HeaderCell>\n      <Table.HeaderCell>Role</Table.HeaderCell>\n      <Table.HeaderCell align=\"right\">Commits</Table.HeaderCell>\n    </Table.Row>\n  </Table.Header>\n  <Table.Body>\n    {#each people as person (person.name)}\n      <Table.Row>\n        <Table.Cell>{person.name}</Table.Cell>\n        <Table.Cell>{person.role}</Table.Cell>\n        <Table.Cell align=\"right\">{person.commits}</Table.Cell>\n      </Table.Row>\n    {/each}\n  </Table.Body>\n</Table>\n"
    },
    {
      "id": "empty",
      "title": "Empty table",
      "description": "A table with no body rows still renders the header and caption.",
      "code": "<script lang=\"ts\">\n  import { Table } from '@lostgradient/cinder';\n</script>\n\n<Table caption=\"Recent contributors (none yet)\">\n  <Table.Header>\n    <Table.Row>\n      <Table.HeaderCell>Name</Table.HeaderCell>\n      <Table.HeaderCell>Role</Table.HeaderCell>\n      <Table.HeaderCell align=\"right\">Commits</Table.HeaderCell>\n    </Table.Row>\n  </Table.Header>\n  <Table.Body>\n    <Table.Row>\n      <Table.Cell>\n        <span style=\"color: var(--cinder-text-muted); font-style: italic;\"\n          >No contributors yet — invite your team to get started.</span\n        >\n      </Table.Cell>\n      <Table.Cell>—</Table.Cell>\n      <Table.Cell align=\"right\">0</Table.Cell>\n    </Table.Row>\n  </Table.Body>\n</Table>\n"
    },
    {
      "id": "selection",
      "title": "Selectable rows",
      "description": "Table with a select-all checkbox in the header and per-row selection. One row is explicitly disabled from selection.",
      "code": "<script lang=\"ts\">\n  import { Table } from '@lostgradient/cinder';\n  const people = [\n    {\n      id: '1',\n      name: 'Ada Lovelace',\n      role: 'Mathematician',\n      commits: 142,\n      selectionDisabled: false,\n    },\n    {\n      id: '2',\n      name: 'Grace Hopper',\n      role: 'Computer Scientist',\n      commits: 98,\n      selectionDisabled: false,\n    },\n    { id: '3', name: 'Alan Turing', role: 'Cryptanalyst', commits: 76, selectionDisabled: true },\n  ];\n\n  let selectedIds = $state(new Set<string>());\n\n  const selectableRows = $derived(people.filter((p) => !p.selectionDisabled));\n  const allSelected = $derived(\n    selectableRows.length > 0 && selectableRows.every((p) => selectedIds.has(p.id)),\n  );\n  const someSelected = $derived(selectableRows.some((p) => selectedIds.has(p.id)));\n\n  function onSelectAll(next: boolean): void {\n    if (next) {\n      selectedIds = new Set(selectableRows.map((p) => p.id));\n    } else {\n      selectedIds = new Set();\n    }\n  }\n\n  function onRowChange(id: string, next: boolean): void {\n    const updated = new Set(selectedIds);\n    if (next) {\n      updated.add(id);\n    } else {\n      updated.delete(id);\n    }\n    selectedIds = updated;\n  }\n</script>\n\n<Table caption=\"Recent contributors\" selectable>\n  <Table.Header\n    {allSelected}\n    {someSelected}\n    {onSelectAll}\n    selectAllLabel=\"Select all selectable rows\"\n  >\n    <Table.Row>\n      <Table.HeaderCell>Name</Table.HeaderCell>\n      <Table.HeaderCell>Role</Table.HeaderCell>\n      <Table.HeaderCell align=\"right\">Commits</Table.HeaderCell>\n    </Table.Row>\n  </Table.Header>\n  <Table.Body>\n    {#each people as person (person.id)}\n      {#if person.selectionDisabled}\n        <Table.Row selectionDisabled={true}>\n          <Table.Cell>{person.name}</Table.Cell>\n          <Table.Cell>{person.role}</Table.Cell>\n          <Table.Cell align=\"right\">{person.commits}</Table.Cell>\n        </Table.Row>\n      {:else}\n        <Table.Row\n          selected={selectedIds.has(person.id)}\n          onSelectedChange={(next) => onRowChange(person.id, next)}\n          selectionLabel={`Select ${person.name}`}\n        >\n          <Table.Cell>{person.name}</Table.Cell>\n          <Table.Cell>{person.role}</Table.Cell>\n          <Table.Cell align=\"right\">{person.commits}</Table.Cell>\n        </Table.Row>\n      {/if}\n    {/each}\n  </Table.Body>\n</Table>\n\n{#if selectedIds.size > 0}\n  <p style=\"margin-top: 0.75rem; font-size: 0.875rem; color: var(--cinder-text-muted)\">\n    {selectedIds.size} row{selectedIds.size !== 1 ? 's' : ''} selected\n  </p>\n{/if}\n"
    },
    {
      "id": "sticky-sortable",
      "title": "Sticky sortable header",
      "description": "Sortable columns with stickyHeader={true}. Scroll the table body to verify the focus ring on the sort button is not clipped by the sticky thead.",
      "code": "<script lang=\"ts\">\n  import { Table } from '@lostgradient/cinder';\n  import type { TableSort } from '@lostgradient/cinder';\n  let sort: TableSort | undefined = $state(undefined);\n\n  const people = [\n    { name: 'Ada Lovelace', role: 'Mathematician', commits: 142 },\n    { name: 'Grace Hopper', role: 'Computer Scientist', commits: 98 },\n    { name: 'Alan Turing', role: 'Cryptanalyst', commits: 76 },\n    { name: 'Linus Torvalds', role: 'Engineer', commits: 512 },\n    { name: 'Margaret Hamilton', role: 'Software Engineer', commits: 304 },\n    { name: 'Dennis Ritchie', role: 'Language Designer', commits: 231 },\n    { name: 'Ken Thompson', role: 'Systems Programmer', commits: 189 },\n    { name: 'John Backus', role: 'Compiler Pioneer', commits: 67 },\n  ];\n\n  const sorted = $derived.by(() => {\n    if (!sort) return people;\n    return [...people].sort((a, b) => {\n      const key = sort!.column as keyof (typeof people)[0];\n      const aVal = a[key];\n      const bVal = b[key];\n      const cmp =\n        typeof aVal === 'number' && typeof bVal === 'number'\n          ? aVal - bVal\n          : String(aVal).localeCompare(String(bVal));\n      return sort!.direction === 'ascending' ? cmp : -cmp;\n    });\n  });\n</script>\n\n<div\n  style=\"max-height: 250px; overflow-y: auto; border: 1px solid var(--cinder-border-muted); border-radius: var(--cinder-radius-md);\"\n>\n  <Table caption=\"Contributors\" stickyHeader bind:sort>\n    <Table.Header>\n      <Table.Row>\n        <Table.HeaderCell column=\"name\" sortable>Name</Table.HeaderCell>\n        <Table.HeaderCell column=\"role\" sortable>Role</Table.HeaderCell>\n        <Table.HeaderCell column=\"commits\" sortable align=\"right\">Commits</Table.HeaderCell>\n      </Table.Row>\n    </Table.Header>\n    <Table.Body>\n      {#each sorted as person (person.name)}\n        <Table.Row>\n          <Table.Cell>{person.name}</Table.Cell>\n          <Table.Cell>{person.role}</Table.Cell>\n          <Table.Cell align=\"right\">{person.commits}</Table.Cell>\n        </Table.Row>\n      {/each}\n    </Table.Body>\n  </Table>\n</div>\n"
    },
    {
      "id": "tool-access",
      "title": "Table with controls",
      "description": "A table whose cells hold a checkbox and a select. It never scrolls: below 640px of its own width each row becomes a card with the name and its risk on top and the controls at 44px beneath. Asks is disabled while a tool is off.",
      "code": "<script lang=\"ts\">\n  import { Checkbox, Select, Table } from '@lostgradient/cinder';\n\n  type Tool = {\n    id: string;\n    name: string;\n    identifier: string;\n    description: string;\n    risk: string;\n    on: boolean;\n    asks: 'never' | 'changes' | 'always';\n  };\n\n  let tools = $state<Tool[]>([\n    {\n      id: 'lookup',\n      name: 'Lookup order',\n      identifier: 'lookup-order',\n      risk: 'Reads',\n      description: 'Looks an order up by its number.',\n      on: true,\n      asks: 'never',\n    },\n    {\n      id: 'refund',\n      name: 'Issue refund',\n      identifier: 'issue-refund',\n      risk: 'Dangerous',\n      description: 'Refunds a payment to the customer.',\n      on: true,\n      asks: 'always',\n    },\n    {\n      id: 'workflow',\n      name: 'Create workflow',\n      identifier: 'create-workflow',\n      risk: 'Changes things',\n      description: 'Creates a workflow from a description.',\n      on: false,\n      asks: 'changes',\n    },\n  ]);\n\n  const options = [\n    { value: 'never', label: 'Never' },\n    { value: 'changes', label: 'On changes' },\n    { value: 'always', label: 'Always' },\n  ];\n</script>\n\n<Table caption=\"Tool access\">\n  <Table.Header>\n    <Table.Row>\n      <Table.HeaderCell>On</Table.HeaderCell>\n      <Table.HeaderCell>Tool</Table.HeaderCell>\n      <Table.HeaderCell>Risk</Table.HeaderCell>\n      <Table.HeaderCell>Default asks</Table.HeaderCell>\n    </Table.Row>\n  </Table.Header>\n  <Table.Body>\n    {#each tools as tool (tool.id)}\n      <Table.Row>\n        <Table.Cell controls=\"fit\">\n          <Checkbox bind:checked={tool.on} aria-label={`Allow ${tool.name}`} />\n        </Table.Cell>\n        <Table.Cell as=\"th\">\n          <strong>{tool.name}</strong> <code>{tool.identifier}</code>\n          <span class=\"muted\">{tool.description}</span>\n        </Table.Cell>\n        <Table.Cell><span class=\"muted\">{tool.risk}</span></Table.Cell>\n        <Table.Cell controls>\n          <Select\n            id={`asks-${tool.id}`}\n            label={`${tool.name} asks`}\n            labelVisible={false}\n            bind:value={tool.asks}\n            {options}\n            disabled={!tool.on}\n          />\n        </Table.Cell>\n      </Table.Row>\n    {/each}\n  </Table.Body>\n</Table>\n\n<style>\n  .muted {\n    color: var(--cinder-text-muted);\n  }\n\n  .muted:not(:only-child) {\n    display: block;\n    font-size: var(--cinder-text-sm);\n  }\n</style>\n"
    }
  ]
}
