{
  "$schema": "../../schemas/examples.schema.json",
  "component": "list-detail",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "chats",
      "title": "Chats with a header, row menus, and keyboard selection",
      "description": "The list header carries the title and the create action on one row and the filter below. Row menus stay visible, J and K move the cursor, Enter opens, the open chat is kept in the URL, and the divider width is remembered.",
      "code": "<script lang=\"ts\">\n  import { Button, Dropdown, ListDetail, SearchField, SelectableRow } from '@lostgradient/cinder';\n\n  type Chat = { id: string; title: string; summary: string };\n\n  const chats: Chat[] = [\n    { id: 'onboarding', title: 'Customer onboarding', summary: 'Walk through the first-run checklist.' },\n    { id: 'billing', title: 'Billing question', summary: 'Why the March invoice doubled.' },\n    { id: 'release', title: 'Release notes', summary: 'Draft the notes for the next release.' },\n  ];\n\n  let filter = $state('');\n  const visible = $derived(\n    chats.filter((chat) => chat.title.toLowerCase().includes(filter.trim().toLowerCase())),\n  );\n  let renamed = $state('');\n</script>\n\n<div class=\"chats\">\n  <ListDetail\n    items={visible}\n    key={(chat) => chat.id}\n    label=\"Chats\"\n    selectionParameter=\"chat\"\n    storageKey=\"cinder-list-detail-example\"\n  >\n    {#snippet header()}\n      <div class=\"chats-title-row\">\n        <h2 class=\"chats-title\">Chats <span class=\"chats-count\">{visible.length}</span></h2>\n        <Button size=\"sm\" variant=\"primary\">New chat</Button>\n      </div>\n      <SearchField aria-label=\"Filter chats\" placeholder=\"Filter chats\" bind:value={filter} />\n    {/snippet}\n    {#snippet list(chat, row)}\n      <SelectableRow selected={row.selected} selectedState=\"current\" onclick={row.open}>\n        {#snippet title()}{chat.title}{/snippet}\n        {#snippet description()}{chat.summary}{/snippet}\n        {#snippet trailingActions()}\n          <Dropdown id={`chat-actions-${chat.id}`}>\n            <Dropdown.Trigger aria-label={`Actions for ${chat.title}`} caretVisible={false}>\n              <span aria-hidden=\"true\">⋯</span>\n            </Dropdown.Trigger>\n            <Dropdown.Menu>\n              <Dropdown.Item onclick={() => (renamed = chat.title)}>Rename</Dropdown.Item>\n              <Dropdown.Item variant=\"danger\">Delete</Dropdown.Item>\n            </Dropdown.Menu>\n          </Dropdown>\n        {/snippet}\n      </SelectableRow>\n    {/snippet}\n    {#snippet listEmpty()}No chats match the filter.{/snippet}\n    {#snippet detail(chat)}\n      <article class=\"chats-detail\">\n        <h3>{chat.title}</h3>\n        <p>{chat.summary}</p>\n        {#if renamed === chat.title}<p>Rename requested.</p>{/if}\n      </article>\n    {/snippet}\n  </ListDetail>\n</div>\n\n<style>\n  .chats {\n    block-size: 24rem;\n    border: 1px solid var(--cinder-border-muted);\n    border-radius: var(--cinder-radius-md);\n    overflow: hidden;\n  }\n\n  .chats-title-row {\n    display: flex;\n    align-items: center;\n    justify-content: space-between;\n    gap: var(--cinder-space-3);\n  }\n\n  .chats-title {\n    margin: 0;\n    font-size: var(--cinder-text-base);\n  }\n\n  .chats-count {\n    color: var(--cinder-text-muted);\n    font-weight: var(--cinder-font-normal);\n  }\n\n  .chats-detail {\n    padding: var(--cinder-space-4);\n  }\n</style>\n"
    },
    {
      "id": "tools",
      "title": "Grouped tools with a filter",
      "description": "A filter field and a count at the top of the list, rows grouped by source under their own headers, and the first tool open. While the tools load, five placeholder rows and a detail block appear after 300 ms.",
      "code": "<script lang=\"ts\">\n  import { ListDetail, SearchField, SelectableRow, Toggle } from '@lostgradient/cinder';\n\n  type Tool = { id: string; name: string; source: string; summary: string };\n\n  const tools: Tool[] = [\n    {\n      id: 'discover-agents',\n      name: 'Discover agents',\n      source: 'Built in',\n      summary: 'Finds agents by name or description.',\n    },\n    {\n      id: 'schedule-wakeup',\n      name: 'Schedule wakeup',\n      source: 'Built in',\n      summary: 'Lets an agent continue later.',\n    },\n    {\n      id: 'list-issues',\n      name: 'List issues',\n      source: 'GitHub',\n      summary: 'Lists issues in a repository.',\n    },\n    {\n      id: 'create-issue',\n      name: 'Create issue',\n      source: 'GitHub',\n      summary: 'Opens an issue in a repository.',\n    },\n  ];\n\n  let filter = $state('');\n  let loading = $state(false);\n  const visible = $derived(\n    tools.filter((tool) => tool.name.toLowerCase().includes(filter.trim().toLowerCase())),\n  );\n</script>\n\n<Toggle id=\"tools-loading\" bind:checked={loading} label=\"Loading\" />\n\n<div class=\"tools\">\n  <ListDetail\n    items={visible}\n    key={(tool) => tool.id}\n    label=\"Tools\"\n    selectedKey=\"discover-agents\"\n    selectionParameter={null}\n    {loading}\n    loadingLabel=\"Loading tools\"\n    groupBy={(tool) => ({ key: tool.source, label: tool.source })}\n  >\n    {#snippet header()}\n      <div class=\"filter-row\">\n        <SearchField aria-label=\"Filter tools\" placeholder=\"Filter tools\" bind:value={filter} />\n        <span class=\"count\">{visible.length} tools</span>\n      </div>\n    {/snippet}\n    {#snippet list(tool, row)}\n      <SelectableRow selected={row.selected} selectedState=\"current\" onclick={row.open}>\n        {#snippet title()}{tool.name}{/snippet}\n      </SelectableRow>\n    {/snippet}\n    {#snippet listEmpty()}No tools match the filter.{/snippet}\n    {#snippet detail(tool)}\n      <h3>{tool.name}</h3>\n      <p>{tool.summary}</p>\n    {/snippet}\n  </ListDetail>\n</div>\n\n<style>\n  .tools {\n    block-size: 22rem;\n    border: 1px solid var(--cinder-border-muted);\n    border-radius: var(--cinder-radius-md);\n    overflow: hidden;\n  }\n\n  .filter-row {\n    display: flex;\n    align-items: center;\n    gap: var(--cinder-space-3);\n  }\n\n  .count {\n    color: var(--cinder-text-muted);\n    font-size: var(--cinder-text-sm);\n    white-space: nowrap;\n  }\n</style>\n"
    }
  ]
}
