{
  "$schema": "../../schemas/examples.schema.json",
  "component": "pagination",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Basic pagination",
      "description": "Navigate through pages with previous/next and numbered buttons.",
      "code": "<script lang=\"ts\">\n  import { Pagination } from '@lostgradient/cinder';\n  let currentPage = $state(1);\n</script>\n\n<Pagination bind:currentPage totalPages={10} />\n<p style=\"margin-top: 0.5rem; color: var(--cinder-text-muted);\">Page {currentPage} of 10</p>\n"
    },
    {
      "id": "cursor",
      "title": "Cursor pagination",
      "description": "Callback mode: the caller keeps the cursors and Pagination reports when the user asks for the previous or next page, without changing currentPage.",
      "code": "<script lang=\"ts\">\n  import { Pagination } from '@lostgradient/cinder';\n\n  type CursorPage = {\n    previousCursor?: string;\n    nextCursor?: string;\n  };\n\n  const pagesByCursor: Record<string, CursorPage> = {\n    'cursor-page-1': { nextCursor: 'cursor-page-2' },\n    'cursor-page-2': { previousCursor: 'cursor-page-1', nextCursor: 'cursor-page-3' },\n    'cursor-page-3': { previousCursor: 'cursor-page-2' },\n  };\n\n  let cursor = $state('cursor-page-1');\n\n  const current = $derived(pagesByCursor[cursor] ?? {});\n\n  function goPrevious(): void {\n    if (current.previousCursor !== undefined) cursor = current.previousCursor;\n  }\n\n  function goNext(): void {\n    if (current.nextCursor !== undefined) cursor = current.nextCursor;\n  }\n</script>\n\n<Pagination\n  currentPage={1}\n  hasPreviousPage={current.previousCursor !== undefined}\n  hasNextPage={current.nextCursor !== undefined}\n  onPrevious={goPrevious}\n  onNext={goNext}\n/>\n<p style=\"margin-top: 0.5rem; color: var(--cinder-text-muted);\">\n  Cursor: {cursor}\n</p>\n"
    },
    {
      "id": "rest-link-header",
      "title": "REST Link-header pagination",
      "description": "Drive previous and next buttons from parsed REST Link headers without a total page count.",
      "code": "<script lang=\"ts\">\n  import { Pagination } from '@lostgradient/cinder';\n\n  let currentPage = $state(1);\n\n  const linkHeaders: Record<number, string> = {\n    1: '<https://api.example.test/issues?page=2>; rel=\"next\"',\n    2: '<https://api.example.test/issues?page=1>; rel=\"prev\", <https://api.example.test/issues?page=3>; rel=\"next\"',\n    3: '<https://api.example.test/issues?page=2>; rel=\"prev\"',\n  };\n\n  const links = $derived(parseLinkHeader(linkHeaders[currentPage] ?? ''));\n\n  function parseLinkHeader(header: string): Record<string, string> {\n    return Object.fromEntries(\n      header\n        .split(',')\n        .map((entry) => entry.match(/<([^>]+)>;\\s*rel=\"([^\"]+)\"/))\n        .filter((match): match is RegExpMatchArray => match !== null)\n        .map((match) => [match[2], match[1]]),\n    );\n  }\n</script>\n\n<Pagination\n  bind:currentPage\n  hasPreviousPage={links['prev'] !== undefined}\n  hasNextPage={links['next'] !== undefined}\n/>\n<p style=\"margin-top: 0.5rem; color: var(--cinder-text-muted);\">\n  Page {currentPage}\n</p>\n"
    },
    {
      "id": "with-total",
      "title": "Pagination with total count",
      "description": "totalCount prop shows formatted record count.",
      "code": "<script lang=\"ts\">\n  import { Pagination } from '@lostgradient/cinder';\n  let currentPage = $state(3);\n</script>\n\n<Pagination bind:currentPage totalPages={20} totalCount={384} />\n"
    }
  ]
}
