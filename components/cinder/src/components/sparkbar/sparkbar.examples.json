{
  "$schema": "../../schemas/examples.schema.json",
  "component": "sparkbar",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Basic sparkbars",
      "description": "Compact bounded meters for inline spend and usage rows.",
      "code": "<script lang=\"ts\">\n  import { Sparkbar } from '@lostgradient/cinder';\n</script>\n\n<div style=\"display: grid; gap: 0.75rem; max-width: 28rem;\">\n  <Sparkbar value={0.31} label=\"Draft weekly changelog\" trailing=\"$0.31\" />\n  <Sparkbar value={0.64} label=\"Summarize review comments\" trailing=\"$0.64\" variant=\"success\" />\n  <Sparkbar value={0.88} label=\"Refresh screenshot gallery\" trailing=\"$0.88\" variant=\"warning\" />\n</div>\n"
    },
    {
      "id": "custom-range",
      "title": "Custom range",
      "description": "Use a max value when the measurement is not fractional.",
      "code": "<script lang=\"ts\">\n  import { Sparkbar } from '@lostgradient/cinder';\n</script>\n\n<div style=\"display: grid; gap: 0.75rem; max-width: 28rem;\">\n  <Sparkbar value={4200} max={8000} label=\"Prompt tokens\" trailing=\"4.2k / 8k\" />\n  <Sparkbar value={7100} max={8000} label=\"Completion tokens\" trailing=\"7.1k / 8k\" size=\"lg\" />\n</div>\n"
    },
    {
      "id": "line",
      "title": "Trend line",
      "description": "Pass points to draw the shape of a metric over a window: a thin line over a baseline, a dot on the latest value, and a label at each end. The label is the accessible name and is not drawn.",
      "code": "<script lang=\"ts\">\n  import { Sparkbar } from '@lostgradient/cinder';\n</script>\n\n<div style=\"max-width: 22rem;\">\n  <Sparkbar\n    points={[1.4, 1.42, 1.45, 1.49, 1.53, 1.57, 1.6, 1.62]}\n    label=\"Storage use over the last 24 hours, rising to 1.6 GB\"\n    startLabel=\"1.4 GB · 24 hours ago\"\n    endLabel=\"Now\"\n  />\n</div>\n"
    }
  ]
}
