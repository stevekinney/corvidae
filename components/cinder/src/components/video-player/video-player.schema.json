{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "src": {
      "type": "string",
      "description": "Media source. Only `https:`, `http:`, and `blob:` URLs load; any other scheme renders the unavailable state."
    },
    "label": {
      "type": "string",
      "description": "Accessible name for the player."
    },
    "poster": {
      "type": "string",
      "description": "Image shown before playback starts."
    },
    "class": {
      "type": "string",
      "description": "Additional class names merged with `.cinder-video-player`."
    }
  },
  "additionalProperties": false,
  "required": ["label", "src"]
}
