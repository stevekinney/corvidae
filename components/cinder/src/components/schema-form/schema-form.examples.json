{
  "$schema": "../../../../../internal/component-tooling/src/schemas/examples.schema.json",
  "component": "schema-form",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "json-schema",
      "title": "JSON Schema",
      "description": "Render and submit a payload from a JSON Schema object.",
      "code": "<script lang=\"ts\">\n  import { SchemaForm } from '@lostgradient/cinder';\n\n  const schema = {\n    type: 'object',\n    title: 'Schedule',\n    properties: {\n      name: { type: 'string', title: 'Name', minLength: 1 },\n      retries: { type: 'integer', title: 'Retries', minimum: 0 },\n      enabled: { type: 'boolean', title: 'Enabled' },\n      cadence: { type: 'string', title: 'Cadence', enum: ['hourly', 'daily', 'weekly'] },\n    },\n    required: ['name', 'retries', 'enabled', 'cadence'],\n  };\n\n  let draft = $state('No edits yet.');\n  let submitted = $state('No payload submitted yet.');\n\n  function handleDraftChange(value: unknown) {\n    draft = JSON.stringify(value, null, 2);\n  }\n\n  function handleSubmit(value: unknown) {\n    submitted = JSON.stringify(value, null, 2);\n  }\n</script>\n\n<div style=\"display: grid; gap: 1rem;\">\n  <SchemaForm\n    {schema}\n    name=\"payload\"\n    value={{ name: 'Refresh indexes', retries: 2, enabled: true, cadence: 'daily' }}\n    submitLabel=\"Save schedule\"\n    onDraftChange={handleDraftChange}\n    onSubmit={handleSubmit}\n  />\n\n  <section>\n    <h3>Live draft</h3>\n    <pre>{draft}</pre>\n  </section>\n\n  <section>\n    <h3>Last valid submission</h3>\n    <pre>{submitted}</pre>\n  </section>\n</div>\n"
    },
    {
      "id": "setting-rows",
      "title": "Setting rows",
      "description": "Draw a plugin-style configuration schema as Settings rows, with the key beside each label.",
      "code": "<script lang=\"ts\">\n  import { SchemaForm } from '@lostgradient/cinder';\n\n  const schema = {\n    type: 'object',\n    properties: {\n      searchAddress: {\n        type: 'string',\n        title: 'Search address',\n        description: 'The service the search goes to.',\n      },\n      region: { type: 'string', enum: ['us', 'eu'], description: 'Where the work runs.' },\n      blockedSites: {\n        type: 'array',\n        items: { type: 'string' },\n        description: 'Sites that are never searched.',\n      },\n      includeSnippets: { type: 'boolean', description: 'Show an excerpt with each result.' },\n      cacheMs: { type: 'number', description: 'How long a result is kept.' },\n    },\n    required: ['searchAddress'],\n  };\n\n  let submitted = $state('Nothing saved yet.');\n\n  function handleSubmit(value: unknown) {\n    submitted = JSON.stringify(value, null, 2);\n  }\n</script>\n\n<div style=\"display: grid; gap: 1rem;\">\n  <SchemaForm\n    {schema}\n    variant=\"setting-rows\"\n    value={{ searchAddress: 'https://search.example', cacheMs: 300000 }}\n    submitLabel=\"Save configuration\"\n    onSubmit={handleSubmit}\n  />\n\n  <section>\n    <h3>Last saved</h3>\n    <pre>{submitted}</pre>\n  </section>\n</div>\n"
    }
  ]
}
