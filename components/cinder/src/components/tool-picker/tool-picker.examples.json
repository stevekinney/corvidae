{
  "$schema": "../../schemas/examples.schema.json",
  "component": "tool-picker",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Grouped tools and skills",
      "description": "Tools group by source with their risk and the level they start at on each row; skills are listed with no checkbox, because they follow the tools they use. Done keeps the choices, Cancel drops them.",
      "code": "<script lang=\"ts\">\n  import { Button, ToolPicker, type ToolPickerGroup, type ToolPickerItem } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let selected = $state<string[]>(['lookup-order', 'issue-refund', 'triage-refunds']);\n\n  const groups: ToolPickerGroup[] = [\n    { name: 'Built in' },\n    { name: 'GitHub' },\n    { name: 'Skills', note: 'they follow the tools they use' },\n  ];\n\n  const items: ToolPickerItem[] = [\n    {\n      value: 'discover-agents',\n      label: 'Discover agents',\n      code: 'bureau:discover-agents',\n      description: 'Finds other agents by name or description',\n      group: 'Built in',\n      meta: 'Reads',\n      detail: 'Never (default)',\n    },\n    {\n      value: 'ask-a-person',\n      label: 'Ask a person',\n      code: 'bureau:ask-a-person',\n      description: 'Asks you a question and waits',\n      group: 'Built in',\n      meta: 'Reads',\n      detail: 'Never (default)',\n    },\n    {\n      value: 'workflows-create',\n      label: 'Create workflow',\n      code: 'workflows-create',\n      description: 'Drafts a workflow from a description',\n      group: 'Built in',\n      meta: 'Changes things',\n      detail: 'On changes (default)',\n    },\n    {\n      value: 'lookup-order',\n      label: 'Lookup order',\n      code: 'lookup-order',\n      description: 'Looks an order up by its ID',\n      group: 'Built in',\n      meta: 'Reads',\n      detail: 'Never (default)',\n    },\n    {\n      value: 'issue-refund',\n      label: 'Issue refund',\n      code: 'issue-refund',\n      description: 'Refunds an order to the original card',\n      group: 'Built in',\n      meta: 'Dangerous',\n      detail: 'Always (default)',\n    },\n    {\n      value: 'triage-refunds',\n      label: 'Triage refunds',\n      code: 'triage-refunds',\n      description: 'Decides whether a refund request is allowed',\n      group: 'Built in',\n      meta: 'Changes things',\n      detail: 'On changes (default)',\n    },\n    {\n      value: 'list-issues',\n      label: 'List issues',\n      code: 'list_issues',\n      description: 'Lists issues in a GitHub repository',\n      group: 'GitHub',\n      meta: 'Reads',\n      detail: 'Never (default)',\n    },\n    {\n      value: 'create-issue',\n      label: 'Create issue',\n      code: 'create_issue',\n      description: 'Opens an issue in a GitHub repository',\n      group: 'GitHub',\n      meta: 'Changes things',\n      detail: 'On changes (default)',\n    },\n    {\n      value: 'delete-branch',\n      label: 'Delete branch',\n      code: 'delete_branch',\n      description: 'Deletes a branch from a GitHub repository',\n      group: 'GitHub',\n      meta: 'Dangerous',\n      detail: 'Always (default)',\n    },\n    {\n      value: 'release-notes',\n      label: 'Release notes',\n      code: 'release-notes',\n      suffix: 'Skill',\n      description: 'Drafts release notes from merged pull requests',\n      group: 'Skills',\n      detail: 'Follows its tools',\n      selectable: false,\n    },\n    {\n      value: 'writing-style',\n      label: 'Writing style',\n      code: 'writing-style',\n      suffix: 'Skill',\n      description: 'Keeps replies short and plain',\n      group: 'Skills',\n      detail: 'Follows its tools',\n      selectable: false,\n    },\n  ];\n\n  const labels = $derived(\n    items.filter((item) => selected.includes(item.value)).map((item) => item.label),\n  );\n</script>\n\n<Button variant=\"secondary\" onclick={() => (open = true)}>Add tools and skills</Button>\n<p>{labels.length === 0 ? 'No tools chosen.' : `Chosen: ${labels.join(', ')}.`}</p>\n\n<ToolPicker bind:open bind:selected {items} {groups} />\n"
    },
    {
      "id": "loading",
      "title": "Loading",
      "description": "While the list loads, the title and a live search field stay, and three skeleton rows appear after 300 ms so a quick load never flashes a placeholder. Done waits until the list is there.",
      "code": "<script lang=\"ts\">\n  import { Button, ToolPicker } from '@lostgradient/cinder';\n\n  let open = $state(false);\n</script>\n\n<Button variant=\"secondary\" onclick={() => (open = true)}>Add tools and skills</Button>\n\n<ToolPicker bind:open items={[]} loading />\n"
    },
    {
      "id": "many",
      "title": "Forty or more tools",
      "description": "From forty selectable items the counter reads the total, and every group but the first starts collapsed under its sticky header. The list scrolls inside the dialog, and searching opens every group that has a match.",
      "code": "<script lang=\"ts\">\n  import { Button, ToolPicker, type ToolPickerItem } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let selected = $state<string[]>([]);\n\n  const sources: [name: string, count: number][] = [\n    ['Built in', 6],\n    ['GitHub', 21],\n    ['Payments API', 15],\n  ];\n\n  const items: ToolPickerItem[] = sources.flatMap(([name, count]) =>\n    Array.from({ length: count }, (_, index) => ({\n      value: `${name}-${index + 1}`,\n      label: `${name} tool ${index + 1}`,\n      code: `${name.toLowerCase().replaceAll(' ', '-')}_${index + 1}`,\n      description: `Does one thing in ${name}`,\n      group: name,\n      meta: index % 5 === 0 ? 'Dangerous' : index % 2 === 0 ? 'Changes things' : 'Reads',\n      detail: index % 5 === 0 ? 'Always (default)' : 'On changes (default)',\n    })),\n  );\n</script>\n\n<Button variant=\"secondary\" onclick={() => (open = true)}>Add tools</Button>\n<p>{selected.length} chosen.</p>\n\n<ToolPicker bind:open bind:selected {items} />\n"
    }
  ]
}
