{
  "$schema": "../../schemas/examples.schema.json",
  "component": "confirm-dialog",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Confirm dialog",
      "description": "A destructive action gated behind an explicit confirm and cancel prompt.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n  import { ConfirmDialog } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let lastAction = $state('');\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;\">\n  <Button\n    label=\"Delete item\"\n    variant=\"danger\"\n    onclick={(event) => {\n      triggerRef = event.currentTarget as HTMLElement;\n      open = true;\n    }}\n  />\n\n  {#if lastAction}\n    <p style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\">\n      Last action: <strong>{lastAction}</strong>\n    </p>\n  {/if}\n</div>\n\n<ConfirmDialog\n  bind:open\n  {triggerRef}\n  title=\"Delete item?\"\n  description=\"This permanently removes the item. This action cannot be undone.\"\n  destructive\n  confirmLabel=\"Delete\"\n  onConfirm={() => (lastAction = 'confirmed')}\n  onCancel={() => (lastAction = 'cancelled')}\n/>\n"
    },
    {
      "id": "delete-account",
      "title": "Delete account",
      "description": "A destructive ConfirmDialog for permanent account and data deletion. Default focus lands on Cancel to guard against accidental confirmation.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n  import { ConfirmDialog } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let lastAction = $state('');\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;\">\n  <Button\n    label=\"Delete account\"\n    variant=\"danger\"\n    onclick={(event) => {\n      triggerRef = event.currentTarget as HTMLElement;\n      open = true;\n    }}\n  />\n\n  {#if lastAction}\n    <p style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\">\n      Last action: <strong>{lastAction}</strong>\n    </p>\n  {/if}\n</div>\n\n<ConfirmDialog\n  bind:open\n  {triggerRef}\n  title=\"Delete your account?\"\n  description=\"This will permanently delete your account and all associated data. This action cannot be undone.\"\n  destructive\n  confirmLabel=\"Delete account\"\n  onConfirm={() => (lastAction = 'account deleted')}\n  onCancel={() => (lastAction = 'cancelled')}\n/>\n"
    },
    {
      "id": "restart-now",
      "title": "Restart now: a glyph on the confirmation",
      "description": "A confirmation that is not destructive keeps the primary button, and confirmIcon draws a glyph before its label so the label and the glyph say what happens. The dialog names the effect on running work, and Cancel keeps the first focus.",
      "code": "<script lang=\"ts\">\n  import RotateCw from '@lucide/svelte/icons/rotate-cw';\n  import { Button, ConfirmDialog } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let restarted = $state(false);\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;\">\n  <Button\n    label=\"Restart now\"\n    variant=\"secondary\"\n    onclick={(event) => {\n      triggerRef = event.currentTarget as HTMLElement;\n      restarted = false;\n      open = true;\n    }}\n  />\n  {#if restarted}\n    <p style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\">\n      Restart requested.\n    </p>\n  {/if}\n</div>\n\n<ConfirmDialog\n  bind:open\n  {triggerRef}\n  title=\"Restart Interborough now?\"\n  description=\"Interborough stops and starts again to apply 1 change. Running work picks up where it stopped; reviews stay waiting.\"\n  confirmLabel=\"Restart now\"\n  onConfirm={() => (restarted = true)}\n>\n  {#snippet confirmIcon()}<RotateCw size={14} />{/snippet}\n</ConfirmDialog>\n"
    },
    {
      "id": "options",
      "title": "Options below the description",
      "description": "The description is a sentence and may carry monospace (a file path) as a snippet. options sits below it for a choice that changes what the confirmation does: here an unchecked checkbox that says what each choice does. The glyph on the confirmation is a trash can.",
      "code": "<script lang=\"ts\">\n  import Trash from '@lucide/svelte/icons/trash';\n  import { Button, Checkbox, ConfirmDialog } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let alsoDeleteSchedule = $state(false);\n  let result = $state('');\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;\">\n  <Button\n    label=\"Delete…\"\n    variant=\"secondary\"\n    onclick={(event) => {\n      triggerRef = event.currentTarget as HTMLElement;\n      alsoDeleteSchedule = false;\n      open = true;\n    }}\n  />\n  {#if result}\n    <p style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\">\n      {result}\n    </p>\n  {/if}\n</div>\n\n<ConfirmDialog\n  bind:open\n  {triggerRef}\n  title=\"Delete Triage inbox?\"\n  destructive\n  confirmLabel=\"Delete workflow\"\n  onConfirm={() =>\n    (result = alsoDeleteSchedule\n      ? 'Deleted the workflow and its schedule.'\n      : 'Deleted the workflow; the schedule stays paused.')}\n>\n  {#snippet description()}\n    The Inbox triage schedule (paused) runs this workflow. Its past runs stay on Runs. The file\n    <code>triage-inbox.json</code> is removed from <code>~/.interborough/workflows</code>.\n  {/snippet}\n  {#snippet options()}\n    <Checkbox\n      id=\"delete-workflow-schedule\"\n      label=\"Also delete the Inbox triage schedule\"\n      description=\"Checked, the schedule is deleted with it. Unchecked, the schedule stays paused and shows “Can’t find workflow”.\"\n      bind:checked={alsoDeleteSchedule}\n    />\n  {/snippet}\n  {#snippet confirmIcon()}<Trash size={14} />{/snippet}\n</ConfirmDialog>\n"
    },
    {
      "id": "in-flight-and-failed",
      "title": "In flight, then failed, then retried",
      "description": "closeOnConfirm={false} keeps the dialog open while the work runs. busy shows the busy label on an inert button and blocks every way out; a failure shows a danger callout between the body and the actions, keeps the typed identifier, and leaves Delete agent armed, so pressing it again is the retry. The first press fails; the second succeeds.",
      "code": "<script lang=\"ts\">\n  import { Button, ConfirmDialog } from '@lostgradient/cinder';\n\n  let open = $state(false);\n  let triggerRef: HTMLElement | null = $state(null);\n  let busy = $state(false);\n  let failed = $state(false);\n  let presses = $state(0);\n  let deleted = $state(false);\n  let timer: ReturnType<typeof setTimeout> | undefined;\n\n  function confirm() {\n    presses += 1;\n    busy = true;\n    failed = false;\n    clearTimeout(timer);\n    timer = setTimeout(() => {\n      busy = false;\n      if (presses === 1) {\n        failed = true;\n        return;\n      }\n      deleted = true;\n      open = false;\n    }, 1200);\n  }\n</script>\n\n<div style=\"display: flex; flex-direction: column; gap: 1rem; align-items: flex-start;\">\n  <Button\n    label=\"Delete Order checker\"\n    variant=\"secondary\"\n    onclick={(event) => {\n      triggerRef = event.currentTarget as HTMLElement;\n      presses = 0;\n      deleted = false;\n      failed = false;\n      open = true;\n    }}\n  />\n  {#if deleted}\n    <p style=\"margin: 0; color: var(--cinder-text-muted); font-size: var(--cinder-text-sm);\">\n      Deleted Order checker.\n    </p>\n  {/if}\n</div>\n\n<ConfirmDialog\n  bind:open\n  {triggerRef}\n  title=\"Delete Order checker?\"\n  description=\"Its 2 chats stay, read-only. Its versions and memories are deleted, and this can’t be undone. 1 workflow (Order refund) will stop finding it.\"\n  destructive\n  typeToConfirm=\"order-checker\"\n  typeToConfirmLabel=\"Type order-checker to confirm\"\n  confirmLabel=\"Delete agent\"\n  busyLabel=\"Deleting…\"\n  closeOnConfirm={false}\n  {busy}\n  error={failed ? 'Nothing was deleted.' : undefined}\n  errorTitle={failed ? 'Couldn’t delete the agent.' : undefined}\n  onConfirm={confirm}\n  onCancel={() => clearTimeout(timer)}\n/>\n"
    }
  ]
}
