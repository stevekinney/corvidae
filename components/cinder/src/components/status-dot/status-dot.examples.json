{
  "$schema": "../../schemas/examples.schema.json",
  "component": "status-dot",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "label-and-size",
      "title": "Status dot label and size",
      "description": "Visible label toggle and sm vs md sizes.",
      "code": "<script lang=\"ts\">\n  import { StatusDot } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-column\">\n  <div class=\"example-preview-row\">\n    <StatusDot status=\"online\" label=\"Online\" labelVisible={true} />\n    <StatusDot status=\"offline\" label=\"Offline\" labelVisible={true} />\n    <StatusDot status=\"pending\" label=\"Pending\" labelVisible={true} />\n  </div>\n  <div class=\"example-preview-row\" style=\"align-items: center;\">\n    <StatusDot status=\"online\" label=\"Small\" size=\"sm\" labelVisible={true} />\n    <StatusDot status=\"online\" label=\"Medium\" size=\"md\" labelVisible={true} />\n  </div>\n</div>\n"
    },
    {
      "id": "statuses",
      "title": "Status dot statuses",
      "description": "All eight semantic status values.",
      "code": "<script lang=\"ts\">\n  import { StatusDot } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <StatusDot status=\"online\" label=\"Online\" />\n  <StatusDot status=\"offline\" label=\"Offline\" />\n  <StatusDot status=\"warning\" label=\"Warning\" />\n  <StatusDot status=\"danger\" label=\"Danger\" />\n  <StatusDot status=\"pending\" label=\"Pending\" />\n  <StatusDot status=\"neutral\" label=\"Neutral\" />\n  <StatusDot status=\"success\" label=\"Success\" />\n  <StatusDot status=\"accent\" label=\"Accent\" />\n</div>\n"
    },
    {
      "id": "default-word",
      "title": "Status dot default word",
      "description": "With only a status, a StatusDot renders a word derived from it, so a status is never a dot alone.",
      "code": "<script lang=\"ts\">\n  import { StatusDot } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <StatusDot status=\"online\" />\n  <StatusDot status=\"warning\" />\n  <StatusDot status=\"danger\" />\n  <StatusDot status=\"pending\" label=\"Deploying\" />\n</div>\n"
    },
    {
      "id": "source-status",
      "title": "Source status lines",
      "description": "A connected source reads a green dot with a muted “Connected”; a source whose sign-in expired reads an amber dot with “Needs sign-in”, the reason and the same type chip. The word, not the colour, carries the meaning.",
      "code": "<script lang=\"ts\">\n  import { Chip, StatusDot } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-column\">\n  <div class=\"example-preview-row\">\n    <StatusDot word=\"Connected\" />\n    <span>Signed in as you, last tested 2 min ago</span>\n    <Chip label=\"MCP server\" />\n  </div>\n  <div class=\"example-preview-row\">\n    <StatusDot word=\"Needs sign-in\" />\n    <span>Your GitHub sign-in expired on Oct 31.</span>\n    <Chip label=\"MCP server\" />\n  </div>\n</div>\n"
    }
  ]
}
