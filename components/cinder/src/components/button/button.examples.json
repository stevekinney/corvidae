{
  "$schema": "../../schemas/examples.schema.json",
  "component": "button",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "as-link",
      "title": "Button as link",
      "description": "Passing href renders an anchor element with button styling.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button href=\"https://svelte.dev\" target=\"_blank\" rel=\"noopener noreferrer\" label=\"Svelte docs\" />\n  <Button href=\"#\" variant=\"ghost\" label=\"Internal link\" />\n</div>\n"
    },
    {
      "id": "shortcut",
      "title": "Button with a shortcut hint",
      "description": "The shortcut prop renders a decorative key hint after the label. It is plain glyphs in the button's own color on every variant, and touch devices hide it. The accessible name stays the label.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button variant=\"primary\" label=\"New task\" shortcut=\"N\" />\n  <Button variant=\"danger\" label=\"Delete\" shortcut={['Shift', 'D']} />\n  <Button label=\"Search\" shortcut={['Ctrl', 'K']} />\n  <Button variant=\"ghost\" label=\"Close\" shortcut=\"Esc\" />\n</div>\n"
    },
    {
      "id": "disabled",
      "title": "Disabled button",
      "description": "A plain (non-icon-only) disabled button. The secondary variant has no variant-specific disabled override, so its border color comes from the base disabled rule in button.css and its text takes `--cinder-text-disabled` with no opacity fade.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button\n    variant=\"secondary\"\n    disabled={true}\n    label=\"Disabled\"\n    data-testid=\"button-secondary-disabled\"\n  />\n</div>\n"
    },
    {
      "id": "icon-only",
      "title": "Icon-only buttons",
      "description": "Icon-only buttons keep the visual surface compact while still carrying an accessible name through label or aria-label.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-column\">\n  <div class=\"example-preview-row\">\n    <Button iconOnly={true} label=\"Close\" variant=\"ghost\" data-testid=\"button-ghost-icon-only-rest\">\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" />\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />\n        </svg>\n      {/snippet}\n    </Button>\n\n    <Button\n      iconOnly={true}\n      label=\"Delete\"\n      variant=\"ghost-danger\"\n      data-testid=\"button-ghost-danger-icon-only-rest\"\n    >\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <polyline points=\"3 6 5 6 21 6\" />\n          <path d=\"M19 6l-1 14H6L5 6\" />\n          <path d=\"M10 11v6\" />\n          <path d=\"M14 11v6\" />\n          <path d=\"M9 6V4h6v2\" />\n        </svg>\n      {/snippet}\n    </Button>\n\n    <Button iconOnly={true} label=\"Search\" variant=\"secondary\">\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <circle cx=\"11\" cy=\"11\" r=\"8\" />\n          <line x1=\"21\" y1=\"21\" x2=\"16.65\" y2=\"16.65\" />\n        </svg>\n      {/snippet}\n    </Button>\n  </div>\n\n  <div class=\"example-preview-row\">\n    <Button\n      disabled={true}\n      iconOnly={true}\n      label=\"Disabled close\"\n      variant=\"ghost\"\n      data-testid=\"button-ghost-icon-only-disabled\"\n    >\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" />\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />\n        </svg>\n      {/snippet}\n    </Button>\n\n    <Button\n      disabled={true}\n      iconOnly={true}\n      label=\"Disabled delete\"\n      variant=\"ghost-danger\"\n      data-testid=\"button-ghost-danger-icon-only-disabled\"\n    >\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <polyline points=\"3 6 5 6 21 6\" />\n          <path d=\"M19 6l-1 14H6L5 6\" />\n          <path d=\"M10 11v6\" />\n          <path d=\"M14 11v6\" />\n          <path d=\"M9 6V4h6v2\" />\n        </svg>\n      {/snippet}\n    </Button>\n\n    <Button\n      href=\"#disabled-close\"\n      aria-disabled=\"true\"\n      iconOnly={true}\n      label=\"Unavailable close link\"\n      variant=\"ghost\"\n      data-testid=\"button-ghost-icon-only-aria-disabled-link\"\n    >\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <line x1=\"18\" y1=\"6\" x2=\"6\" y2=\"18\" />\n          <line x1=\"6\" y1=\"6\" x2=\"18\" y2=\"18\" />\n        </svg>\n      {/snippet}\n    </Button>\n\n    <Button\n      href=\"#disabled-delete\"\n      aria-disabled=\"true\"\n      iconOnly={true}\n      label=\"Unavailable delete link\"\n      variant=\"ghost-danger\"\n      data-testid=\"button-ghost-danger-icon-only-aria-disabled-link\"\n    >\n      {#snippet leadingIcon()}\n        <svg\n          xmlns=\"http://www.w3.org/2000/svg\"\n          width=\"16\"\n          height=\"16\"\n          viewBox=\"0 0 24 24\"\n          fill=\"none\"\n          stroke=\"currentColor\"\n          stroke-width=\"2\"\n          stroke-linecap=\"round\"\n          stroke-linejoin=\"round\"\n          aria-hidden=\"true\"\n        >\n          <polyline points=\"3 6 5 6 21 6\" />\n          <path d=\"M19 6l-1 14H6L5 6\" />\n          <path d=\"M10 11v6\" />\n          <path d=\"M14 11v6\" />\n          <path d=\"M9 6V4h6v2\" />\n        </svg>\n      {/snippet}\n    </Button>\n  </div>\n</div>\n"
    },
    {
      "id": "loading",
      "title": "Loading state",
      "description": "A permanent loading button alongside one that toggles loading on click; both render the spinner and set aria-busy.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n  let loading = $state(false);\n\n  async function handleClick() {\n    loading = true;\n    await new Promise((resolve) => setTimeout(resolve, 2000));\n    loading = false;\n  }\n</script>\n\n<div class=\"example-preview-row\">\n  <Button variant=\"primary\" label=\"Saving...\" loading />\n  <Button variant=\"primary\" label=\"Save changes\" {loading} onclick={handleClick} />\n</div>\n"
    },
    {
      "id": "primary",
      "title": "Primary button",
      "description": "The one high-emphasis action in a region. Every other action takes the default filled soft face.",
      "featured": true,
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button variant=\"primary\" label=\"Save\" />\n  <Button label=\"Preview\" />\n</div>\n"
    },
    {
      "id": "sizes",
      "title": "Button sizes",
      "description": "xs, sm, md, and lg sizes, on the shared 24/28/32/40px control height scale. Use md for inline actions and keep lg for a page-level primary action.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button size=\"xs\" label=\"Extra Small\" />\n  <Button size=\"sm\" label=\"Small\" />\n  <Button size=\"md\" label=\"Medium\" />\n  <Button size=\"lg\" label=\"Large\" />\n</div>\n"
    },
    {
      "id": "soft",
      "title": "Soft variants",
      "description": "Soft and soft-danger use a tinted fill with no border — mid-emphasis between ghost and primary/danger.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button variant=\"soft\" label=\"Soft\" />\n  <Button variant=\"soft-danger\" label=\"Soft Danger\" />\n</div>\n"
    },
    {
      "id": "text-with-icons",
      "title": "Text + icon buttons",
      "description": "leadingIcon and trailingIcon snippets are decorative-only and wrap their SVGs in aria-hidden. Meaning still lives in the button label.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button variant=\"primary\" label=\"Save\">\n    {#snippet leadingIcon()}\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <path d=\"M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z\" />\n        <polyline points=\"17 21 17 13 7 13 7 21\" />\n        <polyline points=\"7 3 7 8 15 8\" />\n      </svg>\n    {/snippet}\n  </Button>\n\n  <Button variant=\"secondary\" label=\"Next\">\n    {#snippet trailingIcon()}\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <polyline points=\"9 18 15 12 9 6\" />\n      </svg>\n    {/snippet}\n  </Button>\n\n  <Button variant=\"ghost\" label=\"Share\" data-testid=\"button-ghost-text-share\">\n    {#snippet leadingIcon()}\n      <svg\n        xmlns=\"http://www.w3.org/2000/svg\"\n        width=\"14\"\n        height=\"14\"\n        viewBox=\"0 0 24 24\"\n        fill=\"none\"\n        stroke=\"currentColor\"\n        stroke-width=\"2\"\n        stroke-linecap=\"round\"\n        stroke-linejoin=\"round\"\n        aria-hidden=\"true\"\n      >\n        <circle cx=\"18\" cy=\"5\" r=\"3\" />\n        <circle cx=\"6\" cy=\"12\" r=\"3\" />\n        <circle cx=\"18\" cy=\"19\" r=\"3\" />\n        <line x1=\"8.59\" y1=\"13.51\" x2=\"15.42\" y2=\"17.49\" />\n        <line x1=\"15.41\" y1=\"6.51\" x2=\"8.59\" y2=\"10.49\" />\n      </svg>\n    {/snippet}\n  </Button>\n</div>\n"
    },
    {
      "id": "variants",
      "title": "Button variants",
      "description": "Primary, secondary, danger, and ghost styles.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-row\">\n  <Button variant=\"primary\" label=\"Primary\" />\n  <Button variant=\"secondary\" label=\"Secondary\" />\n  <Button variant=\"danger\" label=\"Danger\" />\n  <Button variant=\"ghost\" label=\"Ghost\" />\n</div>\n"
    },
    {
      "id": "loading-labels",
      "title": "Loading: label, width and spinner",
      "description": "Press \"Start\" to put every button in flight. When the label stays (Save), the width does not move; shorter words (Testing…) keep the width; longer words (Creating…) take the width they need so they never spill over the border. A page that dims the button while it works sets --cinder-button-loading-opacity (Connecting…).",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n\n  let inFlight = $state(false);\n</script>\n\n<div class=\"example-preview-column\">\n  <div class=\"example-preview-row\">\n    <Button\n      variant=\"secondary\"\n      data-testid=\"loading-toggle\"\n      label={inFlight ? 'Reset' : 'Start'}\n      onclick={() => (inFlight = !inFlight)}\n    />\n  </div>\n  <div class=\"example-preview-row\">\n    <Button variant=\"primary\" label=\"Save\" loading={inFlight} loadingStatus=\"Saving…\" />\n    <Button variant=\"primary\" size=\"sm\" label=\"Save\" loading={inFlight} loadingStatus=\"Saving…\" />\n  </div>\n  <div class=\"example-preview-row\">\n    <Button\n      variant=\"primary\"\n      label={inFlight ? 'Creating…' : 'Create'}\n      loading={inFlight}\n      loadingStatus=\"Creating…\"\n    />\n  </div>\n  <div class=\"example-preview-row\">\n    <Button\n      variant=\"secondary\"\n      label={inFlight ? 'Testing…' : 'Test connection'}\n      loading={inFlight}\n      loadingStatus=\"Testing…\"\n    />\n  </div>\n  <div class=\"example-preview-row\">\n    <Button\n      variant=\"primary\"\n      label={inFlight ? 'Connecting…' : 'Connect'}\n      loading={inFlight}\n      loadingStatus=\"Connecting…\"\n      style=\"--cinder-button-loading-opacity: 0.75\"\n    />\n  </div>\n</div>\n"
    },
    {
      "id": "long-labels",
      "title": "Long labels and the preview row",
      "description": "A label is a short verb phrase. A proposal the person should read sits beside the button, and a label too long for its container truncates with an ellipsis while the full words stay the accessible name.",
      "code": "<script lang=\"ts\">\n  import { Button } from '@lostgradient/cinder';\n</script>\n\n<div class=\"example-preview-column\">\n  <div style=\"display: flex; align-items: center; gap: 0.75rem; max-inline-size: 28rem\">\n    <p style=\"flex: 1; min-inline-size: 0; margin: 0\">\n      Move the weekly review to Friday afternoon at four\n    </p>\n    <Button variant=\"primary\" label=\"Apply\" />\n  </div>\n  <div style=\"inline-size: 10rem\">\n    <Button label=\"Move the weekly review to Friday afternoon at four\" />\n  </div>\n</div>\n"
    },
    {
      "id": "inert",
      "title": "Inert buttons with a reason",
      "description": "An aria-disabled button stays focusable, ignores the press and says why through aria-describedby and a tooltip. Icon-only inert buttons keep their accessible name; the live Export beside them still works.",
      "code": "<script lang=\"ts\">\n  import { Button, Tooltip } from '@lostgradient/cinder';\n  import Pencil from '@lucide/svelte/icons/pencil';\n  import Plus from '@lucide/svelte/icons/plus';\n  import Trash2 from '@lucide/svelte/icons/trash-2';\n\n  const uid = $props.id();\n  let presses = $state(0);\n</script>\n\n<div class=\"example-preview-column\">\n  <div class=\"example-preview-row\">\n    <Button label=\"New chat\" onclick={() => (presses += 1)} />\n    <Tooltip text=\"Connect a provider to start a chat\" describe={false}>\n      <Button\n        label=\"New chat\"\n        aria-disabled=\"true\"\n        aria-describedby={`${uid}-reason`}\n        onclick={() => (presses += 1)}\n      />\n    </Tooltip>\n    <span id={`${uid}-reason`} class=\"cinder-sr-only\">Connect a provider to start a chat</span>\n    <span>Presses reaching the page: {presses}</span>\n  </div>\n  <div class=\"example-preview-row\">\n    <Tooltip text=\"This agent’s plugin is disabled\" describe={false}>\n      <Button\n        iconOnly\n        variant=\"secondary\"\n        aria-label=\"Add a memory\"\n        aria-disabled=\"true\"\n        aria-describedby={`${uid}-memory-reason`}\n      >\n        {#snippet leadingIcon()}<Plus size={16} aria-hidden=\"true\" />{/snippet}\n      </Button>\n    </Tooltip>\n    <Tooltip text=\"This agent’s plugin is disabled\" describe={false}>\n      <Button\n        iconOnly\n        variant=\"ghost\"\n        aria-label=\"Edit memory\"\n        aria-disabled=\"true\"\n        aria-describedby={`${uid}-memory-reason`}\n      >\n        {#snippet leadingIcon()}<Pencil size={16} aria-hidden=\"true\" />{/snippet}\n      </Button>\n    </Tooltip>\n    <Tooltip text=\"This agent’s plugin is disabled\" describe={false}>\n      <Button\n        iconOnly\n        variant=\"ghost-danger\"\n        aria-label=\"Delete memory\"\n        aria-disabled=\"true\"\n        aria-describedby={`${uid}-memory-reason`}\n      >\n        {#snippet leadingIcon()}<Trash2 size={16} aria-hidden=\"true\" />{/snippet}\n      </Button>\n    </Tooltip>\n    <span id={`${uid}-memory-reason`} class=\"cinder-sr-only\">This agent’s plugin is disabled</span>\n    <Button label=\"Export\" />\n  </div>\n</div>\n"
    },
    {
      "id": "top-bar-icons",
      "title": "Top bar icon buttons",
      "description": "Notifications and quick settings as 32px icon-only buttons. They rest as the bare glyph (quiet). Each has an aria-label, the notifications label carries the unread count, and hover, focus and pressed are distinct; focus uses the shared quiet ring.",
      "code": "<script lang=\"ts\">\n  import { Badge, Button } from '@lostgradient/cinder';\n  import Bell from '@lucide/svelte/icons/bell';\n  import SlidersHorizontal from '@lucide/svelte/icons/sliders-horizontal';\n\n  const unread = 3;\n</script>\n\n<div class=\"example-preview-row\">\n  <span style=\"position: relative; display: inline-flex\">\n    <Button iconOnly quiet variant=\"ghost\" aria-label={`Notifications, ${unread} unread`}>\n      {#snippet leadingIcon()}<Bell size={16} aria-hidden=\"true\" />{/snippet}\n    </Button>\n    <span style=\"position: absolute; inset-block-start: -4px; inset-inline-end: -4px\">\n      <Badge variant=\"accent\" size=\"xs\">{unread}</Badge>\n    </span>\n  </span>\n  <Button iconOnly quiet variant=\"ghost\" aria-label=\"Quick settings\">\n    {#snippet leadingIcon()}<SlidersHorizontal size={16} aria-hidden=\"true\" />{/snippet}\n  </Button>\n</div>\n"
    }
  ]
}
