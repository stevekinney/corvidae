{
  "$schema": "../../schemas/examples.schema.json",
  "component": "stale-region",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Old data with inert writes",
      "description": "The server is unreachable, so the page keeps its data at full contrast under a warning banner. Only the button that changes something is inert (aria-disabled, still focusable, described by \"Off until it’s back\"); the link and Retry now stay live.",
      "code": "<script lang=\"ts\">\n  import { Banner, Button, Link, StaleRegion } from '@lostgradient/cinder';\n\n  let stale = $state(true);\n  const loadedAt = new Date(Date.now() - 120_000);\n</script>\n\n<StaleRegion {stale}>\n  {#if stale}\n    <Banner\n      preset=\"unreachable\"\n      dataUpdatedAt={loadedAt}\n      retryInSeconds={4}\n      attempt={3}\n      onRetry={() => (stale = false)}\n    />\n  {/if}\n  <div style=\"display: grid; gap: 0.75rem; margin-block-start: 0.75rem;\">\n    <div style=\"display: flex; align-items: center; justify-content: space-between;\">\n      <strong>Agents</strong>\n      <Button mutating iconOnly aria-label=\"New agent\">+</Button>\n    </div>\n    <div>\n      <Link href=\"#tool-runner\">Tool runner</Link>, Available\n    </div>\n    <div>\n      <Link href=\"#assistant\">Assistant</Link>, Available\n    </div>\n    <div>\n      <Button variant=\"ghost\" onclick={() => (stale = !stale)}>\n        {stale ? 'Pretend the server is back' : 'Pretend the server is gone'}\n      </Button>\n    </div>\n  </div>\n</StaleRegion>\n"
    },
    {
      "id": "controls",
      "title": "Every control that changes something",
      "description": "Button, Toggle, Checkbox and Select opt in with mutating. Under a stale region each one keeps focus, ignores the press and is described by the reason. The page words the reason, and the filter beside them, which only reads, stays live.",
      "code": "<script lang=\"ts\">\n  import { Button, Checkbox, Input, Select, StaleRegion, Toggle } from '@lostgradient/cinder';\n\n  let checked = $state(true);\n  let active = $state(true);\n  let filter = $state('');\n  let asks = $state<'never' | 'changes' | 'always'>('changes');\n</script>\n\n<StaleRegion reason=\"Off until storage answers.\">\n  <div style=\"display: grid; gap: 0.75rem; max-inline-size: 22rem;\">\n    <Input id=\"filter-keys\" label=\"Filter\" placeholder=\"Filter keys\" bind:value={filter} />\n    <Toggle id=\"active-switch\" label=\"Active\" bind:checked={active} mutating />\n    <Checkbox label=\"Tool is on\" bind:checked mutating />\n    <Select\n      id=\"default-asks\"\n      label=\"Default asks\"\n      mutating\n      bind:value={asks}\n      options={[\n        { value: 'never', label: 'Never' },\n        { value: 'changes', label: 'On changes' },\n        { value: 'always', label: 'Always' },\n      ]}\n    />\n    <div style=\"display: flex; gap: 0.5rem;\">\n      <Button mutating variant=\"primary\">Save value</Button>\n      <Button>Copy key</Button>\n    </div>\n  </div>\n</StaleRegion>\n"
    },
    {
      "id": "offline-page",
      "title": "An offline page with old data at full contrast",
      "description": "The offline banner sits over the page, the old data keeps full text contrast (no opacity), and only the controls marked mutating go inert: the header +, Edit and the approval card’s Approve and Deny. Reading, Export and links stay live.",
      "code": "<script lang=\"ts\">\n  import { ApprovalCard, Banner, Button, PageHeader, StaleRegion } from '@lostgradient/cinder';\n\n  const loadedAt = new Date(Date.now() - 120_000);\n  const card = {\n    tool: { name: 'Issue refund', risk: 'medium' as const },\n    sandbox: { provider: 'codex', name: 'workspace-write', workingDir: '/workspace' },\n    operation: {\n      kind: 'command' as const,\n      command: 'Runs with, 3 fields',\n      filesTouched: [],\n      argsPreview: {},\n    },\n    env: [],\n    snapshotId: 'snapshot-1',\n    policyVersion: 'policy-1',\n    idempotencyKey: 'key-1',\n    state: 'pending' as const,\n  };\n</script>\n\n<div class=\"example-preview-column\" style=\"gap: var(--cinder-space-3)\">\n  <Banner\n    preset=\"offline\"\n    dataUpdatedAt={loadedAt}\n    timeZone=\"America/Chicago\"\n    onRetry={() => {}}\n    consequence=\"Start run is off until you’re back.\"\n  />\n  <StaleRegion reason=\"Off until you’re back.\">\n    <div style=\"inline-size: 100%\">\n      <PageHeader\n        headingLevel={2}\n        title=\"Runs\"\n        description=\"Today, Monday, Nov 2\"\n        createAction={{ label: 'Start run' }}\n      >\n        {#snippet actions()}\n          <Button variant=\"secondary\" mutating label=\"Edit\" />\n          <Button variant=\"secondary\" label=\"Export\" />\n        {/snippet}\n      </PageHeader>\n      <ul\n        style=\"margin: 0; padding: 0; list-style: none; display: grid; gap: var(--cinder-space-2)\"\n      >\n        <li>Waiting on you, Refund order 4471, 10:42 AM</li>\n        <li>Done, Refund order 4472, 10:30 AM</li>\n        <li>Waiting on you, Ship the release notes fix, 9:46 AM</li>\n      </ul>\n      <ApprovalCard {...card} onResolve={() => {}} />\n    </div>\n  </StaleRegion>\n</div>\n"
    }
  ]
}
