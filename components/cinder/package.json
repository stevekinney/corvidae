{
  "name": "@lostgradient/cinder",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/src/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./panel": {
      "types": "./.types/src/panel/index.d.ts",
      "svelte": "./src/panel/index.ts",
      "default": "./src/panel/index.ts"
    },
    "./tokens/runtime": {
      "types": "./.types/src/exports/tokens-runtime.d.ts",
      "svelte": "./src/exports/tokens-runtime.ts",
      "default": "./src/exports/tokens-runtime.ts"
    }
  },
  "scripts": {
    "types": "bun ../../internal/component-tooling/scripts/emit-declarations.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts && bun run lint:checks && bun ../../scripts/check-inherited-key-reads.ts",
    "lint:checks": "bun run check:prop-conventions && bun run check:test-cleanup && bun ../../internal/component-tooling/scripts/check-aggregator-completeness.ts && bun ../../internal/component-tooling/scripts/check-component-css-raw-colors.ts --strict && bun ../../internal/component-tooling/scripts/check-component-examples.ts && bun ../../internal/component-tooling/scripts/check-component-inventory.ts && bun ../../internal/component-tooling/scripts/check-component-variable-registry.ts && bun ../../internal/component-tooling/scripts/check-css-duplication.ts && bun ../../internal/component-tooling/scripts/check-data-cinder-boolean-attributes.ts && bun ../../internal/component-tooling/scripts/check-design-token-literals.ts --strict && bun ../../internal/component-tooling/scripts/check-no-bare-console-warn.ts && bun ../../internal/component-tooling/scripts/check-no-inline-match-media.ts && bun ../../internal/component-tooling/scripts/check-no-static-style-attributes.ts && bun ../../internal/component-tooling/scripts/check-placeholder-docs.ts && bun ../../internal/component-tooling/scripts/check-platform-features.ts --strict && bun ../../internal/component-tooling/scripts/check-prose-component-references.ts && bun ../../internal/component-tooling/scripts/check-readme-usage.ts && bun ../../internal/component-tooling/scripts/check-svelte-ts-runtime-types.ts && bun ../../internal/component-tooling/scripts/check-token-naming.ts && bun ../../internal/component-tooling/scripts/check-token-registry-privacy.ts && bun ../../internal/component-tooling/scripts/check-virtual-list-dependency-free.ts",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.browser.json --fail-on-warnings && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts && bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --conditions browser --conditions svelte --parallel=4 --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' src scripts",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte .slow.test.ts .integration.test.ts",
    "test:memory-canary": "bun ../../internal/component-tooling/scripts/memory-canary.ts",
    "test:coverage": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test.ts --conditions browser --conditions svelte --parallel=4 --coverage --coverage-reporter=text --coverage-reporter=lcov --path-ignore-patterns='**/*.slow.test.ts' src scripts",
    "components:check": "bun ../../internal/component-tooling/scripts/generate-component-artifacts.ts --check",
    "a2ui-catalog:generate": "bun ../../internal/component-tooling/scripts/generate-a2ui-catalog.ts",
    "a2ui-catalog:check": "bun ../../internal/component-tooling/scripts/generate-a2ui-catalog.ts --check",
    "components:generate": "bun ../../internal/component-tooling/scripts/generate-component-artifacts.ts",
    "design-system:build": "bun scripts/design-system/build.ts",
    "design-system:url": "bun scripts/design-system/url.ts",
    "check:prop-conventions": "bun ../../internal/component-tooling/scripts/check-prop-conventions.ts src/components",
    "check:test-cleanup": "bun ../../internal/component-tooling/scripts/check-test-cleanup.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts"
  },
