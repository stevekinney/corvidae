{
  "$schema": "https://www.designtokens.org/schemas/2025.10/format.json",
  "$extensions": { "com.example.editor": { "untouched": true } },
  "stroke": {
    "$type": "strokeStyle",
    "$description": "The group carries the type; its members do not restate it.",
    "dashed": { "$value": "dashed", "$description": "Inherits strokeStyle." },
    "custom": {
      "$value": {
        "dashArray": [
          { "value": 2, "unit": "px" },
          { "value": 4, "unit": "px" }
        ],
        "lineCap": "round"
      }
    }
  }
}
