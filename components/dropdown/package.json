{
  "name": "@lostgradient/dropdown",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/src/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./styles": "./src/styles/index.css",
    "./*.css": "./src/components/*/*.css",
    "./components/*": "./src/components/*",
    "./test/fixtures/dropdown-item-polymorphic-fixture.svelte": "./src/test/fixtures/dropdown-item-polymorphic-fixture.svelte",
    "./test/fixtures/dropdown-item-radio-fixture.svelte": "./src/test/fixtures/dropdown-item-radio-fixture.svelte",
    "./test/fixtures/dropdown-roving-fixture.svelte": "./src/test/fixtures/dropdown-roving-fixture.svelte",
    "./test/fixtures/dropdown-trigger-no-caret-fixture.svelte": "./src/test/fixtures/dropdown-trigger-no-caret-fixture.svelte",
    "./test/fixtures/dropdown-trigger-onclick-fixture.svelte": "./src/test/fixtures/dropdown-trigger-onclick-fixture.svelte"
  },
  "scripts": {
    "types": "bun ../../internal/component-tooling/scripts/emit-declarations.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src browser && bun ../../scripts/check-inherited-key-reads.ts && bun ../../internal/component-tooling/scripts/check-prop-conventions.ts src/components",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.browser.json --fail-on-warnings && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --conditions browser --conditions svelte --parallel=4 --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' src",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte .slow.test.ts .integration.test.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src browser",
    "metadata": "bun ../../internal/component-tooling/scripts/generate-component-artifacts.ts --package-root .",
    "test:browser": "bun browser/harness.ts prepare && bun ../../scripts/host-slots.ts --slots=4 -- bun --bun playwright test --config browser/playwright.config.ts --project=chromium --workers=4"
  },
  "dependencies": {
    "@floating-ui/dom": "catalog:",
    "@lostgradient/button": "workspace:*",
    "@lostgradient/foundation": "workspace:*",
    "@lostgradient/portal": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/component-tooling": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
