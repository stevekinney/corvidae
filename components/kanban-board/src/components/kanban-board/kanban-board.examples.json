{
  "$schema": "../../../../../internal/component-tooling/src/schemas/examples.schema.json",
  "component": "kanban-board",
  "import": "@lostgradient/cinder",
  "examples": [
    {
      "id": "basic",
      "title": "Project board",
      "description": "Move work items between columns, reorder columns, and collapse quiet lanes. Each card shows its title, then its assignee and priority on one quiet row.",
      "code": "<script lang=\"ts\">\n  import { Avatar } from '@lostgradient/avatar';\n  import { Badge } from '@lostgradient/badge';\n  import { KanbanBoard, type KanbanBoardColumn } from '@lostgradient/kanban-board';\n\n  type WorkItem = {\n    id: string;\n    title: string;\n    assignee: string;\n    priority: 'Low' | 'Medium' | 'High';\n  };\n\n  let columns = $state<KanbanBoardColumn<WorkItem>[]>([\n    {\n      id: 'backlog',\n      title: 'Backlog',\n      cards: [\n        {\n          id: 'inventory-alerts',\n          title: 'Inventory alerts',\n          assignee: 'Mina Okafor',\n          priority: 'High',\n        },\n        {\n          id: 'weekly-report',\n          title: 'Weekly report export',\n          assignee: 'Dev Patel',\n          priority: 'Medium',\n        },\n      ],\n    },\n    {\n      id: 'active',\n      title: 'Active',\n      cards: [\n        {\n          id: 'shipment-map',\n          title: 'Shipment map filters',\n          assignee: 'Rae Lindqvist',\n          priority: 'High',\n        },\n        {\n          id: 'cycle-count',\n          title: 'Cycle count cleanup',\n          assignee: 'Alex Moreno',\n          priority: 'Low',\n        },\n      ],\n    },\n    {\n      id: 'done',\n      title: 'Done',\n      cards: [\n        {\n          id: 'store-pulse',\n          title: 'Store pulse summary',\n          assignee: 'Nia Brooks',\n          priority: 'Medium',\n        },\n      ],\n    },\n  ]);\n</script>\n\n<KanbanBoard\n  label=\"Project work board\"\n  {columns}\n  getCardKey={(item) => item.id}\n  getCardLabel={(item) => item.title}\n  collapsible\n  onColumnsChange={(nextColumns) => {\n    columns = nextColumns;\n  }}\n>\n  {#snippet cardMeta(item)}\n    <Avatar name={item.assignee} size=\"xs\" aria-hidden=\"true\" />\n    <span>{item.assignee}</span>\n  {/snippet}\n\n  {#snippet cardTrailing(item)}\n    <Badge\n      variant={item.priority === 'High'\n        ? 'danger'\n        : item.priority === 'Medium'\n          ? 'warning'\n          : 'success'}\n    >\n      {item.priority}\n    </Badge>\n  {/snippet}\n\n  {#snippet emptyColumn(column)}\n    Drop cards into {column.title}\n  {/snippet}\n</KanbanBoard>\n"
    }
  ]
}
