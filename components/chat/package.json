{
  "name": "@lostgradient/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/src/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./manifest": "./.metadata/components.json",
    "./*/schema": "./.metadata/*/schema.json",
    "./*/variables": "./.metadata/*/variables.json",
    "./*/examples": "./.metadata/*/examples.json"
  },
  "scripts": {
    "types": "bun ../../internal/component-tooling/scripts/emit-declarations.ts",
    "metadata": "bun ../../internal/component-tooling/scripts/generate-component-artifacts.ts --package-root .",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts browser && bun ../../scripts/check-inherited-key-reads.ts && bun ../../internal/component-tooling/scripts/check-prop-conventions.ts src/lib/components && bun ../../internal/component-tooling/scripts/generate-component-artifacts.ts --package-root . --check",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.browser.json --fail-on-warnings && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "release:check": "bun ../../scripts/check-documentation-coverage.ts && bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts' --conditions browser --conditions svelte --parallel=4 src browser/scripts",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte --parallel=1 .slow.test.ts .integration.test.ts",
    "test:coverage": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test.ts --conditions browser --conditions svelte --coverage --coverage-reporter=text --coverage-reporter=lcov src",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts browser",
    "test:browser": "bun browser/harness.ts prepare && bun ../../scripts/host-slots.ts --slots=4 -- bun --bun playwright test --config browser/playwright.config.ts --project=chromium --workers=4"
  },
  "dependencies": {
    "@ag-ui/core": "catalog:",
    "@lostgradient/cinder": "workspace:*",
    "@lostgradient/markdown": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "conversationalist": "workspace:*",
    "decode-named-character-reference": "catalog:",
    "micromark-util-decode-numeric-character-reference": "catalog:",
    "re2js": "catalog:",
    "svelte": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@floating-ui/dom": "catalog:",
    "@lostgradient/environmentalist": "catalog:",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@playwright/test": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "@types/pngjs": "catalog:",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "pngjs": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": [
    "./src/index.ts",
    "**/*.css",
    "src/lib/components/*/index.ts"
  ]
}
