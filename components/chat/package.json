{
  "name": "@lostgradient/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts && bun ../../scripts/check-documentation-coverage.ts",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.browser.json --fail-on-warnings && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --conditions browser --conditions svelte --parallel=4 src",
    "test:coverage": "TZ=UTC LANG=en_US.UTF-8 bun test --conditions browser --conditions svelte --coverage --coverage-reporter=lcov src && bun ../cinder/scripts/check-coverage-ratchet.ts --package-root .",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts"
  },
  "dependencies": {
    "@ag-ui/core": "catalog:",
    "conversationalist": "workspace:*",
    "decode-named-character-reference": "catalog:",
    "micromark-util-decode-numeric-character-reference": "catalog:",
    "zod": "catalog:",
    "@lostgradient/cinder": "workspace:*",
    "@lostgradient/markdown": "workspace:*",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@floating-ui/dom": "catalog:",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": [
    "./src/index.ts",
    "**/*.css",
    "src/lib/components/*/index.ts"
  ]
}
