{
  "name": "@lostgradient/chat",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/src/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "types": "bun ../cinder/scripts/emit-declarations.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts && bun ../../scripts/check-inherited-key-reads.ts && bun ../../scripts/check-documentation-coverage.ts",
    "typecheck": "svelte-check --workspace . --tsconfig ./tsconfig.browser.json --fail-on-warnings && svelte-check --workspace . --tsconfig ./tsconfig.json --fail-on-warnings && bun run typecheck:documentation",
    "typecheck:documentation": "bun ../../scripts/check-documentation-code-blocks.ts",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.integration.test.ts' --conditions browser --conditions svelte --parallel=4 src",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte --parallel=1 .slow.test.ts .integration.test.ts",
    "test:coverage": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test.ts --conditions browser --conditions svelte --coverage --coverage-reporter=lcov src && bun ../cinder/scripts/check-coverage-ratchet.ts --package-root .",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts"
  },
  "dependencies": {
    "@ag-ui/core": "catalog:",
    "@lostgradient/cinder": "workspace:*",
    "@lostgradient/markdown": "workspace:*",
    "@modelcontextprotocol/client": "catalog:",
    "@modelcontextprotocol/core": "catalog:",
    "@modelcontextprotocol/ext-apps": "catalog:",
    "conversationalist": "workspace:*",
    "decode-named-character-reference": "catalog:",
    "micromark-util-decode-numeric-character-reference": "catalog:",
    "re2js": "catalog:",
    "svelte": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@floating-ui/dom": "catalog:",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "ajv": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": [
    "./src/index.ts",
    "**/*.css",
    "src/lib/components/*/index.ts"
  ]
}
