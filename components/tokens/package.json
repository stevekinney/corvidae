{
  "name": "@lostgradient/tokens",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./.types/src/index.d.ts",
      "svelte": "./src/index.ts",
      "default": "./src/index.ts"
    },
    "./*.css": "./src/styles/*.css",
    "./*": "./src/*",
    "./scripts/*": "./scripts/*"
  },
  "scripts": {
    "types": "bun ../../internal/component-tooling/scripts/emit-declarations.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src scripts && bun ../../scripts/check-inherited-key-reads.ts && bun run tokens:check",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --conditions browser --conditions svelte --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' src scripts",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte .slow.test.ts .integration.test.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src scripts",
    "tokens:check": "bun scripts/tokens/validate-corpus.ts && bun scripts/tokens/generate-artifacts.ts --check",
    "tokens:generate": "bun scripts/tokens/generate-artifacts.ts"
  },
  "dependencies": {
    "ajv": "catalog:",
    "culori": "catalog:",
    "postcss-value-parser": "catalog:",
    "svelte": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/component-tooling": "workspace:*",
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@shikijs/themes": "catalog:",
    "@types/bun": "catalog:",
    "@types/culori": "catalog:",
    "ajv-formats": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "postcss": "catalog:",
    "prettier": "catalog:",
    "svelte-check": "catalog:",
    "typescript": "catalog:"
  },
  "sideEffects": [
    "**/*.css"
  ]
}
