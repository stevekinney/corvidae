{
  "name": "@lostgradient/evaluation",
  "private": true,
  "description": "Versioned evaluators for completed operative runs: typed rubrics, calibrated model judges, repeated trials, append-only history, local release-gate, replay, and promotion-signal commands, compute-matched collaboration comparison and admission evidence with a local comparison command, and the action-based memory-lifecycle evaluation suite.",
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "comparison": "bun scripts/comparison.ts",
    "history": "bun scripts/history.ts",
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json",
    "memory-lifecycle": "bun scripts/memory-lifecycle.ts",
    "promotion-signal": "bun scripts/promotion-signal.ts",
    "release-gate": "bun scripts/release-gate.ts",
    "replay": "bun scripts/replay.ts",
    "test": "bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.slow.test.ts'",
    "test:slow": "bun ../../scripts/bun-test-selected.ts .slow.test.ts",
    "test:coverage": "bun ../../scripts/bun-test.ts --path-ignore-patterns='**/*.slow.test.ts' --coverage --coverage-reporter=text --coverage-reporter=lcov",
    "typecheck": "tsc -b tsconfig.json"
  },
  "dependencies": {
    "@lostgradient/cryptography": "workspace:*",
    "@lostgradient/memory": "workspace:*",
    "@lostgradient/operative": "workspace:*",
    "@lostgradient/storage": "workspace:*",
    "@lostgradient/weft": "workspace:*",
    "armorer": "workspace:*",
    "conversationalist": "workspace:*",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "typescript": "catalog:"
  }
}
