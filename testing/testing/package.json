{
  "name": "@lostgradient/testing",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./browser/browser-ports": "./src/browser/browser-ports.ts",
    "./browser/build": "./src/browser/build.ts",
    "./browser/fixture-loader": "./src/browser/fixture-loader.ts",
    "./browser/fixture-port": "./src/browser/fixture-port.ts",
    "./browser/host": "./src/browser/host.ts",
    "./browser/manifest": "./src/browser/manifest.ts",
    "./browser/package-suite": "./src/browser/package-suite.ts",
    "./browser/playwright-configuration": "./src/browser/playwright-configuration.ts",
    "./browser/prepare-manifest": "./src/browser/prepare-manifest.ts",
    "./browser/server": "./src/browser/server.ts",
    "./browser-smoke-gate": "./src/browser-smoke-gate.ts",
    "./design-review-geometry": "./src/design-review-geometry.ts",
    "./design-review-geometry-probe": "./src/design-review-geometry-probe.ts",
    "./environment-configuration": "./src/environment-configuration.ts",
    "./exit-when-orphaned": "./src/exit-when-orphaned.ts",
    "./fake-timers": "./src/fake-timers.ts",
    "./hang-guard": "./src/hang-guard.ts",
    "./module-scope-scenario": "./src/module-scope-scenario.ts",
    "./playwright/component-page-fixture": "./src/playwright/component-page-fixture.ts",
    "./playwright/component-sweep": "./src/playwright/component-sweep.ts",
    "./playwright/editor-fixture": "./src/playwright/editor-fixture.ts",
    "./playwright/editors-complex-support": "./src/playwright/editors-complex-support.ts",
    "./playwright/overlay-fixture": "./src/playwright/overlay-fixture.ts",
    "./playwright/review-editor-browser-errors": "./src/playwright/review-editor-browser-errors.ts",
    "./postgres-server": "./src/postgres-server.ts",
    "./promise-outcome": "./src/helpers/promise-outcome.ts",
    "./real-timer-leak-guard": "./src/real-timer-leak-guard.ts",
    "./s3-server": "./src/s3-server.ts",
    "./temporary-path": "./src/temporary-path.ts",
    "./wait-until": "./src/wait-until.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' src",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts .slow.test.ts .integration.test.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src"
  },
  "dependencies": {
    "svelte": "catalog:",
    "zod": "catalog:",
    "typescript": "catalog:",
    "happy-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@playwright/test": "catalog:",
    "@axe-core/playwright": "catalog:",
    "postcss-value-parser": "catalog:",
    "@lostgradient/environmentalist": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "pngjs": "catalog:",
    "pixelmatch": "catalog:",
    "@types/pngjs": "catalog:"
  }
}
