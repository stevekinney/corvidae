  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src visual-baselines",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' src visual-baselines",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts .slow.test.ts .integration.test.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src visual-baselines",
    "baselines:update": "bun visual-baselines/update-snapshots.ts",
    "baselines:update:docker": "bun ../../scripts/host-slots.ts --slots=4 -- bun visual-baselines/update-snapshots-docker.ts",
    "baselines:visual:docker": "bun ../../scripts/host-slots.ts --slots=4 -- bun visual-baselines/run-browser-docker.ts"
  },
  "dependencies": {
    "svelte": "catalog:",
    "zod": "catalog:",
    "typescript": "catalog:",
    "happy-dom": "catalog:",
