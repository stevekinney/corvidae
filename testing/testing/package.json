{
  "name": "@lostgradient/testing",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./coverage-ratchet": "./src/coverage-ratchet/index.ts",
    "./browser-smoke-gate": "./src/browser-smoke-gate.ts",
    "./fake-timers": "./src/fake-timers.ts",
    "./hang-guard": "./src/hang-guard.ts",
    "./module-scope-scenario": "./src/module-scope-scenario.ts",
    "./promise-outcome": "./src/helpers/promise-outcome.ts",
    "./real-timer-leak-guard": "./src/real-timer-leak-guard.ts",
    "./temporary-path": "./src/temporary-path.ts",
    "./wait-until": "./src/wait-until.ts"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json src",
    "types": "tsc -b tsconfig.source.json",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --path-ignore-patterns='**/*.slow.test.ts' src",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts .slow.test.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json src"
  },
  "dependencies": {
    "svelte": "catalog:",
    "zod": "catalog:",
    "typescript": "catalog:",
    "happy-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@playwright/test": "catalog:",
    "@axe-core/playwright": "catalog:",
    "postcss-value-parser": "catalog:",
    "@lostgradient/environmentalist": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/typescript": "workspace:*",
    "@types/node": "catalog:",
    "@types/bun": "catalog:",
    "oxlint": "catalog:",
    "pngjs": "catalog:",
    "pixelmatch": "catalog:",
    "@types/pngjs": "catalog:"
  }
}
