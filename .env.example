NODE_ENV=development
PORT=3000

# Chat-room: leave the key unset to return 503 for provider-backed requests.
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# Unset or empty uses memory storage; :memory: uses ephemeral SQLite.
# CHAT_ROOM_SERVER_OWNED_DATABASE=./chat-room.sqlite

# Operative: explicit provider options take precedence over these values.
# GOOGLE_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1

# Weft: connection defaults to http://localhost:7233 without an override/profile.
# WEFT_ADDR=http://localhost:7233
# WEFT_TOKEN=
# WEFT_PROFILE=
# WEFT_HOME=
# WEFT_DEFAULT_STORAGE_PATH=
# WEFT_SERVER_AUTHENTICATION_REQUIRED=true
# These switches enable their override only for the exact value 1.
# WEFT_DEV_WARNINGS=1
# WEFT_STRICT_FAULTS=1
# WEFT_ALLOW_UNTRUSTED_API_CATALOG_ORIGIN=1

# Weft UI development host defaults.
# WEFT_UI_PORT=5173
# WEFT_API_BASE_URL=http://localhost:7233

# Browser fixture tooling; these do not expose server credentials to the browser.
# FIXTURE_HOST_MODE=preview
# BROWSER_FIXTURE_URL=http://127.0.0.1:5577
# BROWSER_FIXTURE_MANIFEST=
# CINDER_TEST_COMPONENTS=
# CINDER_VISUAL_DIFF=block
# CINDER_UPDATE_SNAPSHOTS=1
