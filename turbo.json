{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["build/**", ".svelte-kit/**"],
      "dependsOn": ["transit"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/check-documentation-coverage.ts",
        "$TURBO_ROOT$/scripts/check-inherited-key-reads.ts"
      ]
    },
    "lint:fix": {
      "cache": false
    },
    "types": {
      "outputs": [".types/**"],
      "dependsOn": ["transit", "^types"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["transit", "^types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/typecheck-contracts.ts",
        "$TURBO_ROOT$/scripts/check-documentation-code-blocks.ts",
        "$TURBO_ROOT$/scripts/check-documentation-coverage.ts",
        "$TURBO_ROOT$/scripts/published-exports.json"
      ]
    },
    "test": {
      "outputs": ["test-output/junit/**"],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV", "CORVIDAE_TEST_SELECTION"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json",
        "$TURBO_ROOT$/testing/testing/src/hang-guard.ts",
        "$TURBO_ROOT$/scripts/test-deadlines.ts",
        "$TURBO_ROOT$/scripts/worker-crash-report.ts",
        "$TURBO_ROOT$/scripts/affected-tests-manifest.ts",
        "$TURBO_ROOT$/scripts/environment-configuration.ts",
        "$TURBO_ROOT$/scripts/workspace-directories.ts"
      ]
    },
    "test:slow": {
      "outputs": [],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV", "CORVIDAE_TEST_SELECTION"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/affected-tests-manifest.ts",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/bun-test-selected.ts",
        "$TURBO_ROOT$/scripts/bun-test.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/environment-configuration.ts",
        "$TURBO_ROOT$/testing/testing/src/hang-guard.ts",
        "$TURBO_ROOT$/scripts/test-deadlines.ts",
        "$TURBO_ROOT$/scripts/worker-crash-report.ts",
        "$TURBO_ROOT$/scripts/workspace-directories.ts"
      ]
    },
    "test:gate": {
      "dependsOn": ["transit", "test"]
    },
    "clean": {
      "cache": false
    },
    "preview": {
      "persistent": true,
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#test:self": {
      "env": ["CODEX_CI", "NODE_ENV", "CORVIDAE_TEST_SELECTION"],
      "outputs": ["test-output/junit/self.xml"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "{applications,components,packages,testing,internal}/*/package.json",
        "{applications,components,packages,testing,internal}/*/tsconfig*.json",
        "scripts/browser-fixtures/package.json",
        "scripts/browser-fixtures/tsconfig*.json",
        "testing/testing/src/hang-guard.ts",
        "testing/testing/src/helpers/promise-outcome.ts",
        "testing/testing/src/wait-until.ts"
      ]
    },
    "//#test:self:slow": {
      "env": ["CODEX_CI", "NODE_ENV", "CORVIDAE_TEST_SELECTION"],
      "outputs": [],
      "inputs": [
        "$TURBO_DEFAULT$",
        "testing/testing/src/hang-guard.ts",
        "testing/testing/src/helpers/promise-outcome.ts",
        "testing/testing/src/wait-until.ts"
      ]
    },
    "//#test:browser-fixtures": {
      "dependsOn": ["@lostgradient/browser-fixtures#transit"],
      "env": ["CODEX_CI", "CORVIDAE_TEST_SELECTION"],
      "passThroughEnv": ["TMPDIR"],
      "inputs": [
        "scripts/browser-fixtures/**",
        "!scripts/browser-fixtures/**/{node_modules,.playwright,.turbo,.svelte-kit,coverage,playwright-report,test-output,test-results,tmp}/**",
        "!scripts/browser-fixtures/**/{.DS_Store,*.log,*.lcov,*.pem,.env,.env.*,local.env}",
        "$TURBO_ROOT$/bunfig.toml",
        "$TURBO_ROOT$/scripts/affected-tests-manifest.ts",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/environment-configuration.ts",
        "$TURBO_ROOT$/scripts/module-scope-scenario.test-support.ts",
        "$TURBO_ROOT$/scripts/test-deadlines.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json",
        "$TURBO_ROOT$/scripts/worker-crash-report.ts",
        "$TURBO_ROOT$/scripts/workspace-directories.ts"
      ],
      "outputs": [
        "scripts/browser-fixtures/.playwright/manifest.json",
        "scripts/browser-fixtures/.playwright/fixture-modules.ts",
        "scripts/browser-fixtures/.playwright/manifest-inputs.sha256",
        "test-output/junit/browser-fixtures.xml"
      ]
    },
    "//#dev:browser-fixtures": {
      "persistent": true,
      "cache": false
    },
    "@lostgradient/interborough#build": {
      "dependsOn": ["transit"],
      "outputs": ["build/**"],
      "env": ["NODE_ENV"]
    },
    "@lostgradient/interborough#dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["INTERBOROUGH_HOME", "INTERBOROUGH_PORT"]
    },
    "@lostgradient/bureau#test": {
      "dependsOn": ["transit"],
      "outputs": ["test-output/junit/**"],
      "env": ["CODEX_CI", "NODE_ENV", "CORVIDAE_TEST_SELECTION"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json",
        "$TURBO_ROOT$/documentation/runtime-contracts.md",
        "$TURBO_ROOT$/testing/testing/src/hang-guard.ts",
        "$TURBO_ROOT$/scripts/test-deadlines.ts",
        "$TURBO_ROOT$/scripts/worker-crash-report.ts",
        "$TURBO_ROOT$/scripts/affected-tests-manifest.ts",
        "$TURBO_ROOT$/scripts/environment-configuration.ts",
        "$TURBO_ROOT$/scripts/workspace-directories.ts"
      ]
    },
    "@lostgradient/weft#test": {
      "outputs": ["test-output/junit/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json",
        "$TURBO_ROOT$/testing/testing/src/hang-guard.ts",
        "$TURBO_ROOT$/scripts/test-deadlines.ts",
        "$TURBO_ROOT$/scripts/worker-crash-report.ts",
        "$TURBO_ROOT$/scripts/affected-tests-manifest.ts",
        "$TURBO_ROOT$/scripts/environment-configuration.ts",
        "$TURBO_ROOT$/scripts/workspace-directories.ts"
      ],
      "dependsOn": ["transit"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL",
        "CORVIDAE_TEST_SELECTION"
      ]
    },
    "@lostgradient/weft#test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": ["transit"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL"
      ]
    },
    "@lostgradient/weft#test:gate": {
      "dependsOn": ["transit", "test:coverage"]
    },
    "@lostgradient/storage#test": {
      "outputs": ["test-output/junit/**"],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV", "WEFT_KEEP_DURABILITY_FIXTURES", "CORVIDAE_TEST_SELECTION"],
