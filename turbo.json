{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["build/**", ".svelte-kit/**"],
      "dependsOn": ["transit"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["transit"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/typecheck-contracts.ts"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "preview": {
      "persistent": true,
      "cache": false
    },
    "//#preflight": {
      "cache": false,
      "inputs": [
        "package.json",
        "bun.lock",
        "{applications,components,packages,internal}/*/package.json",
        "scripts/browser-fixtures/package.json"
      ]
    },
    "transit": {
      "dependsOn": ["//#preflight", "^transit"]
    },
    "@lostgradient/playground#build": {
      "dependsOn": ["transit"],
      "outputs": ["build/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/mirror/package-map.json"]
    },
    "//#test:self": {
      "dependsOn": ["//#preflight"],
      "env": ["CODEX_CI", "NODE_ENV"],
      "outputs": []
    },
    "//#test:browser-fixtures": {
      "dependsOn": ["//#preflight", "@lostgradient/browser-fixtures#transit"],
      "env": ["CODEX_CI", "TMPDIR"],
      "outputs": [
        "scripts/browser-fixtures/.playwright/manifest.json",
        "scripts/browser-fixtures/.playwright/fixture-modules.ts"
      ]
    },
    "//#dev:browser-fixtures": {
      "persistent": true,
      "cache": false
    },
    "dev:browser": {
      "persistent": true,
      "cache": false
    },
    "dev:server": {
      "persistent": true,
      "cache": false
    },
    "@lostgradient/weft-ui#dev:browser": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["WEFT_UI_PORT", "WEFT_API_BASE_URL"]
    },
    "@lostgradient/weft#test": {
      "dependsOn": ["transit"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL"
      ]
    },
    "@lostgradient/weft#test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": ["transit"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL"
      ]
    },
    "@lostgradient/evaluation#test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"]
    },
    "@lostgradient/chat#test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "@lostgradient/terminal#test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "@lostgradient/ventriloquist#lint": {
      "outputs": [],
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/ventriloquist#typecheck": {
      "outputs": [],
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/typecheck-contracts.ts",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/ventriloquist#test": {
      "outputs": ["test-results/**"],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/ventriloquist#test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/cinder#test:coverage": {
      "dependsOn": ["transit"],
      "outputs": ["coverage/**"],
      "env": ["CODEX_CI", "NODE_ENV", "CINDER_SVG_DATA_URI_ROOTS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/components/chat/src/**",
        "$TURBO_ROOT$/components/editor/src/**",
        "$TURBO_ROOT$/scripts/browser-fixtures/src/**"
      ]
    },
    "@lostgradient/cinder#test": {
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV", "CINDER_SVG_DATA_URI_ROOTS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/components/chat/src/**",
        "$TURBO_ROOT$/components/editor/src/**",
        "$TURBO_ROOT$/scripts/browser-fixtures/src/**"
      ]
    }
  },
  "globalDependencies": [
    ".oxlintrc.json",
    ".prettierrc.json",
    ".prettierignore",
    ".stylelintrc.json",
    "tsconfig.json"
  ]
}
