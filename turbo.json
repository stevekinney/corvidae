{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["build/**", ".svelte-kit/**"],
      "dependsOn": ["transit"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "cache": false
    },
    "types": {
      "outputs": [".types/**"],
      "dependsOn": ["transit", "^types"]
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["transit", "^types"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/scripts/typecheck-contracts.ts"]
    },
    "test": {
      "outputs": ["test-output/junit/**"],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json"
      ]
    },
    "test:slow": {
      "outputs": [],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "preview": {
      "persistent": true,
      "cache": false
    },
    "transit": {
      "dependsOn": ["^transit"]
    },
    "//#test:self": {
      "env": ["CODEX_CI", "NODE_ENV"],
      "outputs": ["test-output/junit/self.xml"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "{applications,components,packages,testing,internal}/*/package.json",
        "{applications,components,packages,testing,internal}/*/tsconfig*.json",
        "scripts/browser-fixtures/package.json",
        "scripts/browser-fixtures/tsconfig*.json"
      ]
    },
    "//#test:browser-fixtures": {
      "dependsOn": ["@lostgradient/browser-fixtures#transit"],
      "env": ["CODEX_CI", "TMPDIR"],
      "outputs": [
        "scripts/browser-fixtures/.playwright/manifest.json",
        "scripts/browser-fixtures/.playwright/fixture-modules.ts",
        "test-output/junit/browser-fixtures.xml"
      ]
    },
    "//#dev:browser-fixtures": {
      "persistent": true,
      "cache": false
    },
    "@lostgradient/weft#dev:ui-server": {
      "persistent": true,
      "cache": false
    },
    "@lostgradient/weft#dev:ui-browser": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["WEFT_UI_PORT", "WEFT_API_BASE_URL"]
    },
    "@lostgradient/bureau#test": {
      "dependsOn": ["transit"],
      "outputs": ["test-output/junit/**"],
      "env": ["CODEX_CI", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json",
        "$TURBO_ROOT$/documentation/runtime-contracts.md"
      ]
    },
    "@lostgradient/weft#test": {
      "outputs": ["test-output/junit/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json",
        "$TURBO_ROOT$/documentation/weft-ui-public-surface.md"
      ],
      "dependsOn": ["transit"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL"
      ]
    },
    "@lostgradient/weft#test:coverage": {
      "outputs": ["coverage/**"],
      "dependsOn": ["transit", "test"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL"
      ]
    },
    "@lostgradient/evaluation#test:coverage": {
      "dependsOn": ["transit", "test"],
      "outputs": ["coverage/**"]
    },
    "@lostgradient/chat#test:coverage": {
      "dependsOn": ["transit", "test"],
      "outputs": ["coverage/**"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "@lostgradient/terminal#test:coverage": {
      "dependsOn": ["transit", "test"],
      "outputs": ["coverage/**"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "@lostgradient/ventriloquist#lint": {
      "outputs": [],
      "dependsOn": ["transit"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/ventriloquist#typecheck": {
      "outputs": [],
      "dependsOn": ["transit", "^types"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/typecheck-contracts.ts",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/ventriloquist#test": {
      "outputs": ["test-results/**", "test-output/junit/**"],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json"
      ]
    },
    "@lostgradient/ventriloquist#test:coverage": {
      "dependsOn": ["transit", "test"],
      "outputs": ["coverage/**", "test-results/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/scripts/terminal/evidence.schema.json",
        "$TURBO_ROOT$/scripts/terminal/evidence-schema.ts",
        "$TURBO_ROOT$/scripts/terminal/browser-asset-evidence.ts"
      ]
    },
    "@lostgradient/cinder#test:coverage": {
      "dependsOn": ["transit", "test"],
      "outputs": ["coverage/**"],
      "env": ["CODEX_CI", "NODE_ENV", "CINDER_SVG_DATA_URI_ROOTS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/components/chat/src/**",
        "$TURBO_ROOT$/components/editor/src/**",
        "$TURBO_ROOT$/scripts/browser-fixtures/src/**"
      ]
    },
    "@lostgradient/cinder#test": {
      "outputs": ["test-output/junit/**"],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV", "CINDER_SVG_DATA_URI_ROOTS"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/components/chat/src/**",
        "$TURBO_ROOT$/components/editor/src/**",
        "$TURBO_ROOT$/scripts/browser-fixtures/src/**",
        "$TURBO_ROOT$/scripts/bun-test-junit.ts",
        "$TURBO_ROOT$/scripts/check-test-durations.ts",
        "$TURBO_ROOT$/scripts/test-duration-allowlist.json"
      ]
    }
  },
  "globalDependencies": [
    ".oxlintrc.json",
    ".prettierrc.json",
    ".prettierignore",
    ".stylelintrc.json",
    "tsconfig.json"
  ]
}
