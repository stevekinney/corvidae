{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "outputs": ["build/**", ".svelte-kit/**"],
      "dependsOn": ["transit"]
    },
    "dev": {
      "persistent": true,
      "cache": false
    },
    "lint": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "lint:fix": {
      "cache": false
    },
    "typecheck": {
      "outputs": [],
      "dependsOn": ["transit"]
    },
    "test": {
      "outputs": [],
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV"]
    },
    "clean": {
      "cache": false
    },
    "preview": {
      "persistent": true,
      "cache": false
    },
    "//#preflight": {
      "cache": false
    },
    "transit": {
      "dependsOn": ["//#preflight", "^transit"]
    },
    "@corvidae/chat-room#lint": {
      "dependsOn": ["sync", "transit"],
      "outputs": [
        ".svelte-kit/*.json",
        ".svelte-kit/*.d.ts",
        ".svelte-kit/types/**",
        ".svelte-kit/generated/**"
      ]
    },
    "@corvidae/chat-room#sync": {
      "dependsOn": ["transit"],
      "outputs": [
        ".svelte-kit/*.json",
        ".svelte-kit/*.d.ts",
        ".svelte-kit/types/**",
        ".svelte-kit/generated/**",
        ".playwright/svelte-kit/*.json",
        ".playwright/svelte-kit/*.d.ts",
        ".playwright/svelte-kit/types/**",
        ".playwright/svelte-kit/generated/**"
      ]
    },
    "@corvidae/chat-room#typecheck": {
      "dependsOn": ["sync", "transit"],
      "outputs": [
        ".svelte-kit/*.json",
        ".svelte-kit/*.d.ts",
        ".svelte-kit/types/**",
        ".svelte-kit/generated/**"
      ]
    },
    "@corvidae/chat-room#build": {
      "dependsOn": ["typecheck", "transit"]
    },
    "//#test:browser-fixtures": {
      "dependsOn": ["^transit"],
      "env": ["CODEX_CI", "TMPDIR"],
      "outputs": [
        "scripts/browser-fixtures/.playwright/manifest.json",
        "scripts/browser-fixtures/.playwright/fixture-modules.ts"
      ]
    },
    "//#dev:browser-fixtures": {
      "persistent": true,
      "cache": false
    },
    "dev:browser": {
      "persistent": true,
      "cache": false
    },
    "dev:server": {
      "persistent": true,
      "cache": false
    },
    "@corvidae/chat-room#dev": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_BASE_URL",
        "CHAT_ROOM_SERVER_OWNED_DATABASE"
      ]
    },
    "@corvidae/chat-room#preview": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": [
        "NODE_ENV",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_BASE_URL",
        "CHAT_ROOM_SERVER_OWNED_DATABASE"
      ]
    },
    "@corvidae/weft-ui#dev:browser": {
      "persistent": true,
      "cache": false,
      "passThroughEnv": ["WEFT_UI_PORT", "WEFT_API_BASE_URL"]
    },
    "@corvidae/weft#test": {
      "dependsOn": ["transit"],
      "env": [
        "CODEX_CI",
        "NODE_ENV",
        "CI",
        "GITHUB_ACTIONS",
        "WEFT_BROWSER_SMOKE",
        "WEFT_STRICT_FAULTS",
        "WEFT_SQLITE_ARCHITECTURE_BENCHMARK",
        "WEFT_SEARCH_ATTRIBUTES_ARCHITECTURE_BENCHMARK",
        "WEFT_EVENT_DISPATCH_ARCHITECTURE_BENCHMARK",
        "WEFT_COVERAGE_MODE",
        "NODE_V8_COVERAGE",
        "WEFT_KEEP_DURABILITY_FIXTURES",
        "WEFT_TEST_POSTGRES_URL"
      ]
    },
    "@corvidae/cinder#test": {
      "dependsOn": ["transit"],
      "env": ["CODEX_CI", "NODE_ENV", "CINDER_SVG_DATA_URI_ROOTS"]
    }
  },
  "globalDependencies": [
    ".oxlintrc.json",
    ".prettierrc.json",
    ".prettierignore",
    ".stylelintrc.json",
    "tsconfig.json",
    "scripts/**"
  ]
}
