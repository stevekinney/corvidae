{
  "name": "@lostgradient/component-tooling",
  "private": true,
  "type": "module",
  "exports": {
    "./test/*": "./src/test/*",
    "./schemas/*": "./src/schemas/*",
    "./schema-types": "./src/schema-types.ts",
    "./manifest.meta": "./src/manifest.meta.ts",
    "./scripts/*": "./scripts/*"
  },
  "scripts": {
    "lint": "oxlint --deny-warnings --type-aware --tsconfig ./tsconfig.json scripts src",
    "typecheck": "tsc --noEmit -p ./tsconfig.json",
    "test": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-junit.ts --conditions browser --conditions svelte --parallel=4 --path-ignore-patterns='**/*.slow.test.ts' --path-ignore-patterns='**/*.integration.test.ts' scripts src && bun scripts/check-component-css-token-usage.ts --strict",
    "test:slow": "TZ=UTC LANG=en_US.UTF-8 bun ../../scripts/bun-test-selected.ts --conditions browser --conditions svelte .slow.test.ts .integration.test.ts",
    "tokens:audit": "bun scripts/check-component-css-token-usage.ts",
    "families:generate": "bun scripts/derive-families.ts",
    "families:check": "bun scripts/derive-families.ts --check",
    "create-package": "bun scripts/create-package.ts",
    "lint:fix": "oxlint --deny-warnings --fix --type-aware --tsconfig ./tsconfig.json scripts src"
  },
  "dependencies": {
    "@lostgradient/environmentalist": "catalog:",
    "@tanstack/virtual-core": "catalog:",
    "ajv": "catalog:",
    "ajv-formats": "catalog:",
    "esm-env": "catalog:",
    "postcss": "catalog:",
    "postcss-selector-parser": "catalog:",
    "prettier": "catalog:",
    "svelte": "catalog:",
    "svelte2tsx": "catalog:",
    "ts-morph": "catalog:",
    "typescript": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@lostgradient/testing": "workspace:*",
    "@lostgradient/typescript": "workspace:*",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/svelte": "catalog:",
    "@types/bun": "catalog:",
    "happy-dom": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
